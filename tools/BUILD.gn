_unavailable_metadata = {
  unavailable_components = [
    {
      component = "tools-zbi"
      reason = "Ours boot-container format has not been selected"
    },
    {
      component = "tools-zither"
      reason = "Ours syscall IDL and binding-generation contract is undefined"
    },
  ]
  unavailable_components_barrier = []
}

group("unavailable") {
  visibility = [
    ":tests",
    "//:*",
  ]
  metadata = _unavailable_metadata
}

# Canonical Zircon tools test rollup.  It resolves for discovery, but remains
# empty until the local zbi and zither tool modules exist.
group("tests") {
  testonly = true
  public_deps = [
    ":unavailable",
    "//tools/annotation/tests:tests",
  ]
  metadata = _unavailable_metadata
}
