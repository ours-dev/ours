_unavailable_metadata = {
  unavailable_components = [
    {
      component = "tools-zither"
      reason = "Ours syscall IDL and binding-generation contract is undefined"
    },
  ]
  unavailable_components_barrier = []
}

group("unavailable") {
  visibility = [
    ":tests",
    "//:*",
  ]
  metadata = _unavailable_metadata
}

# Canonical tool test rollup. OBI's host tool is exposed through :obit; the
# remaining Zither seam stays unavailable until its IDL contract is selected.
group("tests") {
  testonly = true
  public_deps = [
    ":unavailable",
    "//tools/annotation/tests:tests",
  ]
  metadata = _unavailable_metadata
}

group("obit") {
  public_deps = [ "//kernel/lib/obi:obit" ]
}
