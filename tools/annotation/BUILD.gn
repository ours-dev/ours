import("//tools/annotation/annotation_action.gni")

annotation_action("process") {
  compiler = "python3"
  flags = [ rebase_path("//tools/annotation/tests/fake_clang.py", root_build_dir) ]
  source_root = "//"
  sources = [ "//tools/annotation/tests/annotation_input.cpp" ]
  config = "//tools/annotation/tests/annotation_action_config.json"
  generated_outputs = [ "generated/annotation_generated.cpp" ]
  manifest = "annotation-manifest.json"
  inputs = [
    "//tools/annotation/tests/annotation_action.py",
    "//tools/annotation/tests/ast_fixture.json",
    "//tools/annotation/tests/fake_clang.py",
  ]
}

source_set("smoke") {
  testonly = true
  sources = [ "$target_gen_dir/generated/annotation_generated.cpp" ]
  public_deps = [ ":process" ]
}

group("tests") {
  testonly = true
  public_deps = [ ":smoke" ]
}
