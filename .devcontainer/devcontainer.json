{
  // 容器在 Zed 中显示的名称
  "name": "ours-dev",

  // ---- 容器构建 ----
  // 指向 .devcontainer/ 下的 Dockerfile
  "build": {
    "dockerfile": "Dockerfile",
    "context": "."
  },

  // ---- 容器内挂载路径 ----
  // 代码会被挂载到 /home/developer/workspaces/ours
  // 这与 Dockerfile 中的 WORKDIR 约定一致
  "workspaceFolder": "/home/developer/workspaces/ours",

  // ---- 持久化卷 ----
  // 避免重建容器时丢失 Bazel 缓存
  "mounts": [
    "type=volume,source=ours-bazel-cache,target=/home/developer/.cache/bazel"
  ],

  // ---- 容器创建后自动执行 ----
  // 拉取所有 git 子模块（bits、lockdep、concurrent、ustl）
  "postCreateCommand": "git submodule update --init --recursive",

  // ---- 容器环境变量 ----
  // 确保 Bazel 和 buildifier 在 PATH 中
  "containerEnv": {
    "PATH": "/home/developer/bin:/home/developer/.local/bin:/home/developer/.cargo/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin"
  },

  // ---- Zed 编辑器设置 ----
  // 对 C++ 文件启用 clangd
  "customizations": {
    "zed": {
      "settings": {
        "languages": {
          "C++": {
            "language_servers": ["clangd"]
          }
        }
      }
    }
  }
}
