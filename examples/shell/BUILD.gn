import("//build/toolchain/toolchain_environment.gni")
import("//system/user_executable.gni")

# The kernel toolchain would compile this happily and produce something that
# cannot run in ring 3 (-mcmodel=kernel puts every symbol reference in the top
# 2 GiB of the address space). Say so at gen time rather than leaving it to be
# discovered as a #GP.
assert(
    toolchain_environment == "user",
    "examples/shell must be built in a //build/toolchain/ours:user-* toolchain")

# A program bound to the vDSO at load time: the ours_* entries it calls are
# left undefined by the linker, and the kernel resolves them against the
# vDSO's .dynsym (elfload::Binder, in userabi::launch()) when
# process_spawn_boot starts it.
# The template is what says so -- everything this file used to spell out
# about packaging and about not asking for a code-patches section lives
# there now.
user_executable("shell") {
  visibility = [
    "//examples/*",
    "//kernel/products/image/*",
  ]

  sources = [ "shell.cpp" ]

  # The system calls this program makes are the vDSO's, already on the link
  # line (user_executable() puts it there); //system/lib/ou is only for its
  # print helpers now (debug_line, decimal, hex). The runtime is its entry
  # point and main's caller; bootfs is the format of the BootFS it reads.
  deps = [
    "//system/lib/bootfs:headers",
    "//system/lib/launch",
    "//system/lib/ou",
    "//system/lib/runtime",
  ]
}
