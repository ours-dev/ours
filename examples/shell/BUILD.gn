import("//build/toolchain/toolchain_environment.gni")
import("//system/component_manifest.gni")
import("//system/user_executable.gni")
import("//system/user_program_names.gni")

# The kernel toolchain would compile this happily and produce something that
# cannot run in ring 3 (-mcmodel=kernel puts every symbol reference in the top
# 2 GiB of the address space). Say so at gen time rather than leaving it to be
# discovered as a #GP.
assert(
    toolchain_environment == "user",
    "examples/shell must be built in a //build/toolchain/ours:user-* toolchain")

# The BootFS names of the programs the shell's checks start, from their
# install names (programs.hpp), and the directory its command lookup searches:
# fault_probe, which dbg_1's probes start from its BootFS, profile, which
# dbg_1's sampler check starts with the SAMPLING resource
# (check_profile()), and routing_checks, which dev's spawn check starts from
# /boot (check_spawn()). None is packaged through this list; each image
# carries the ones it starts.
user_program_names("programs") {
  visibility = [ ":*" ]
  programs = [
    "//kernel/lib/syscall/test/fault_probe",
    "//examples/profile",
    "//system/service/init/test/routing_checks",
  ]
}

# A program bound to the vDSO at load time: the ours_* entries it calls are
# left undefined by the linker, and whatever starts it -- the root's
# launch::start() on dev, from shell.cm below, or userboot in dbg_1, both
# with //system/lib/launch -- resolves them against the vDSO's .dynsym
# (elfload::Binder).
# The template is what says so -- everything this file used to spell out
# about packaging and about not asking for a code-patches section lives
# there now.
user_executable("shell") {
  visibility = [
    "//examples/*",
    "//kernel/products/image/*",
  ]

  sources = [
    "shell.cpp",
    "shell_tests.cpp",
  ]

  # The system calls this program makes are the vDSO's, already on the link
  # line, and the runtime, its entry point and main's caller, is a default
  # dependency (user_executable() puts both there). bootfs is the format of the
  # BootFS it reads on dbg_1, and launch the library it starts programs with
  # there. On dev, fsio is its namespace and the calls through it, and the
  # codecs are what it speaks to the root's built-in protocols. The Loop is what
  # check_loop() checks.
  deps = [
    ":programs",
    "//system/lib/bootfs:headers",
    "//system/lib/fsio",
    "//system/lib/ours.io",
    "//system/lib/ours.resource",
    "//system/lib/ours.process",
    "//system/lib/launch",
    "//system/lib/loop",
    "//system/lib/wire",
  ]
}

# The shell as a component of dev's root (component-framework design, "The
# manifest"): the root's built-in `boot` at /boot with rx*, where its
# commands' programs are and which `ls` lists, and two built-in protocols in
# its /svc: ours.process.Launcher, which runs those commands (fsio::spawn()),
# and ours.resource.Debug, the only way the root hands out the Debug resource
# the shell reads serial input with (D19).
component_manifest("shell.cm") {
  visibility = [ "//kernel/products/image/*" ]
  program = ":shell"
  manifest = {
    use = [
      {
        directory = "boot"
        path = "/boot"
        rights = [ "rx*" ]
      },
      {
        protocol = [
          "ours.process.Launcher",
          "ours.resource.Debug",
        ]
      },
    ]
  }
}
