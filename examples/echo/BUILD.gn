import("//build/toolchain/toolchain_environment.gni")
import("//system/component_manifest.gni")
import("//system/user_executable.gni")

# Read only in a user toolchain, as every program under //examples: dev's
# root.cm names the manifest below, and component_manifest() moves its
# program there. The codec beside it, ./protocol, has a BUILD.gn of its own,
# which the host reads too for its tests.
assert(
    toolchain_environment == "user",
    "examples/echo must be built in a //build/toolchain/ours:user-* toolchain")

# A component that provides ours.examples.echo.Echo from its outgoing
# directory, svc::Outgoing on a Loop, and exits when a client asks it to
# (echo_server.cpp). The counterpart of the echo_server of Fuchsia's routing
# example (examples/components/routing/cpp/echo_server), and named after it,
# which also keeps it apart from the shell's `echo` builtin.
user_executable("echo_server") {
  visibility = [ "//examples/*" ]
  sources = [ "echo_server.cpp" ]
  deps = [
    "protocol",
    "//system/lib/loop",
    "//system/lib/ort",
    "//system/lib/svc",
  ]
}

# Declares the protocol and exposes it to its parent, as Fuchsia's
# echo_server.cml does (examples/components/routing/cpp/echo_server/meta).
# It uses nothing: no namespace, no /svc. Its parent decides who reaches it,
# and under which name.
component_manifest("echo.cm") {
  visibility = [ "//kernel/products/image/*" ]
  program = ":echo_server"
  manifest = {
    capabilities = [
      {
        protocol = "ours.examples.echo.Echo"
      },
    ]
    expose = [
      {
        protocol = "ours.examples.echo.Echo"
        from = "self"
      },
    ]
  }
}
