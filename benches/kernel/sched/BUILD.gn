# `steal.bench`: where threads end up, and how much work gets done, under each
# work-stealing setting, run on the dbg image's console. Linked through
# //benches/kernel:commands.
source_set("steal-bench") {
  sources = [ "steal_bench.cpp" ]
  deps = [
    "//benches/kernel:bench",
    "//kernel/lib/gktl",
    "//kernel/lib/sched_domain:headers",
    "//kernel/mm:headers",
    "//kernel/object:headers",
    "//system/lib/logz4:headers",
  ]
  visibility = [ "//benches/kernel:*" ]
}
