# Host benchmark for the paging engine's walks (//kernel/lib/arch's
# arch::paging::Paging, with x86's four levels). Builds with the host
# toolchain and runs on the build machine, as x86-paging-smoke does: the
# engine is header-only and needs no kernel to run in.
executable("page-walk-bench") {
  testonly = true
  sources = [ "page_walk_bench.cpp" ]
  deps = [
    "//kernel/arch/x86:headers",
    "//kernel/lib/arch:headers",
  ]
  visibility = [ "*" ]
}
