import("//build/ours/cpu.gni")

# This file is read in two toolchains: the host one for vma-walk-bench, and
# the kernel's for largepage.bench, which //kernel/top links. Each target is
# defined only in its own, since the kernel toolchain already carries
# //kernel/mm:headers.config and the host one cannot resolve the kernel's
# headers.
if (!is_kernel) {
  # Host benchmark for //kernel/mm's VMA tree walks. Builds with the host
  # toolchain and runs on the build machine, the same way //kernel/mm/tests'
  # smoke tests do; it needs no mm sources, only the ustl container it
  # measures.
  executable("vma-walk-bench") {
    testonly = true
    sources = [ "vma_walk_bench.cpp" ]
    configs += [ "//kernel/mm:headers.config" ]
    deps = [
      "//system/lib/ustl:headers",
      "//system/public",
    ]
    visibility = [ "*" ]
  }
} else {
  # `largepage.bench`: 4 KiB pages against 2 MiB leaves, run on the dbg
  # image's console. Linked through //benches/kernel:commands.
  source_set("large-page-bench") {
    sources = [ "large_page_bench.cpp" ]
    deps = [
      "//benches/kernel:bench",

      # large_page_bench.cpp includes <ours/arch/aspace_layout.hpp> for the
      # user address range.
      "//kernel/arch/$ours_cpu/kernel:headers",
      "//kernel/lib/gktl",
      "//kernel/lib/user_copy",
      "//kernel/mm:headers",
      "//kernel/object:headers",
      "//system/lib/logz4:headers",
    ]
    visibility = [ "//benches/kernel:*" ]
  }
}
