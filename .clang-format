---
Language: Cpp
BasedOnStyle: LLVM

# The kernel uses four-space indentation and keeps namespace contents unindented

# Macros that stand in for an attribute. Listing them here is what stops
# clang-format from reading them as a return type or a declaration of their own,
# so `[[nodiscard]] FORCE_INLINE` stays one attribute group on one line.
#
# Only parameterless spellings belong here. NO_MANGLE is deliberately absent --
# it expands to `extern "C"`, a linkage-specification rather than an attribute.
AttributeMacros:
  - FORCE_INLINE
  - FORCE_INLINE_ATTR
  - INIT_CODE
  - INIT_DATA
  - KERNEL_API
  - NAKED
  - NO_INLINE
  - NO_RETURN
  - NO_UNIQUE_ADDRESS
  - PACKED
  - PHYS_EXPORT
  - USED
  - WEAK_LINK

AlignAfterOpenBracket: Align
BinPackArguments: true
BinPackParameters: true
IndentWidth: 4
TabWidth: 4
UseTab: Never
ContinuationIndentWidth: 4
ConstructorInitializerIndentWidth: 4
NamespaceIndentation: Inner
IndentCaseLabels: true
AccessModifierOffset: -2
EmptyLineAfterAccessModifier: Never
MaxEmptyLinesToKeep: 1

# Keep the existing 100-column limit and attached-brace style
ColumnLimit: 100
BreakBeforeBraces: Attach
BreakAfterAttributes: Always
AlwaysBreakTemplateDeclarations: Yes

# Match the kernel's type/variable spacing and colon conventions
PointerAlignment: Right
ReferenceAlignment: Right
DerivePointerAlignment: false
SpaceBeforeParens: ControlStatements
SpaceBeforeCtorInitializerColon: true
SpaceBeforeInheritanceColon: false
SpaceBeforeRangeBasedForLoopColon: false

# Constructor initializers use a comma at the beginning of continuation lines
BreakConstructorInitializers: BeforeComma
PackConstructorInitializers: NextLine

# Preserve intentional short and empty kernel definitions

AllowShortFunctionsOnASingleLine: Empty
AllowShortIfStatementsOnASingleLine: Never
AllowShortCaseLabelsOnASingleLine: false
ReflowComments: false

# Include ordering: library-internal > C++ std > C std > third-party.
# NOTE: "library-internal" via <> depends on the current file's library prefix and
# cannot be expressed in a single repo-wide regex.  Quoted includes ("...") are
# always treated as library-internal.  If you need per-library <> ordering, add a
# .clang-format in the library's root directory.

IncludeBlocks: Regroup
IncludeCategories:
  # 1a. Quoted includes: definitely library-internal (same directory / nearby).
  - Regex: '^"'
    Priority: 1
  # 1b. Project-wide framework / kernel headers (treated as library-internal).
  - Regex: '^<(ours|ustl|ktl|gktl|ccrt|builtin|bootmem|arch|acpi|kmrd|mtl|lockdep|obi|clock|lz4|logz4|meta)/'
    Priority: 1

  # 2. C++ standard library: no slashes, no .h, excluding C <c...> wrappers.
  #    Most C++ headers do not start with 'c'.
  - Regex: '^<[a-bd-z][a-z_0-9]*>$'
    Priority: 2
  #    C++ headers that DO start with 'c' (explicit list).
  - Regex: '^<(charconv|chrono|codecvt|compare|complex|concepts|condition_variable|coroutine)>$'
    Priority: 2

  # 3. C standard library: <c...> wrappers and <*.h> (including POSIX).
  - Regex: '^<c[a-z_]+>$'
    Priority: 3
  - Regex: '^<[a-z_]+\.h>$'
    Priority: 3

  # 4. Third-party / everything else in angle brackets.
  - Regex: '^<'
    Priority: 4
  - Regex: '.*'
    Priority: 5
SortIncludes: true
