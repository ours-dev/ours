{
    // See https://go.microsoft.com/fwlink/?LinkId=733558
    // for the documentation about the tasks.json format
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Activate prebuilt artifacts",
            "type": "shell",
            "command": "python3 scripts/activate.py --config prebuilt.yml",
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "runOptions": {
                "runOn": "folderOpen"
            },
            "problemMatcher": []
        },
        {
            "label": "GN: Generate compiler_commands",
            "type": "shell",
            "command": "gn gen target/default --export-compile-commands",
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "problemMatcher": []
        },
        {
            "label": "GN: Check build graph",
            "type": "shell",
            "command": "gn check target/default",
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "problemMatcher": []
        },
        {
            "label": "GN: List targets",
            "type": "shell",
            "command": "gn ls target/default",
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "problemMatcher": []
        },
        {
            "label": "GN: Describe default target",
            "type": "shell",
            "command": "gn desc target/default //:default",
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "problemMatcher": []
        },
        {
            "label": "GN: Show arguments",
            "type": "shell",
            "command": "gn args target/default --list",
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "problemMatcher": []
        },
        {
            "label": "GN: Check formatting",
            "type": "shell",
            "command": "gn format --all --dry-run",
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "problemMatcher": []
        }
    ]
}
