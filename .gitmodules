[submodule "system/lib/lockdep"]
	path = system/lib/lockdep
	url = git@github.com:ours-dev/lockdep.git
[submodule "system/lib/concurrent"]
	path = system/lib/concurrent
	url = git@github.com:ours-dev/concurrent.git
[submodule "system/lib/bits"]
	path = system/lib/bits
	url = git@github.com:ours-dev/bits.git
[submodule "system/lib/boost.container"]
	path = system/lib/boost.container
	url = https://github.com/boostorg/container.git
[submodule "vendor/cxxopt"]
	path = vendor/cxxopt
	url = https://github.com/jarro2783/cxxopts.git
[submodule "vendor/googletest"]
	path = vendor/googletest
	url = https://github.com/google/googletest.git
[submodule "vendor/nlohmann_json"]
	path = vendor/nlohmann_json
	url = https://github.com/nlohmann/json.git
