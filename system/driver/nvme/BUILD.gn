import("//build/toolchain/toolchain_environment.gni")
import("//system/component_manifest.gni")
import("//system/user_executable.gni")

# Read only in a user toolchain, as every program under //system/driver:
# dev's root.cm names the manifest below, and component_manifest() moves its
# program there.
assert(
    toolchain_environment == "user",
    "system/driver/nvme must be built in a //build/toolchain/ours:user-* toolchain")

# The NVMe driver (storage-layer plan, system/driver/nvme): a component that
# finds the machine's NVMe controller by class code in the ECAM window,
# brings the controller up on its MMIO register file, and serves
# ours.block.Block — completions polled, the device's interrupt pin never
# unmasked. Root.cm offers it under the name ours.block.Nvme. The route
# service answers the ECAM window's base; the interrupt system is not asked
# for anything.
user_executable("nvme") {
  visibility = [
    ":*",
    "//kernel/products/image/*",
  ]
  sources = [ "nvme.cpp" ]
  deps = [
    "//system/lib/block-server",
    "//system/lib/ddk",
    "//system/lib/fsio",
    "//system/lib/ioservice:outgoing",
    "//system/lib/loop",
    "//system/lib/nvme",
    "//system/lib/protocols:client",
    "//system/lib/ustl",
    "//system/lib/wire",
  ]
}

component_manifest("nvme.cm") {
  visibility = [ "//kernel/products/image/*" ]
  program = ":nvme"
  manifest = {
    use = [
      {
        protocol = "ours.resource.Mmio"
      },
      {
        protocol = "ours.resource.Iommu"
      },
      {
        protocol = "ours.acpi.Route"
      },
      {
        protocol = "ours.dev.Registry"
      },
    ]
    capabilities = [
      {
        protocol = "ours.block.Block"
      },
      {
        protocol = "ours.nvme.Control"
      },
    ]
    expose = [
      {
        protocol = "ours.block.Block"
        from = "self"
      },
      {
        protocol = "ours.nvme.Control"
        from = "self"
      },
    ]
  }
}
