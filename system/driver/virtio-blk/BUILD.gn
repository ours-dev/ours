import("//build/toolchain/toolchain_environment.gni")
import("//system/component_manifest.gni")
import("//system/user_executable.gni")

# Read only in a user toolchain, as every program under //system/driver:
# dev's root.cm names the manifest below, and component_manifest() moves its
# program there.
assert(
    toolchain_environment == "user",
    "system/driver/virtio-blk must be built in a //build/toolchain/ours:user-* toolchain")

# The userspace driver of QEMU's virtio block device (storage-layer plan).
# It uses the root's built-in MmIo resource, whose vmo_create_physical opens
# windows onto device memory; the DMA resource (ours.resource.Iommu) and the
# device's interrupt come with the milestones that need them. Routing is the
# only gate: this component holds the resource because root.cm offers it.
user_executable("virtio-blk") {
  visibility = [
    ":*",
    "//kernel/products/image/*",
  ]
  sources = [ "virtio_blk.cpp" ]
  deps = [
    "//system/lib/fsio",
    "//system/lib/ours.resource:client",
    "//system/lib/wire",
  ]
}

component_manifest("virtio-blk.cm") {
  visibility = [ "//kernel/products/image/*" ]
  program = ":virtio-blk"
  manifest = {
    use = [
      {
        protocol = "ours.resource.Mmio"
      },
    ]
  }
}
