import("//build/cpp/host_test.gni")

# Host-side tests. These link googletest and run on the build machine: each
# protocol's Get and its reply are written, read back and broken on purpose,
# from bytes and handle values alone.
host_test("ours_resource") {
  sources = [ "ours_resource_test.cpp" ]
  deps = [
    "//system/lib/ours.resource",
    "//vendor/googletest:gtest",
    "//vendor/googletest:gtest_main",
  ]
  visibility = [ "*" ]
}
