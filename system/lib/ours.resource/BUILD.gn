import("//build/cpp/cpp_interface.gni")
import("//build/toolchain/toolchain_environment.gni")

# ours.resource, the protocols through which the root hands out kernel
# resources -- Debug, Irq and Ioport, each with one method, Get -- encoded and
# decoded by hand on //system/lib/wire (component-framework design S6, D19).
# Bytes and handle values alone, no system call, so it builds in every
# toolchain, the host one included, where its tests run.
#
# The directory and the target are named after the protocol library, so that
# //system/lib/ours.resource is its label; the include prefix and the
# namespace are ours_resource, the library's name with its dot made an
# underscore, as a C++ name cannot hold a dot.
source_set("ours.resource") {
  sources = [ "src/ours_resource.cpp" ]

  # Its messages are wire::Message and its method a wire::Method, so a user of
  # the codec is a user of the framing too.
  public_deps = [
    ":headers",
    "//system/lib/wire",
  ]
  visibility = [ "*" ]
}

# The headers are a target of their own so that a dependant needing only the
# declarations does not pull in the sources -- see
# //build/cpp/cpp_interface.gni.
cpp_interface("headers") {
  public = [ "include/ours_resource/ours_resource.hpp" ]
  public_deps = [
    "//system/lib/ustl:headers",
    "//system/lib/wire:headers",
    "//system/public",
  ]
  visibility = [ "*" ]
}

# Host unit tests; wired into //:default.
group("tests") {
  testonly = true
  public_deps = [ "test:ours_resource($host_toolchain)" ]
}

# The client: a user program's Get, through its namespace (fsio), so user
# programs only, like fsio itself.
if (!is_host_toolchain && toolchain_environment == "user") {
  source_set("client") {
    sources = [ "src/client.cpp" ]
    public_deps = [
      ":client.headers",
      ":ours.resource",
    ]
    deps = [
      "//system/lib/fsio",
      "//system/lib/wire",
    ]
    visibility = [ "*" ]
  }

  cpp_interface("client.headers") {
    public = [ "include/ours_resource/client.hpp" ]
    public_deps = [ ":headers" ]
    visibility = [ ":*" ]
  }
}
