import("//build/cpp/cpp_interface.gni")

# The compiled component manifest: its format (component/format.hpp), which
# //system/component_manifest.py writes, the decoder the root reads it with
# (component/decl.hpp), which checks structure only, and the router that walks
# a use to its source (component/route.hpp). It makes no system call, so it
# builds for the host too, where its tests run.
source_set("component") {
  sources = [
    "src/decl.cpp",
    "src/route.cpp",
  ]
  public_deps = [ ":headers" ]
}

# The headers are a target of their own so that a dependant needing only the
# declarations does not pull in the sources -- see
# //build/cpp/cpp_interface.gni.
cpp_interface("headers") {
  public = [
    "include/component/decl.hpp",
    "include/component/format.hpp",
    "include/component/route.hpp",
  ]
  public_deps = [
    "//system/lib/ustl:headers",
    "//system/public",
  ]
}

group("tests") {
  testonly = true
  public_deps = [
    "test:decl($host_toolchain)",
    "test:route($host_toolchain)",
  ]
}
