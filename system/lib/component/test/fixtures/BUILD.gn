# Manifests for the decoder's and the router's tests, built by
# component_manifest() as any image's would be. Read in two toolchains: in the
# default one for realm.cm and top.cm, which the tests name there, and in the
# user one for the children and their program, where the template moves them.
#
# Between them they hold every record the format has: a program with arguments,
# children, declared capabilities (protocols, and directories with a path and
# rights), directory and protocol uses, offers from the parent, from self and
# from a child, with `as`, rights and a subdir, and exposes from self and from a
# child, a directory's with rights and a subdir. A protocol states its `type`
# where its name is not its protocol: provider.cm's capability, and the uses of
# the protocol that realm.cm and top.cm rename (consumer.cm's `echo`, user.cm's
# `ours.example.RealmEcho`, leaf.cm's `echo`); every other protocol leaves it
# out, and is its own name. Every route that resolves in the first two trees
# below ends at a capability of the type its use asks for.
#
# Two trees for the router: realm.cm as the root, and top.cm as the root with
# realm.cm one level down beside user.cm, whose child is leaf.cm. Each route
# the router's test checks is named in a comment on the declaration that
# decides it. A third, mismatch.cm, has two routes that end at the wrong
# protocol on purpose.
#
# And one for the directories a component provides: shelf.cm as the root, with
# store.cm, which declares and exposes a directory, reader.cm, which uses what
# the root offers of it, and bare.cm, whose directory has no program to serve
# it. Three of reader's uses are denied on purpose (an offer that asks more
# than the expose states, an offer or an expose that asks more than the
# declaration allows). The build walks every tree for directory rights and
# only warns, so shelf.cm builds, and prints three warnings each time it is
# compiled; that is expected.

import("//build/toolchain/toolchain_environment.gni")
import("//system/component_manifest.gni")

# The parent, with no program, as the root's manifest has none. top.cm names
# it as a child too.
component_manifest("realm.cm") {
  testonly = true
  visibility = [
    ":*",
    "//system/lib/component/test:*",
  ]
  children = [
    {
      name = "provider"
      manifest = ":provider.cm"
      startup = "eager"
    },
    {
      name = "consumer"
      manifest = ":consumer.cm"
      startup = "eager"
    },
    {
      name = "hollow"
      manifest = ":hollow.cm"
      startup = "eager"
    },
  ]
  manifest = {
    offer = [
      {
        directory = "boot"
        from = "parent"
        to = "#consumer"
        rights = [ "rx*" ]
      },
      {
        directory = "boot"
        from = "parent"
        to = "#consumer"
        as = "config"
        subdir = "config"
        rights = [ "r*" ]
      },
      {
        protocol = "ours.example.Echo"
        from = "#provider"
        to = "#consumer"
        as = "echo"
      },
      {
        protocol = "ours.process.Launcher"
        from = "parent"
        to = [
          "#provider",
          "#consumer",
        ]
      },
      {
        protocol = "ours.example.Hollow"
        from = "#hollow"
        to = "#consumer"
      },
    ]
    expose = [
      {
        protocol = "ours.example.Echo"
        from = "#provider"
        as = "ours.example.RealmEcho"
      },
    ]
  }
}

component_manifest("provider.cm") {
  testonly = true
  program = ":fixture_program"
  manifest = {
    program = {
      args = [
        "--serve",
        "echo",
      ]
    }
    capabilities = [
      {
        protocol = "ours.example.Echo"
        type = "ours.example.Echo"
      },
    ]
    use = [
      {
        protocol = "ours.process.Launcher"
      },
    ]
    expose = [
      {
        protocol = "ours.example.Echo"
        from = "self"
      },
    ]
  }
}

component_manifest("consumer.cm") {
  testonly = true
  program = ":fixture_program"
  manifest = {
    use = [
      {
        directory = "boot"
        path = "/boot"
        rights = [ "rx*" ]
      },
      {
        directory = "config"
        path = "/config"
        rights = [ "r*" ]
        subdir = "ours"
      },
      {
        # realm.cm offers provider's ours.example.Echo under this name, so
        # the use says which protocol it means.
        protocol = "echo"
        type = "ours.example.Echo"
      },
      {
        protocol = [
          "ours.process.Launcher",
          "ours.example.Hollow",
        ]
      },
    ]
  }
}

# Declares and exposes a protocol with no program to serve it: the route that
# ends here is the one the router answers NotFound.
component_manifest("hollow.cm") {
  testonly = true
  manifest = {
    capabilities = [
      {
        protocol = "ours.example.Hollow"
      },
    ]
    expose = [
      {
        protocol = "ours.example.Hollow"
        from = "self"
      },
    ]
  }
}

# The router's third root, whose two routes end at the wrong protocol on
# purpose, for the run-time check in route(): the same two children as
# realm.cm, with an offer for each way the types can disagree. It is built
# with `type_check = false`, because the build refuses a tree that routes to
# the wrong protocol, and the point of this one is what route() answers for a
# tree that was not checked. Nothing else in the fixtures may skip the check.
component_manifest("mismatch.cm") {
  testonly = true
  type_check = false
  visibility = [ "//system/lib/component/test:*" ]
  children = [
    {
      name = "provider"
      manifest = ":provider.cm"
      startup = "eager"
    },
    {
      name = "consumer"
      manifest = ":consumer.cm"
      startup = "eager"
    },
  ]
  manifest = {
    offer = [
      # provider's ours.example.Echo under the name of the Launcher, which
      # consumer uses as ours.process.Launcher: a use of the type
      # ours.process.Launcher, its own name, reaches a capability of the type
      # ours.example.Echo.
      {
        protocol = "ours.example.Echo"
        from = "#provider"
        to = "#consumer"
        as = "ours.process.Launcher"
      },

      # The other way round: the built-in Launcher under the name `echo`,
      # which consumer uses with the type ours.example.Echo.
      {
        protocol = "ours.process.Launcher"
        from = "parent"
        to = "#consumer"
        as = "echo"
      },
    ]
  }
}

# The router's second root. realm.cm sits one level down, so a route from
# user.cm or leaf.cm turns down through two exposes; and each way a route can
# fail has an offer of its own here, named in its comment.
component_manifest("top.cm") {
  testonly = true
  visibility = [ "//system/lib/component/test:*" ]
  children = [
    {
      name = "realm"
      manifest = ":realm.cm"
      startup = "eager"
    },
    {
      name = "user"
      manifest = ":user.cm"
      startup = "eager"
    },
  ]
  manifest = {
    # Declared with no program to serve it: user's use of it is NotFound
    # here, Declare.
    capabilities = [
      {
        protocol = "ours.example.TopSelf"
      },
    ]
    offer = [
      # What realm.cm's own offers from its parent ask for.
      {
        directory = "boot"
        from = "parent"
        to = "#realm"
        rights = [ "rx*" ]
      },
      {
        protocol = "ours.process.Launcher"
        from = "parent"
        to = "#realm"
      },

      # The first of the three subdirs leaf's /config joins: etc/config/ours.
      {
        directory = "boot"
        from = "parent"
        to = "#user"
        rights = [ "rx*" ]
        subdir = "etc"
      },

      # r* where user's use asks rx*: AccessDenied here.
      {
        directory = "boot"
        from = "parent"
        to = "#user"
        as = "narrow"
        rights = [ "r*" ]
      },

      # States no rights, so user's rw* is held against the built-in's rx*:
      # AccessDenied at the built-ins.
      {
        directory = "boot"
        from = "parent"
        to = "#user"
        as = "writable"
      },

      # r*, which user offers on to leaf as rx*: wide enough for leaf's r*,
      # narrower than the hop before it, so AccessDenied here.
      {
        directory = "boot"
        from = "parent"
        to = "#user"
        as = "thin"
        rights = [ "r*" ]
      },

      # A directory under a protocol's name: user's protocol use of the name
      # must not match it.
      {
        directory = "boot"
        from = "parent"
        to = "#user"
        as = "ours.example.Kind"
      },

      # A protocol named `boot`: the built-in `boot` is a directory, so this
      # is no built-in.
      {
        protocol = "boot"
        from = "parent"
        to = "#user"
        as = "ours.example.BootProtocol"
      },

      # Down through realm's expose and provider's: two levels.
      {
        protocol = "ours.example.RealmEcho"
        from = "#realm"
        to = "#user"
      },

      # realm exposes nothing by this name: NotFound at realm, Expose.
      {
        protocol = "ours.example.Unexposed"
        from = "#realm"
        to = "#user"
      },

      # No built-in by this name: NotFound at the built-ins.
      {
        protocol = "ours.example.NotBuiltin"
        from = "parent"
        to = "#user"
      },
      {
        protocol = "ours.example.TopSelf"
        from = "self"
        to = "#user"
      },

      # Offered to realm only: user's use of it is NotFound here, Offer.
      {
        protocol = "ours.example.ForRealm"
        from = "parent"
        to = "#realm"
      },
    ]
  }
}

# The middle of top.cm's tree: a component with a program and a child, which
# offers its own capability to that child and passes on what it was offered.
component_manifest("user.cm") {
  testonly = true
  program = ":fixture_program"
  children = [
    {
      name = "leaf"
      manifest = ":leaf.cm"
      startup = "eager"
    },
  ]
  manifest = {
    capabilities = [
      # Declared ahead of UserEcho and never routed to: a route that ends at
      # user must find its declaration by name, not take the first protocol.
      {
        protocol = "ours.example.UserFirst"
      },
      {
        protocol = "ours.example.UserEcho"
      },
    ]
    use = [
      {
        directory = "boot"
        path = "/boot"
        rights = [ "r*" ]
      },
      {
        directory = "narrow"
        path = "/narrow"
        rights = [ "rx*" ]
      },
      {
        directory = "writable"
        path = "/writable"
        rights = [ "rw*" ]
      },
      {
        # top offers realm's ours.example.RealmEcho, which is provider's
        # ours.example.Echo renamed on the way, so the use says which
        # protocol it means. A type goes with one protocol, not a list.
        protocol = "ours.example.RealmEcho"
        type = "ours.example.Echo"
      },
      {
        # ours.example.Missing: nobody offers it, NotFound at top, Offer.
        protocol = [
          "ours.example.Unexposed",
          "ours.example.NotBuiltin",
          "ours.example.TopSelf",
          "ours.example.Kind",
          "ours.example.BootProtocol",
          "ours.example.ForRealm",
          "ours.example.Missing",
        ]
      },
    ]
    offer = [
      # From self, with a program to serve it.
      {
        protocol = "ours.example.UserEcho"
        from = "self"
        to = "#leaf"
      },

      # The second subdir of leaf's etc/config/ours.
      {
        directory = "boot"
        from = "parent"
        to = "#leaf"
        as = "config"
        rights = [ "r*" ]
        subdir = "config"
      },

      # More than top offered user as `thin`.
      {
        directory = "thin"
        from = "parent"
        to = "#leaf"
        as = "wide"
        rights = [ "rx*" ]
      },

      # Renamed again on the way down: leaf's `echo` is provider's
      # ours.example.Echo, two levels up and two down.
      {
        protocol = "ours.example.RealmEcho"
        from = "parent"
        to = "#leaf"
        as = "echo"
      },
    ]
  }
}

component_manifest("leaf.cm") {
  testonly = true
  program = ":fixture_program"
  manifest = {
    use = [
      {
        directory = "config"
        path = "/config"
        rights = [ "r*" ]
        subdir = "ours"
      },
      {
        directory = "wide"
        path = "/wide"
        rights = [ "r*" ]
      },
      {
        # user passes on its ours.example.RealmEcho under this name: still
        # provider's ours.example.Echo.
        protocol = "echo"
        type = "ours.example.Echo"
      },
      {
        protocol = "ours.example.UserEcho"
      },
    ]
  }
}

# The directory router's root. Everything below is offered to reader.cm, whose
# uses are named in the comment on each offer; the route of each is checked by
# route_test.cpp (RouteShelf) and by test_component_manifest.py, which must
# agree.
component_manifest("shelf.cm") {
  testonly = true
  visibility = [ "//system/lib/component/test:*" ]
  children = [
    {
      name = "store"
      manifest = ":store.cm"
      startup = "eager"
    },
    {
      name = "reader"
      manifest = ":reader.cm"
      startup = "eager"
    },
    {
      name = "bare"
      manifest = ":bare.cm"
      startup = "eager"
    },
  ]
  manifest = {
    offer = [
      # The route that works, every hop narrowing: store declares rw* and
      # exposes r* with the subdir `shared`, this offer states r* and `public`,
      # reader asks r* and `docs`. The Open is for
      # export/data/shared/public/docs.
      {
        directory = "data"
        from = "#store"
        to = "#reader"
        as = "notes"
        rights = [ "r*" ]
        subdir = "public"
      },

      # rx* where store's expose of `data` states r*: AccessDenied at store,
      # Expose. The offer is as wide as the use; it is the expose that holds
      # less.
      {
        directory = "data"
        from = "#store"
        to = "#reader"
        as = "wide-offer"
        rights = [ "rx*" ]
      },

      # store exposes `data-wide` as rx* over a declaration of rw*: the
      # expose is as wide as the offer and the use, and the declaration holds
      # less. AccessDenied at store, Declare.
      {
        directory = "data-wide"
        from = "#store"
        to = "#reader"
        as = "wide-expose"
        rights = [ "rx*" ]
      },

      # An expose that states neither rights nor subdir narrows nothing: r*
      # of the declaration's rw*, no subdir, the declared path alone.
      {
        directory = "data-plain"
        from = "#store"
        to = "#reader"
        as = "plain"
        rights = [ "r*" ]
      },

      # The same expose, offered as rx*: the declaration is the hop that holds
      # less. AccessDenied at store, Declare.
      {
        directory = "data-plain"
        from = "#store"
        to = "#reader"
        as = "plain-wide"
        rights = [ "rx*" ]
      },

      # store exposes a protocol called `status`, not a directory: a directory
      # use never reaches it. NotFound at store, Expose.
      {
        directory = "status"
        from = "#store"
        to = "#reader"
        as = "wrong-kind"
        rights = [ "r*" ]
      },

      # And the reverse: store exposes a directory called `data`, and reader
      # uses a protocol. NotFound at store, Expose.
      {
        protocol = "data"
        from = "#store"
        to = "#reader"
        as = "not-a-protocol"
      },

      # bare declares and exposes `data` and has no program to serve it:
      # NotFound at bare, Declare.
      {
        directory = "data"
        from = "#bare"
        to = "#reader"
        as = "bare-data"
        rights = [ "r*" ]
      },
    ]
  }
}

# Declares directories at /export/data and exposes the one three ways, with
# the narrowing each route above needs; and a protocol, so that the kinds
# can be told apart.
component_manifest("store.cm") {
  testonly = true
  program = ":fixture_program"
  manifest = {
    capabilities = [
      {
        directory = "data"
        path = "/export/data"
        rights = [ "rw*" ]
      },
      {
        protocol = "status"
      },
    ]
    expose = [
      {
        directory = "data"
        from = "self"
        rights = [ "r*" ]
        subdir = "shared"
      },
      {
        directory = "data"
        from = "self"
        as = "data-wide"
        rights = [ "rx*" ]
      },
      {
        directory = "data"
        from = "self"
        as = "data-plain"
      },
      {
        protocol = "status"
        from = "self"
      },
    ]
  }
}

component_manifest("reader.cm") {
  testonly = true
  program = ":fixture_program"
  manifest = {
    use = [
      {
        directory = "notes"
        path = "/notes"
        rights = [ "r*" ]
        subdir = "docs"
      },
      {
        directory = "wide-offer"
        path = "/wide-offer"
        rights = [ "rx*" ]
      },
      {
        directory = "wide-expose"
        path = "/wide-expose"
        rights = [ "rx*" ]
      },
      {
        directory = "plain"
        path = "/plain"
        rights = [ "r*" ]
      },
      {
        directory = "plain-wide"
        path = "/plain-wide"
        rights = [ "rx*" ]
      },
      {
        directory = "wrong-kind"
        path = "/wrong-kind"
        rights = [ "r*" ]
      },
      {
        directory = "bare-data"
        path = "/bare-data"
        rights = [ "r*" ]
      },
      {
        protocol = "not-a-protocol"
      },
    ]
  }
}

# Declares and exposes a directory with no program to serve it.
component_manifest("bare.cm") {
  testonly = true
  manifest = {
    capabilities = [
      {
        directory = "data"
        path = "/export/data"
        rights = [ "rw*" ]
      },
    ]
    expose = [
      {
        directory = "data"
        from = "self"
      },
    ]
  }
}

# The program provider.cm, consumer.cm, user.cm, leaf.cm, store.cm and
# reader.cm name. Built, so that the template's install-name lookup runs
# against a real user_executable(), and never packaged or run. User toolchain
# only, like the runtime; the host toolchain reads "user" too, hence the second
# test (see //system/lib/ort/test).
if (!is_host_toolchain && toolchain_environment == "user") {
  import("//system/user_executable.gni")

  user_executable("fixture_program") {
    testonly = true
    sources = [ "fixture_program.cpp" ]
  }
}
