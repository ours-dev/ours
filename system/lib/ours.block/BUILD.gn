import("//build/cpp/cpp_interface.gni")

# ours.block -- the protocol the block device driver provides, encoded and
# decoded by hand on //system/lib/wire, as the ours.* codecs under
# //system/lib are (component-framework design D20). Bytes alone, no system
# call, so it builds in every toolchain, the host one included, where its
# tests run.
#
# Under //system/lib rather than beside a driver: any component that a route
# hands a disk to speaks it, the same way every component speaks
# ours.resource's protocols.
source_set("ours.block") {
  sources = [ "src/ours_block.cpp" ]

  # Its messages are wire::Message and its methods wire::Methods, so a user
  # of the codec is a user of the framing too.
  public_deps = [
    ":headers",
    "//system/lib/wire",
  ]
  visibility = [ "*" ]
}

# The headers are a target of their own so that a dependant needing only the
# declarations does not pull in the sources -- see
# //build/cpp/cpp_interface.gni.
cpp_interface("headers") {
  public = [ "include/ours_block/ours_block.hpp" ]
  public_deps = [
    "//system/lib/ustl:headers",
    "//system/lib/wire:headers",
    "//system/public",
  ]
  visibility = [ "*" ]
}

# The client side of the codec: the calls with their plumbing, over one
# connected channel. Its own target, apart from "headers", because it makes
# system calls and so builds in a user toolchain only, while the codec alone
# builds in the host toolchain too, where its tests run.
cpp_interface("client") {
  public = [ "include/ours_block/client.hpp" ]
  public_deps = [
    ":headers",
    "//system/lib/ustl:headers",
    "//system/lib/wire:headers",
    "//system/public",
  ]
  visibility = [ "*" ]
}

# Host unit tests; wired into //:default.
group("tests") {
  testonly = true
  public_deps = [ "test:ours_block($host_toolchain)" ]
}
