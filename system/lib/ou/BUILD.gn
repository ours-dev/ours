import("//build/cpp/cpp_interface.gni")
import("//build/toolchain/toolchain_environment.gni")

# The kernel has no business linking this: these entry points trap, and a trap
# from ring 0 is not a system call. Say so at gen time rather than leaving it
# to be discovered as a link error against the vDSO's symbols.
assert(toolchain_environment == "user",
       "//system/lib/ou is a user-mode library and must be built in a " +
           "//build/toolchain/ours:user-* toolchain")

# The named C++ entry to every system call, for programs that run in ring 3.
source_set("ou") {
  sources = [
    "src/command.cpp",
    "src/debug.cpp",
  ]
  public_deps = [ ":headers" ]
  visibility = [ "*" ]
}

# The headers are a target of their own so that a dependant needing only the
# declarations does not pull in the sources -- see
# //build/cpp/cpp_interface.gni.
cpp_interface("headers") {
  public = [
    "include/ou/command.hpp",
    "include/ou/debug.hpp",
    "include/ou/str.hpp",
  ]

  # <ours/vdso.hpp> for the symbols the kernel binds these to,
  # <ours/syscall.hpp> for the ABI limits a caller has to respect.
  public_deps = [ "//system/public" ]
  visibility = [ "*" ]
}
