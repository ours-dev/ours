import("//build/cpp/cpp_interface.gni")

# ours.kernel, the protocols through which the root hands out kernel resources
# -- so far DebugResource.Get -- encoded and decoded by hand on
# //system/lib/wire (component-framework design S6, D19). Bytes and handle
# values alone, no system call, so it builds in every toolchain, the host one
# included, where its tests run.
#
# The target is named after the directory, so that //system/lib/ours-kernel
# is its label; the include prefix and the namespace are ours_kernel, the
# protocol library's name with its dot made an underscore, as a C++ name
# cannot hold a hyphen or a dot.
source_set("ours-kernel") {
  sources = [ "src/ours_kernel.cpp" ]

  # Its messages are wire::Message and its method a wire::Method, so a user of
  # the codec is a user of the framing too.
  public_deps = [
    ":headers",
    "//system/lib/wire",
  ]
  visibility = [ "*" ]
}

# The headers are a target of their own so that a dependant needing only the
# declarations does not pull in the sources -- see
# //build/cpp/cpp_interface.gni.
cpp_interface("headers") {
  public = [ "include/ours_kernel/ours_kernel.hpp" ]
  public_deps = [
    "//system/lib/ustl:headers",
    "//system/lib/wire:headers",
    "//system/public",
  ]
  visibility = [ "*" ]
}

# Host unit tests; wired into //:default.
group("tests") {
  testonly = true
  public_deps = [ "test:ours_kernel($host_toolchain)" ]
}
