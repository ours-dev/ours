import("//build/cpp/cpp_interface.gni")
import("//build/cpp/host_test.gni")

cpp_interface("headers") {
  public = [
    "include/logz4/filter.hpp",
    "include/logz4/clock.hpp",
    "include/logz4/level.hpp",
    "include/logz4/log.hpp",
    "include/logz4/logger.hpp",
    "include/logz4/ring.hpp",
    "include/logz4/domain.hpp",
  ]
  public_deps = [
    "//system/lib/ustl:headers",
    "//system/public",
  ]
}

source_set("logz4") {
  sources = [
    "src/init.cpp",
    "src/log.cpp",
    "src/ring.cpp",
    "src/domain.cpp",
  ]
  public_deps = [ ":headers" ]
  visibility = [ "*" ]
}

host_test("logz4-test") {
  sources = [ "test/logz4_test.cpp" ]
  deps = [ ":logz4" ]
  defines = [ "KERNEL_DEBUG_LEVEL=1" ]
}

group("tests") {
  testonly = true
  deps = [ ":logz4-test" ]
}
