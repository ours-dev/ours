# Host-side tests. These link googletest and run on the build machine: a
# tree is built in memory, and the server is driven one encoded message at a
# time, with a stand-in for the one system call it makes.
executable("ioservice") {
  testonly = true
  sources = [
    "server_test.cpp",
    "tree_test.cpp",
  ]
  deps = [
    "//system/lib/ioservice",
    "//system/lib/protocols",
    "//vendor/googletest:gtest",
    "//vendor/googletest:gtest_main",
  ]
  visibility = [ "*" ]
}

# The LoopServer on a real Loop, against the shared fake kernel
# (//system/lib/testing/fake_kernel): the system calls it and the Loop make
# are answered by the fake, which defines them under the vDSO's symbols, so
# the library's own source is what runs.
executable("loop_server") {
  testonly = true
  sources = [ "loop_server_test.cpp" ]
  deps = [
    "//system/lib/testing/fake_kernel",
    "//system/lib/ioservice:loop_server",
    "//vendor/googletest:gtest",
    "//vendor/googletest:gtest_main",
  ]
  visibility = [ "*" ]
}

# Outgoing, an outgoing directory on a real Loop, against the same fake
# kernel: an Open of svc/<name> reaches that protocol's handler, a name it does
# not serve is answered NotFound.
executable("outgoing") {
  testonly = true
  sources = [ "outgoing_test.cpp" ]
  deps = [
    "//system/lib/testing/fake_kernel",
    "//system/lib/ioservice:outgoing",
    "//vendor/googletest:gtest",
    "//vendor/googletest:gtest_main",
  ]
  visibility = [ "*" ]
}
