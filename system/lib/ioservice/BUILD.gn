import("//build/cpp/cpp_interface.gni")

# An ours.io server for read-only trees (component-framework design,
# "ioservice"): pseudo-directories, VMO files and services, the connection
# table, the Open checks and the handlers. Its core takes a message and answers
# what to write and what to wait on, without touching a channel, and makes its
# one system call through a function it is given, so it builds in every
# toolchain, the host one included, where its tests run.
source_set("ioservice") {
  sources = [
    "src/server.cpp",
    "src/tree.cpp",
  ]

  # Its messages are ours.io's, on the wire framing, so a user of the
  # server is a user of both.
  public_deps = [
    ":headers",
    "//system/lib/ours.io",
  ]
  visibility = [ "*" ]
}

# The headers are a target of their own so that a dependant needing only the
# declarations does not pull in the sources -- see
# //build/cpp/cpp_interface.gni.
cpp_interface("headers") {
  public = [
    "include/ioservice/server.hpp",
    "include/ioservice/tree.hpp",
  ]
  public_deps = [
    "//system/lib/ours.io:headers",
    "//system/lib/ustl:headers",
    "//system/lib/wire:headers",
    "//system/public",
  ]
  visibility = [ "*" ]
}

# The core served on a Loop (<ioservice/loop_server.hpp>): reads a message
# from each connection's channel, hands it to the core and carries out what it
# says. It is a target of its own so that the core keeps making no system
# call. This one calls the vDSO's channel_read, channel_write and
# handle_close besides the Loop's own three, so it builds wherever
# <ours/vdso.hpp> does: in a user toolchain, where the vDSO binds those calls,
# and in the host one, where its test links a fake kernel that defines the
# same symbols (test/fake_kernel.cpp).
source_set("loop_server") {
  sources = [ "src/loop_server.cpp" ]
  public_deps = [
    ":ioservice",
    ":loop_server.headers",
    "//system/lib/loop",
  ]
  visibility = [ "*" ]
}

cpp_interface("loop_server.headers") {
  public = [ "include/ioservice/loop_server.hpp" ]
  public_deps = [
    ":headers",
    "//system/lib/loop:headers",
  ]
  visibility = [ "*" ]
}

# The provider side of a component: its outgoing directory, an ioservice::Tree
# served by a LoopServer, with one entry under svc/ per protocol
# (<ioservice/outgoing.hpp>). It calls the vDSO's handle_close,
# handle_duplicate and debug_write itself (the last to say a refused Open on
# the debug console), so it builds wherever <ours/vdso.hpp> does, as
# :loop_server does, and needs no print helper of the runtime.
source_set("outgoing") {
  sources = [ "src/outgoing.cpp" ]
  public_deps = [
    ":loop_server",
    ":outgoing.headers",
  ]
  visibility = [ "*" ]
}

cpp_interface("outgoing.headers") {
  public = [ "include/ioservice/outgoing.hpp" ]
  public_deps = [ ":loop_server.headers" ]
  visibility = [ "*" ]
}

# Host unit tests; wired into //:default.
group("tests") {
  testonly = true
  public_deps = [
    "test:ioservice($host_toolchain)",
    "test:loop_server($host_toolchain)",
    "test:outgoing($host_toolchain)",
  ]
}
