# Host-side tests. These link googletest and run on the build machine: each
# method's request and reply are written, read back and broken on purpose,
# from bytes alone.
executable("ours_acpi") {
  testonly = true
  sources = [ "ours_acpi_test.cpp" ]
  deps = [
    "//system/lib/ours.acpi",
    "//vendor/googletest:gtest",
    "//vendor/googletest:gtest_main",
  ]
  visibility = [ "*" ]
}
