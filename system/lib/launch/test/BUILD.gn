import("//build/cpp/host_test.gni")

# Host-side tests. These link googletest and run on the build machine: the
# planner decides how to map a program from numbers alone, so it can be checked
# without a kernel.
host_test("plan") {
  sources = [ "plan_test.cpp" ]
  deps = [
    "//system/lib/launch:plan",
    "//vendor/googletest:gtest",
    "//vendor/googletest:gtest_main",
  ]
  visibility = [ "*" ]
}

# Reading a program's PT_LOAD segments, PT_GNU_RELRO and entry point out of its
# ELF headers, checked on ELF images built in the test.
host_test("program") {
  sources = [ "program_test.cpp" ]
  deps = [
    "//system/lib/eftl:headers",
    "//system/lib/launch:plan",
    "//vendor/googletest:gtest",
    "//vendor/googletest:gtest_main",
  ]
  visibility = [ "*" ]
}

# The Launcher's per-connection state: Add* calls taken in, Launch judged and
# its program handed to a fake start hook, the processargs it would get read
# back with the runtime's decoder, every handle accounted for.
host_test("process_launcher") {
  sources = [ "process_launcher_test.cpp" ]
  deps = [
    "//system/lib/launch:process_launcher",
    "//system/lib/ort:process_args",
    "//vendor/googletest:gtest",
    "//vendor/googletest:gtest_main",
  ]
  visibility = [ "*" ]
}
