import("//build/cpp/cpp_interface.gni")
import("//build/toolchain/toolchain_environment.gni")

# The planner: which pages of a program come from its file, from a snapshot of
# it or from zero-fill memory, decided from numbers alone (Program::read() and
# Plan::build()). It makes no system call, so it builds for the host too,
# where its tests run.
source_set("plan") {
  sources = [
    "src/plan.cpp",
    "src/program.cpp",
  ]
  public_deps = [ ":headers" ]
  deps = [ "//system/lib/eftl" ]
}

# The launcher service's protocol (launch/protocol.hpp): requests encoded and
# checked from bytes alone, so it builds for the host too, where its tests run.
# The processargs a Launch request carries is checked by the runtime's one
# decoder.
source_set("protocol") {
  sources = [ "src/protocol.cpp" ]
  public_deps = [
    ":headers",
    "//system/lib/ort:process_args",
    "//system/lib/ustl:headers",
  ]
}

# fuchsia.process.Launcher's per-connection state (launch/process_launcher.hpp):
# what a client's Add* calls have given, and the judging of each message it
# sends. The program is started through a hook its server supplies, so the
# state makes no system call and builds for the host too, where its tests run.
source_set("process_launcher") {
  sources = [ "src/process_launcher.cpp" ]
  public_deps = [
    ":headers",
    "//system/lib/fuchsia-process",
  ]
}

# The user-space launcher: how a program from BootFS becomes a running process.
# start() carries out a plan through system calls, and the BootFS launcher
# (launch/bootfs.hpp) finds a program by name for it, so both are defined only
# in the user toolchains, where a program has the vDSO to call. Keyed on
# is_host_toolchain as well, since toolchain_environment reads "user" in the
# host toolchain too (see //system/lib/ort): the host builds the planner's
# tests, and must never reach a system call.
if (!is_host_toolchain && toolchain_environment == "user") {
  source_set("launch") {
    sources = [
      "src/launch.cpp",
      "src/bootfs.cpp",
      "src/client.cpp",
    ]
    public_deps = [
      ":headers",
      ":plan",
      ":protocol",
    ]
    deps = [
      "//system/lib/bootfs:headers",
      "//system/lib/elfload",
    ]
  }
}

# The headers are a target of their own so that a dependant needing only the
# declarations does not pull in the sources -- see
# //build/cpp/cpp_interface.gni.
cpp_interface("headers") {
  public = [
    "include/launch/bootfs.hpp",
    "include/launch/client.hpp",
    "include/launch/launch.hpp",
    "include/launch/plan.hpp",
    "include/launch/process_launcher.hpp",
    "include/launch/program.hpp",
    "include/launch/protocol.hpp",
  ]
  public_deps = [
    "//system/lib/elfload:headers",
    "//system/public",
  ]
}

group("tests") {
  testonly = true
  public_deps = [
    "test:plan($host_toolchain)",
    "test:process_launcher($host_toolchain)",
    "test:program($host_toolchain)",
    "test:protocol($host_toolchain)",
  ]
}
