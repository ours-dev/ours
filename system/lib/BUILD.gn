# The system/lib root is a test-discovery rollup rather than a library
# dependency bundle: it gathers the test groups of some of the libraries under
# it, not all of them, and code depends on each library by its own label.
group("tests") {
  testonly = true
  deps = [
    "concurrent:tests",
    "derive:tests",
    "ffl:tests",
    "hsien:tests",
    "logz4:tests",
    "ustl:tests",
  ]
}
