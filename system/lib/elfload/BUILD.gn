import("//build/cpp/cpp_interface.gni")

# The half of loading an ELF that needs no address space: binding one image's
# imports to another's exports (Binder), and checking that a file is a program
# this system can start (check_program). It needs a buffer and two ELF files --
# no kernel object -- so the kernel, which starts the first processes, and the
# user-space launcher, which starts the rest, use the same code.
#
# Placing segments in an address space is the other half, and it is not here:
# the kernel's is //kernel/lib/kelfload (through the object layer), a
# launcher's goes through vma_map.
#
# Says why it refused through elfload::Diagnostics, which the caller passes
# in (Zircon elfldltl's shape): the kernel turns a report into a logz4 line,
# a user program into whatever it prints. It used to log through logz4, which
# a user program cannot link: logz4 needs an allocator, libc++'s
# floating-point formatting and a linker section that only the kernel has.
source_set("elfload") {
  sources = [
    "src/binder.cpp",
    "src/program.cpp",
  ]
  public_deps = [ ":headers" ]
  deps = [ "//system/lib/eftl" ]
  visibility = [ "*" ]
}

# The headers are a target of their own so that a dependant needing only the
# declarations does not pull in the sources -- see
# //build/cpp/cpp_interface.gni.
cpp_interface("headers") {
  public = [
    "include/elfload/binder.hpp",
    "include/elfload/diagnostics.hpp",
    "include/elfload/image.hpp",
    "include/elfload/program.hpp",
  ]
  public_deps = [
    "//system/lib/eftl:headers",
    "//system/lib/ustl:headers",
    "//system/public",
  ]
  visibility = [ "*" ]
}
