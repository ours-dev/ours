import("//build/cpp/cpp_interface.gni")

# What runs before a program's main and after it: reading the processargs
# message the process was started with, holding its startup handles until
# they are claimed, and the call into main.
#
# This is the part that works on bytes and handle values alone -- the
# decoder and the handle table -- and so builds in every toolchain,
# including the host one its tests run in. The start-up code that reads the
# bootstrap channel and calls main is user-only and comes separately.
source_set("process_args") {
  sources = [
    "src/process_args.cpp",
    "src/startup_handles.cpp",
  ]
  public_deps = [ ":headers" ]
  visibility = [ "*" ]
}

# The headers are a target of their own so that a dependant needing only the
# declarations does not pull in the sources -- see
# //build/cpp/cpp_interface.gni.
cpp_interface("headers") {
  public = [
    "include/runtime/process_args.hpp",
    "include/runtime/startup_handles.hpp",
  ]

  # <ours/process_args.hpp>, the format this decodes.
  public_deps = [ "//system/public" ]
  visibility = [ "*" ]
}

# Host unit tests; wired into //:default.
group("tests") {
  testonly = true
  public_deps = [ "test:process_args($host_toolchain)" ]
}

# The start-up code: the entry point every user program that links this
# gets (_start, src/crt0.S), and what it runs before main and after.
#
# User programs only. Not in the host toolchain (keyed on is_host_toolchain,
# since toolchain_environment reads "user" there) nor the kernel ones:
# _start, a system call through ou, and a main to call exist only in a ring-3
# program. Not yet a default dependency of user_executable() either:
# userboot still defines its own _start, which this one would collide with,
# until it becomes a launcher (U8). Programs moved one producer-consumer pair
# at a time -- fault_probe, then init and the shell together with the
# kernel's own processargs (design K14) -- and until userboot follows, each
# names this dependency itself.
if (!is_host_toolchain && toolchain_environment == "user") {
  source_set("runtime") {
    sources = [
      "src/cpp_dependencies.cpp",
      "src/crt0.S",
      "src/start.cpp",
    ]
    public_deps = [
      ":process_args",
      ":start.headers",
    ]
    deps = [ "//system/lib/ou" ]
    visibility = [ "*" ]
  }

  # main.hpp in particular must stay out of anything built hosted, where
  # declaring main extern "C" is an error.
  cpp_interface("start.headers") {
    public = [
      "include/runtime/main.hpp",
      "include/runtime/startup.hpp",
    ]
    public_deps = [ ":headers" ]
    visibility = [ ":*" ]
  }
}
