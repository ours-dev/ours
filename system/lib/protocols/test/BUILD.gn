# malformed reply and its stray handle closed, and the silent close. The
# /svc overload walks a fake /svc bound into the real namespace: its
# namespace table links on the host, and the Tree+LoopServer behind the
# bound directory is the ioservice suite's.
executable("resource_client") {
  testonly = true
  sources = [
    "../src/resource_client.cpp",
    "resource_client_test.cpp",
  ]
  deps = [
    "//system/lib/fsio:headers",
    "//system/lib/fsio:namespace",
