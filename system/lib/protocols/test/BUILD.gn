# The protocols library's host tests. These link googletest and run on the
# build machine: the codecs work on bytes and handle values alone, so every
# message can be written, read back and broken on purpose without a kernel.

# ours.block: round trips for both methods, and the refusals a closed
# protocol's decoders owe.
executable("block") {
  testonly = true
  sources = [ "block_test.cpp" ]
  deps = [
    "//system/lib/protocols",
    "//vendor/googletest:gtest",
    "//vendor/googletest:gtest_main",
  ]
  visibility = [ "*" ]
}

# ours.block's typed client, over the fake kernel: the test plays the Block
# provider inside the fixture's pump, answering the codec's requests per
# mode -- the round trips, the client-side refusals, the short reply, the
# epitaph, the silent close, and the reply to another request's txid.
executable("block_client") {
  testonly = true
  sources = [ "block_client_test.cpp" ]
  deps = [
    "//system/lib/ort:headers",
    "//system/lib/protocols",
    "//system/lib/rpc:headers",
    "//system/lib/testing/fake_kernel",
    "//system/lib/wire",
    "//vendor/googletest:gtest",
    "//vendor/googletest:gtest_main",
  ]
  visibility = [ "*" ]
}

# ours.acpi's typed client, over the fake kernel: the test plays the Route
# provider inside the fixture's pump -- both round trips, the epitaph, the
# stray handle on a reply refused with the handle closed, the other method's
# reply caught as InvArgs, and the silent close reading PeerClosed. The
# /svc overloads walk a fake /svc bound into the real namespace: its
# namespace table links on the host, and the Tree+LoopServer behind the
# bound directory is the ioservice suite's.
executable("acpi_client") {
  testonly = true
  sources = [
    "../src/acpi_client.cpp",
    "acpi_client_test.cpp",
  ]
  deps = [
    "//system/lib/fsio:headers",
    "//system/lib/fsio:namespace",
    "//system/lib/ioservice:loop_server",
    "//system/lib/protocols",
    "//system/lib/rpc:headers",
    "//system/lib/testing/fake_kernel",
    "//system/lib/wire",
    "//vendor/googletest:gtest",
    "//vendor/googletest:gtest_main",
  ]
  visibility = [ "*" ]
}

