import("//build/cpp/host_test.gni")

# Host-side tests. These link googletest and run on the build machine: every
# Launcher message is written, read back and broken on purpose, from bytes and
# handle values alone.
host_test("ours_process") {
  sources = [ "ours_process_test.cpp" ]
  deps = [
    "//system/lib/ours.process",
    "//vendor/googletest:gtest",
    "//vendor/googletest:gtest_main",
  ]
  visibility = [ "*" ]
}
