import("//build/cpp/cpp_interface.gni")

# ours.io, the protocol files and directories are served over, encoded and
# decoded by hand on //system/lib/wire (component-framework design S6). Bytes
# and handle values alone, no system call, so it builds in every toolchain, the
# host one included, where its tests run.
#
# The target is named after the directory, so that //system/lib/ours-io is
# its label; the include prefix and the namespace are ours_io, the
# protocol library's name with its dot made an underscore, as a C++ name
# cannot hold a hyphen or a dot.
source_set("ours-io") {
  sources = [ "src/ours_io.cpp" ]

  # Its messages are wire::Message and its methods wire::Method, so a user of
  # the codec is a user of the framing too.
  public_deps = [
    ":headers",
    "//system/lib/wire",
  ]
  visibility = [ "*" ]
}

# The headers are a target of their own so that a dependant needing only the
# declarations does not pull in the sources -- see
# //build/cpp/cpp_interface.gni.
cpp_interface("headers") {
  public = [ "include/ours_io/ours_io.hpp" ]
  public_deps = [
    "//system/lib/ustl:headers",
    "//system/lib/wire:headers",
    "//system/public",
  ]
  visibility = [ "*" ]
}

# Host unit tests; wired into //:default.
group("tests") {
  testonly = true
  public_deps = [ "test:ours_io($host_toolchain)" ]
}
