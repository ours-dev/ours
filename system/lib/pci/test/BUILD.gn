# The pci library's host tests: the walk, the sizing arithmetic and the
# assignment writes, all over a fake ECAM array in host memory -- the
# library is bytes-only by contract.
executable("pci") {
  testonly = true
  sources = [ "pci_test.cpp" ]
  deps = [
    "//system/lib/pci:pci.headers",
    "//vendor/googletest:gtest",
    "//vendor/googletest:gtest_main",
  ]
  visibility = [ "*" ]
}
