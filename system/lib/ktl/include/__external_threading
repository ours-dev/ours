#ifndef OURS_SYSTEM_LIB_KTL_INCLUDE___EXTERNAL_THREADING_
#define OURS_SYSTEM_LIB_KTL_INCLUDE___EXTERNAL_THREADING_

// The kernel does not provide libc++'s hosted threading ABI. libc++ still
// requires this header when configured for an external threading API.

_LIBCPP_BEGIN_NAMESPACE_STD

typedef int __libcpp_mutex_t;
typedef int __libcpp_recursive_mutex_t;
typedef int __libcpp_condvar_t;
typedef int __libcpp_thread_t;
typedef int __libcpp_exec_once_flag;
typedef int __libcpp_thread_id;

struct __libcpp_timespec_t {
  long tv_sec;
  long tv_nsec;
};

#define _LIBCPP_EXEC_ONCE_INITIALIZER 0

inline int __libcpp_mutex_lock(__libcpp_mutex_t*) { return 0; }
inline int __libcpp_mutex_trylock(__libcpp_mutex_t*) { return 0; }
inline int __libcpp_mutex_unlock(__libcpp_mutex_t*) { return 0; }
inline int __libcpp_mutex_destroy(__libcpp_mutex_t*) { return 0; }

inline int __libcpp_recursive_mutex_lock(__libcpp_recursive_mutex_t*) {
  return 0;
}
inline int __libcpp_recursive_mutex_trylock(__libcpp_recursive_mutex_t*) {
  return 0;
}
inline int __libcpp_recursive_mutex_unlock(__libcpp_recursive_mutex_t*) {
  return 0;
}
inline int __libcpp_recursive_mutex_destroy(__libcpp_recursive_mutex_t*) {
  return 0;
}

inline int __libcpp_condvar_signal(__libcpp_condvar_t*) { return 0; }
inline int __libcpp_condvar_broadcast(__libcpp_condvar_t*) { return 0; }
inline int __libcpp_condvar_destroy(__libcpp_condvar_t*) { return 0; }

inline int __libcpp_execute_once(__libcpp_exec_once_flag*, void (*)(void)) {
  return 0;
}

inline bool __libcpp_thread_id_equal(__libcpp_thread_id lhs,
                                     __libcpp_thread_id rhs) {
  return lhs == rhs;
}
inline bool __libcpp_thread_id_less(__libcpp_thread_id lhs,
                                    __libcpp_thread_id rhs) {
  return lhs < rhs;
}
inline __libcpp_thread_id __libcpp_thread_get_current_id() { return 0; }
inline void __libcpp_thread_sleep_for(chrono::nanoseconds) {}
inline void __libcpp_thread_yield() {}

#define _LIBCPP_THREAD_ABI_VISIBILITY inline _LIBCPP_INLINE_VISIBILITY

_LIBCPP_END_NAMESPACE_STD

#endif // OURS_SYSTEM_LIB_KTL_INCLUDE___EXTERNAL_THREADING_
