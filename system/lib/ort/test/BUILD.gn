# Host-side tests. These link googletest and run on the build machine: the
# encoder in <ours/process_args.hpp> and the decoder here work on bytes and
# handle values alone, so a message can be written, read back and broken on
# purpose without a kernel.
executable("process_args") {
  testonly = true
  sources = [ "process_args_test.cpp" ]
  deps = [
    "//system/lib/ort:process_args",
    "//vendor/googletest:gtest",
    "//vendor/googletest:gtest_main",
  ]
  visibility = [ "*" ]
}

# A user program on the runtime, built only to be linked and inspected; see
# ort_smoke.cpp. User toolchain only, like the runtime itself.
if (!is_host_toolchain && toolchain_environment == "user") {
  import("//system/user_executable.gni")

  user_executable("ort_smoke") {
    sources = [ "ort_smoke.cpp" ]
  }
}
