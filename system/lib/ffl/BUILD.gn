import("//build/cpp/cpp_interface.gni")

# Fixed-point arithmetic for the scheduler: exact ratios, defined rounding,
# no floating point. Header-only -- every operation is constexpr and there is
# nothing to link, so there is no source_set here. Not the scheduler's alone:
# ours/time/ticks_per_second.hpp uses ffl::saturating_mul() to turn a wait
# into counts without wrapping.
cpp_interface("headers") {
  public = [
    "include/ffl/fixed.hpp",
    "include/ffl/format.hpp",
    "include/ffl/mul_shr.hpp",
    "include/ffl/saturating.hpp",
    "include/ffl/wider.hpp",
  ]
  visibility = [ "*" ]
}

group("ffl") {
  public_deps = [ ":headers" ]
  visibility = [ "*" ]
}

group("tests") {
  testonly = true
  public_deps = [ "test:fixed($host_toolchain)" ]
}
