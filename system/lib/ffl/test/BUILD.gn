import("//build/cpp/host_test.gni")

# Host-side tests. Everything in ffl is constexpr, so the bulk of the
# verification is static_assert inside the test translation unit -- a failure
# is a compile error, not a failed run. The runtime cases cover what
# static_assert cannot: values chosen at run time, which is where a
# mis-predicted branch in the rounding would show.
host_test("fixed") {
  sources = [ "fixed_test.cpp" ]
  deps = [
    "//system/lib/ffl:headers",
    "//vendor/googletest:gtest",
    "//vendor/googletest:gtest_main",
  ]
  visibility = [ "*" ]
}
