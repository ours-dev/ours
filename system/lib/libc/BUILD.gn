import("//build/toolchain/toolchain_environment.gni")

# The C library, one copy for every ring: the kernel, the phys stages and
# user programs build the same sources, each in its own toolchain, and so
# with that toolchain's flags. Only what something calls is defined -- mem*
# and strlen (src/string.cpp) -- behind freestanding headers (include/) that
# declare a little more; the design is 3.6 of
# docs/design/260923/userspace-interface.md.
#
# Zircon keeps two, the kernel's //zircon/kernel/lib/libc/string and user
# space's //sdk/lib/c/string. One copy here, because the only thing that
# separates the rings is the toolchain, and a toolchain is applied per build
# of the same sources anyway.

# The C headers, searched after libc++'s own.
#
# libc++ must be searched before the C headers so its wrapper headers can
# delegate to this freestanding C surface with include_next.
#
# That is why this is a config with explicit -isystem flags rather than the
# include_dirs of a cpp_interface or a public_config of :libc: both of those
# come out as -I, which is searched before every -isystem directory, libc++'s
# included, and <cstring> would reach these headers without going through its
# own <string.h> wrapper. It is applied from the toolchain side --
# //build/config:default_include_dirs for the kernel toolchains,
# //system:user.headers for the user one -- so that it lands after libc++ on
# every command line, whatever the target depends on.
config("headers.after") {
  visibility = [ "*" ]
  cflags_c = [
    "-isystem",
    rebase_path("//system/lib/libc/include", root_build_dir),
  ]
  cflags_cc = [
    "-isystem",
    rebase_path("//system/lib/libc/include", root_build_dir),
  ]
}

# The functions.
#
# Never in a host toolchain. The definitions have C linkage and the names the
# host's own libc uses, so a host executable linking them would replace its
# libc's memcpy with this one; and a host compile is not -ffreestanding,
# which is what stops clang from recognising a byte loop as memcpy and
# compiling memcpy into a call to itself. Every toolchain that builds this
# today -- kernel, kernel.phys, user -- is freestanding.
#
# A source_set, as every library under system/lib is: its objects go into
# every image that depends on it. The user toolchain links without
# --gc-sections, so every user program carries all of them, a few hundred
# bytes, whether it calls them or not.
source_set("libc") {
  assert(toolchain_environment != "host",
         "//system/lib/libc defines the host libc's own symbols; see above")
  sources = [ "src/string.cpp" ]
  visibility = [ "*" ]
}
