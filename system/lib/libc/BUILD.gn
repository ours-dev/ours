import("//build/toolchain/toolchain_environment.gni")

# The C library, one copy for every ring: the kernel, the phys stages and
# user programs build the same sources, each in its own toolchain, and so
# with that toolchain's flags. Only what something calls is defined -- mem*
# and strlen (src/string.cpp) -- behind freestanding headers (include/) that
# declare a little more; the design is 3.6 of
# docs/design/260923/userspace-interface.md.
#
# One copy rather than one per ring, because the only thing that separates
# the rings is the toolchain, and a toolchain is applied per build of the
# same sources anyway.

# The C headers, searched after libc++'s own.
#
# libc++ must be searched before the C headers so its wrapper headers can
# delegate to this freestanding C surface with include_next.
#
# That is why this is a config with explicit -isystem flags rather than the
# include_dirs of a cpp_interface or a public_config of :libc: both of those
# come out as -I, which is searched before every -isystem directory, libc++'s
# included, and <cstring> would reach these headers without going through its
# own <string.h> wrapper. It is applied from the toolchain side --
# //build/config:default_include_dirs for the kernel toolchains,
# //system:user.headers for the user one -- so that it lands after libc++ on
# every command line, whatever the target depends on.
config("headers.after") {
  visibility = [ "*" ]
  cflags_c = [
    "-isystem",
    rebase_path("//system/lib/libc/include", root_build_dir),
  ]
  cflags_cc = [
    "-isystem",
    rebase_path("//system/lib/libc/include", root_build_dir),
  ]
}

# The byte loops themselves, under names of their own (ours::libc::memcpy
# and so on; src/string_impl.hpp says why). Built in every toolchain the
# library is, and in the host one for the tests, which is safe because it
# defines no C name.
source_set("impl") {
  sources = [
    "src/string_impl.cpp",
    "src/string_impl.hpp",
  ]

  # Explicit although every target toolchain is -ffreestanding already, which
  # implies it: this file is only correct with it (string_impl.cpp says why),
  # and the host toolchain the tests build it in is not freestanding.
  cflags = [ "-fno-builtin" ]

  # x86-64's char, on every host. The loops are written to be right whatever
  # char's signedness -- memcmp reads u8 -- and a regression to reading
  # `char` would show only where char is signed; on a host where it is not
  # (Linux on arm64), the tests would pass on the broken code.
  #
  # Keyed on is_host_toolchain, not on toolchain_environment: in
  # //build/toolchain/ours:host, where the tests are built, that variable is
  # "user" -- "host" is what the default toolchain, which builds nothing,
  # sees (//build/toolchain/toolchain_environment.gni).
  if (is_host_toolchain) {
    cflags += [ "-fsigned-char" ]
  }
  visibility = [
    ":*",
    "test:*",
  ]
}

# The C names: memcpy() and the rest, each forwarding to :impl.
#
# Never in a host toolchain. These definitions have the names the host's own
# libc uses, so a host executable linking them would replace its libc's
# memcpy with this one -- googletest's included, and with it the host
# functions the tests use as their reference. The target is simply not
# defined in the host toolchain, so a host dependency on it fails as an
# unknown label. An assert inside it would not do: the host toolchain loads
# this file for :impl and the tests, and loading a file evaluates every
# target in it.
#
# A source_set, as every library under system/lib is: its objects go into
# every image that depends on it. The user toolchain links without
# --gc-sections, so every user program carries all of them, a few hundred
# bytes, whether it calls them or not.
if (!is_host_toolchain) {
  source_set("libc") {
    sources = [ "src/string.cpp" ]
    deps = [ ":impl" ]
    visibility = [ "*" ]
  }
}

# Host unit tests for :impl; wired into //:default.
group("tests") {
  testonly = true
  public_deps = [ "test:string($host_toolchain)" ]
}
