import("//build/cpp/cpp_interface.gni")

# The provider side of a component: its outgoing directory, served on the
# Loop (<svc/outgoing.hpp>; component-framework design, "svc::Outgoing").
#
# It is an ioservice::Tree served by an ioservice::LoopServer
# (//system/lib/ioservice:loop_server) on a Loop (//system/lib/loop), and calls
# the vDSO's handle_close and handle_duplicate itself. So it builds wherever
# <ours/vdso.hpp> does: in a user toolchain, where the vDSO binds those calls,
# and in the host one, where the test links a fake kernel that defines the
# same symbols (//system/lib/ioservice/test:fake_kernel).
source_set("svc") {
  sources = [ "src/outgoing.cpp" ]
  public_deps = [
    ":headers",
    "//system/lib/ioservice:loop_server",
    "//system/lib/loop",
  ]
  visibility = [ "*" ]
}

# The headers are a target of their own so that a dependant needing only the
# declarations does not pull in the sources -- see
# //build/cpp/cpp_interface.gni.
cpp_interface("headers") {
  public = [ "include/svc/outgoing.hpp" ]
  public_deps = [
    "//system/lib/ours.io:headers",
    "//system/lib/loop:headers",
    "//system/lib/ioservice:headers",
    "//system/lib/ioservice:loop_server.headers",
    "//system/lib/wire:headers",
    "//system/public",
  ]
  visibility = [ "*" ]
}

# Host unit tests; wired into //:default.
group("tests") {
  testonly = true
  public_deps = [ "test:svc($host_toolchain)" ]
}
