# This canonical target is where versioned SDK availability macros would be
# compile-checked.  Ours has no API-level/versioning contract yet, so the
# label remains a non-testonly discovery stub rather than a fake static
# library that would incorrectly report those checks as passing.
group("availability_test") {
  visibility = [ "//:*" ]
  metadata = {
    unavailable_components = [
      {
        component = "system-api-availability-test"
        reason = "Ours has no versioned system API-level macro contract"
      },
    ]
    unavailable_components_barrier = []
  }
}

# ---- Userspace compile/link policy ----
#
# The user-mode mirror of //kernel/products:kernel.config.  The `user`
# toolchains in //build/toolchain/ours apply this through toolchain_args,
# so every target built in one of them gets the policy without naming it.
#
# It is a separate config, and not a reuse of the kernel's, because the two
# environments disagree on exactly the flags that matter: the kernel is
# compiled -mcmodel=kernel -mno-red-zone -mno-sse (//kernel/arch/x86:abi),
# all three of which are wrong for a program that runs at a low address in
# ring 3 on its own stack.  //build/config/x86 was already split with this
# in mind -- cpu_baseline gives every toolchain the ISA baseline and leaves
# the kernel-mode ABI constraints to the kernel toolchains.
config("user.config") {
  configs = [
    ":user.standalone",
    ":user.headers",
    "//build/config:no_exceptions",
    "//build/config:no_rtti",
    "//build/config:no_stack_protector",

    # kernel_elf_binary() extracts a GNU build ID from every image it
    # packages (build/elf/extract-build-id.py errors out when it finds none),
    # and BUILDCONFIG.gn only puts //build/config:build_id in
    # default_executable_configs for is_kernel toolchains.
    "//build/config:build_id",
  ]
}

# What a user program needs in order to say anything about the system it runs
# on: the public headers (//system/public), and the prelude that defines the
# global integer aliases they are written in.
#
# The prelude lives under //kernel/include, which reads oddly from here, and
# is nonetheless the right file: system/public/ours/types.hpp spells `usize`
# and `u32` unqualified, so *any* toolchain that includes a public header
# needs those aliases in scope. //kernel/products:host-prelude force-includes
# this very file into host builds for exactly the same reason.
config("user.headers") {
  configs = [
    "//system/public:public.config",

    # rights.hpp and signals.hpp name their bitmask operators through ustl's
    # USTL_ENABLE_ENUM_BITMASK (<type_traits> and <utility>, nothing else).
    # A user program reaches them as soon as it includes <ours/vdso.hpp>.
    "//system/lib/ustl:headers.config",

    # A user program is as freestanding as the kernel is: no host libc++, and
    # the host's own headers stop with `#error "No thread API"` as soon as the
    # prelude below includes <cstddef>.
    "//build/config:freestanding_libcxx_include",

    # And the freestanding C declarations libc++ delegates to, after it (its
    # wrapper headers reach these with include_next). Without them the first
    # <utility> a user program sees -- ustl's enum_bits.hpp, through
    # <ours/signals.hpp> -- stops on libc++'s `using ::memcpy` in <cstring>.
    # The same config the kernel toolchains apply, beside the headers it
    # names. Declarations only: the definitions are //system/lib/libc itself,
    # which user_executable() links (//system/user_executable.gni).
    "//system/lib/libc:headers.after",
  ]
  inputs = [ "//kernel/include/ours/prelude.hpp" ]
  cflags_cc = [
    "-include",
    rebase_path(inputs[0], root_build_dir),
  ]
}

# What every ring-3 target agrees on, whatever shape it is linked into: no
# hosted runtime, and no instruction the kernel has not turned on.
#
# The link policy is deliberately NOT here. It used to be, and that made the
# config unusable for the vDSO: `-static` and `--pie` are both refused
# alongside `-shared`, so a shared object in this toolchain could not be
# linked at all. What is left is what a static PIE and a shared object can
# both carry; :user.executable and :user.shared below add the rest.
config("user.standalone") {
  configs = [ "//build/config:freestanding" ]

  # Position-independent code, for every ring-3 target and not only for the
  # executables. The kernel picks the load address, so nothing here may bake
  # one in -- and a library compiled without this produces an R_X86_64_32
  # against a string literal that the executable it is linked into cannot
  # accept ("relocation ... cannot be used against local symbol"). The link
  # policy below differs between an executable and a shared object; the
  # compilation model does not, which is why this is here and -static/--pie
  # are not. :user.shared raises it to -fPIC, and the later flag wins.
  #
  # -fno-plt for the same reason. Every call to an imported function should
  # reach the GOT the way an imported variable does, so the loader has one
  # relocation type to apply and no PLT stub to service. It used to sit on
  # :user.program alone, which covered the executable's own translation units
  # and missed every library linked into it: a library's calls into the vDSO
  # (//system/lib/ou's, then) went through a PLT, the program grew a .rela.plt,
  # and the image's relocations stopped being the shape the rest of this config
  # describes.
  cflags = [
    "-fpie",
    "-fno-plt",
  ]

  # No SSE, MMX or x87 in a user program either -- not because ring 3 may not
  # use them, but because this kernel has not turned them on: nothing writes
  # CR4.OSFXSR (arch/x86/system.hpp defines the bit and no code sets it), so
  # the first SSE instruction raises #UD.
  #
  # It bites exactly when a program stops being trivial. userboot contains no
  # SSE at all and ran for weeks; the shell is only a little larger and
  # the compiler vectorised a struct initialisation into `pxor`/`movdqu`, which
  # died as "#UD Invalid opcode: vector=6" a few instructions into ring 3.
  #
  # The real fix is FPU/SSE state that survives a context switch, and then
  # turning the bit on; until that exists, saying so here is better than every
  # user program discovering it. See docs/repairs/260910/x86.md.
  cflags += [
    "-msoft-float",
    "-mno-mmx",
    "-mno-sse",
    "-mno-sse2",
    "-mno-3dnow",
    "-mno-avx",
    "-mno-avx2",
  ]
}

# A user program: loaded by the kernel, not by a dynamic linker, and with no
# crt1.o or C++ runtime to start it -- a static PIE with the same shape as the
# kernel image itself. Its C library is linked in like any other library
# (//system/lib/libc, a default dependency of user_executable()). ET_DYN with
# R_X86_64_RELATIVE relocations is what lets the loader place it at an
# address it chooses; -static is what keeps a PT_INTERP out of it, since
# nothing exists that could honour one.
#
# Reached through the user toolchain's `executable_configs`, so it lands on
# executables only (//build/toolchain/ours/BUILD.gn).
config("user.executable") {
  configs = [
    "//build/config:static-link",
    "//build/config:pie-link",
  ]
}

# A program that is bound to the vDSO at load time
# (//system/user_executable.gni).
#
# The difference from :user.executable is that this one is NOT closed over its
# own symbols: it calls ours_debug_write() and friends and leaves them
# undefined. Whoever loads it (the kernel's userabi::launch() or the
# user-space launcher) resolves them against the vDSO's .dynsym. -static is
# what forbids exactly that, which is why the two configs cannot be one.
#
# Still a PIE: the kernel picks the load address, and the relocation pass that
# binds the imports applies the image's own R_X86_64_RELATIVE entries in the
# same sweep.
config("user.program") {
  configs = [ "//build/config:pie-link" ]

  # The compilation model -- -fpie, -fno-plt -- is not here: it belongs to
  # every ring-3 target, including the libraries a program links, and lives in
  # :user.standalone for that reason. What is here is only what linking an
  # executable against the vDSO adds.
  ldflags = [
    "-nostdlib",
    "-nostdlib++",

    # Nothing here can service a lazily bound PLT stub: an image is bound
    # once, before it runs.
    "-Wl,-z,now",

    # There is no dynamic linker: whoever starts the process maps the vDSO and
    # binds the program against it, so a PT_INTERP would name something that
    # does not exist.
    "-Wl,--no-dynamic-linker",

    # The program's references to its own definitions are resolved at link
    # time -- nothing can preempt them, and every such reference left dynamic
    # would be one more relocation for the loader to apply at boot.
    "-Wl,-Bsymbolic",
  ]
}

# A shared object in ring 3, which today means the vDSO alone.
#
# The user-mode mirror of //kernel/phys:phys-module, and for the same reasons:
#
#   * -fPIC because the kernel picks the load address at run time (raising
#     :user.standalone's -fpie, which every ring-3 target already has, along
#     with -fno-plt).
#   * `-z now`, because nothing here can service a lazily bound PLT stub.
#   * --no-dynamic-linker because there is none: whoever starts a process
#     (the kernel's userabi::launch() or the user-space launcher) maps this
#     image and binds the program against it.
#   * -Bsymbolic so the object's references to its own default-visibility
#     symbols are resolved at link time. Default visibility here is not an
#     invitation to preempt the definition -- nothing can -- it is how a
#     symbol reaches .dynsym, which is the whole export mechanism.
#
# -shared itself comes from the toolchain's solink_module tool, so a
# loadable_module() gets it without this config saying so.
config("user.shared") {
  cflags = [ "-fPIC" ]
  asmflags = [ "-fPIC" ]
  ldflags = [
    "-nostdlib",
    "-nostdlib++",
    "-Wl,-z,now",
    "-Wl,--no-dynamic-linker",
    "-Wl,-Bsymbolic",
  ]
}
