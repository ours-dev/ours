# Zircon uses this canonical target to compile-check versioned SDK availability
# macros.  Ours has no API-level/versioning contract yet, so the label remains
# a non-testonly discovery stub rather than a fake static library that would
# incorrectly report those checks as passing.
group("availability_test") {
  visibility = [ "//:*" ]
  metadata = {
    unavailable_components = [
      {
        component = "system-api-availability-test"
        reason = "Ours has no versioned system API-level macro contract"
      },
    ]
    unavailable_components_barrier = []
  }
}
