# component_manifest() -- one component's manifest, compiled into the BootFS
# as `meta/<target name>`.
#
# The manifest is written as a GN scope, not as a file of its own (D1 in
# docs/design/261004/component-framework.md). The scope holds the manifest's
# keys (`manifest` below); what is a GN label in ours -- the program and the
# children -- is a template parameter instead, so nothing is spelled twice and
# a dangling child fails at gn gen:
#
#   component_manifest("shell.cm") {
#     program = ":shell"
#     manifest = {
#       use = [
#         {
#           directory = "boot"
#           path = "/boot"
#           rights = [ "rx*" ]
#         },
#       ]
#     }
#   }
#
#   component_manifest("root.cm") {
#     children = [
#       {
#         name = "shell"
#         manifest = "//system/app/shell:shell.cm"
#         startup = "eager"
#       },
#     ]
#     manifest = {
#       offer = [
#         {
#           directory = "boot"
#           from = "parent"
#           to = "#shell"
#         },
#       ]
#     }
#   }
#
# //system/component_manifest.py checks it against the rules one manifest
# must keep on its own and compiles it into the flat format
# //system/lib/component decodes (D2). The child's URL is written as
# `fuchsia-boot:///#meta/<its target name>` (D26).
#
# Programs and child manifests are built in the user toolchain, whatever
# toolchain this target is in: the template adds it to their labels, as
# user_bootfs() adds it to programs (//kernel/products/image/dev/BUILD.gn).
# Without that, root.cm in an image's BUILD.gn, which is read in the default
# toolchain, would load //system/app/shell/BUILD.gn there, whose assert fails
# gen. So a label that already names a toolchain is refused rather than
# suffixed a second time into something GN cannot parse.
#
# Depending on the target packages the manifest, the program and every child,
# recursively: a BootFS that lists root.cm gets the whole tree.
#
# The compiler also checks the manifest's whole tree: that every protocol use
# in it, however deep, routes to a capability of the type the use asks for
# (`type` below). It reads the declaration of every descendant, so the action
# reruns when any of them changes, not only the manifest's own.
#
# Six targets, for a target named <name>:
#   <name>.source    the target's scope, as JSON (generated_file, the pattern
#                    //system/public:syscalls.json uses);
#   <name>.program   the program's install name, read from its
#                    `<program>.install_name` metadata as user_program_names()
#                    does, so no program name is spelled by hand;
#   <name>.children  each child's meta path, from the children's own
#                    `component_manifest` metadata;
#   <name>.tree      the label and the `.source.json` of every descendant, at
#                    any depth, from their `component_manifest_tree` metadata;
#   <name>.compile   the compiler, writing $target_gen_dir/<name> and naming
#                    it as `meta/<name>` for the BootFS;
#   <name>           the group a BootFS or a parent depends on.
#
# Parameters:
#
#   program (optional)
#     Plain label of the user_executable() the component runs, without a
#     toolchain suffix. It must install under bin/. Without it the component
#     has no program, as the root has none: it only holds children.
#
#   children (optional)
#     List of scopes { name, manifest, startup }: `manifest` is the plain
#     label of the child's component_manifest() target, and `startup` must
#     be written out as "eager" (D4).
#
#   manifest (optional)
#     Scope with the manifest's keys: program (args only), capabilities,
#     use, offer, expose. The subset and its rules are D3 and the design's
#     "The manifest".
#
#     A protocol in `capabilities` or in `use` may carry a `type`, the name
#     of the protocol it speaks:
#
#       capabilities = [ { protocol = "ours.examples.echo.Echo" } ]
#       use = [
#         {
#           protocol = "ours.test.Echo"
#           type = "ours.examples.echo.Echo"
#         },
#       ]
#
#     Without one, a protocol's type is its own name, so a manifest that
#     never renames a capability states none. `type` follows the rules of a
#     name and goes with one protocol, not a list. A directory has no type,
#     and neither has an `offer` or an `expose`: their `as` renames the
#     capability, not the protocol it carries. A route that resolves and ends
#     at a capability of another type than its use states is a mismatch, and
#     the build refuses it (`type_check` below), naming the use, both types
#     and every offer and expose on the way. A route that does not resolve is
#     not checked here: the root answers it when the component asks.
#
#   type_check (optional)
#     Whether the compiler checks that every route in this manifest's tree
#     ends at a capability of the type the use asks for. True by default.
#     False is for a fixture that exercises the run-time check on a mismatch
#     and for nothing else; it passes `--no-type-check` to the compiler. Every
#     manifest checks its own tree, and a manifest that sits under another
#     root is checked again there, with that root's offers. So a tree escapes
#     the check only when its root says so, and a child's `type_check = false`
#     does not hide its routes from the root above it.
#
#   builtins (optional)
#     Source-absolute path of the data file that lists the root's built-in
#     capabilities (//system/component_builtins.py reads it). With it, a route
#     that goes above the top of the tree and ends at a built-in is checked
#     against the built-in's type; without it such a route is not checked,
#     since nothing says what it reaches. Only the image's root gives it. The
#     file is an input of the action, so editing it reruns the check.
#
#   testonly, visibility
#     Standard GN meanings.
template("component_manifest") {
  assert(get_path_info(target_name, "extension") == "cm",
         "component_manifest($target_name): the target's name ends in .cm")

  # Unused by a manifest with neither a program nor children.
  _user_toolchain = "//build/toolchain/ours:user-${target_cpu}"
  not_needed([ "_user_toolchain" ])
  _label = get_label_info(":$target_name", "label_no_toolchain")
  _meta_path = "meta/$target_name"

  _main_target = target_name
  _source_target = "$target_name.source"
  _program_target = "$target_name.program"
  _children_target = "$target_name.children"
  _tree_target = "$target_name.tree"
  _compile_target = "$target_name.compile"

  _source_json = "$target_gen_dir/$target_name.source.json"
  _program_json = "$target_gen_dir/$target_name.program.json"
  _children_json = "$target_gen_dir/$target_name.children.json"
  _tree_json = "$target_gen_dir/$target_name.tree.json"
  _output = "$target_gen_dir/$target_name"

  _program_deps = []
  _install_name_deps = []
  if (defined(invoker.program)) {
    assert(
        string_replace(invoker.program, "(", "") == invoker.program,
        "component_manifest($target_name): `program` takes a plain label without a toolchain suffix: ${invoker.program}")
    _program = get_label_info(invoker.program, "label_no_toolchain")
    _program_dir = get_label_info(_program, "dir")
    _program_name = get_label_info(_program, "name")
    _program_deps = [ "$_program($_user_toolchain)" ]
    _install_name_deps =
        [ "$_program_dir:$_program_name.install_name($_user_toolchain)" ]
  }

  _type_check = true
  if (defined(invoker.type_check)) {
    _type_check = invoker.type_check
  }

  _children = []
  _child_deps = []
  if (defined(invoker.children)) {
    foreach(child, invoker.children) {
      assert(defined(child.manifest),
             "component_manifest($target_name): a child needs `manifest`")
      assert(
          string_replace(child.manifest, "(", "") == child.manifest,
          "component_manifest($target_name): a child's `manifest` takes a plain label without a toolchain suffix: ${child.manifest}")
      _child = get_label_info(child.manifest, "label_no_toolchain")
      _child_deps += [ "$_child($_user_toolchain)" ]

      # Every other key goes through as written, so that the compiler can
      # refuse one it does not know rather than have it vanish here.
      _children += [
        {
          forward_variables_from(child, "*", [ "manifest" ])
          manifest = _child
        },
      ]
    }
  }

  generated_file(_source_target) {
    forward_variables_from(invoker, [ "testonly" ])
    visibility = [ ":$_compile_target" ]
    outputs = [ _source_json ]
    output_conversion = "json"
    contents = {
      label = _label
      if (defined(_program)) {
        program = _program
      }
      if (_children != []) {
        children = _children
      }
      if (defined(invoker.manifest)) {
        manifest = invoker.manifest
      }
    }
  }

  generated_file(_program_target) {
    forward_variables_from(invoker, [ "testonly" ])
    visibility = [ ":$_compile_target" ]
    outputs = [ _program_json ]
    output_conversion = "json"
    deps = _install_name_deps
    data_keys = [ "user_program_names" ]
  }

  # Stops at each child: the barrier in every component_manifest() group
  # keeps a grandchild's entry out of this list.
  generated_file(_children_target) {
    forward_variables_from(invoker, [ "testonly" ])
    visibility = [ ":$_compile_target" ]
    outputs = [ _children_json ]
    output_conversion = "json"
    deps = _child_deps
    data_keys = [ "component_manifest" ]
    walk_keys = [ "component_manifest_barrier" ]
  }

  # Every descendant, at any depth, for the type check to walk: the label and
  # the `.source.json` of each, from the metadata every group below carries.
  # component_manifest_tree has no barrier of its own, so the walk goes on
  # through all the manifests; component_manifest_tree_walk names only the
  # children's groups, so that it does not wander into their programs and
  # everything the programs depend on.
  generated_file(_tree_target) {
    forward_variables_from(invoker, [ "testonly" ])
    visibility = [ ":$_compile_target" ]
    outputs = [ _tree_json ]
    output_conversion = "json"
    deps = _child_deps
    data_keys = [ "component_manifest_tree" ]
    walk_keys = [ "component_manifest_tree_walk" ]
  }

  action(_compile_target) {
    forward_variables_from(invoker, [ "testonly" ])
    visibility = [ ":$_main_target" ]
    script = "//system/component_manifest.py"
    sources = [
      _children_json,
      _program_json,
      _source_json,
      _tree_json,
    ]
    outputs = [ _output ]
    args = [
      "--source",
      rebase_path(_source_json, root_build_dir),
      "--program",
      rebase_path(_program_json, root_build_dir),
      "--children",
      rebase_path(_children_json, root_build_dir),
      "--tree",
      rebase_path(_tree_json, root_build_dir),
      "--output",
      rebase_path(_output, root_build_dir),
    ]
    if (_type_check) {
      # GN cannot list the descendants' `.source.json` as inputs: their paths
      # come out of the metadata that _tree_target collects, which a variable
      # of this action cannot read. So the compiler lists the files it read,
      # and ninja reruns the action when any of them changes, however deep
      # the descendant is. The action also follows each child's compile
      # through the dependency on its group; that chain is a side effect of
      # how groups are built, and the depfile names the declarations the check
      # actually reads, so the rerun does not rest on it.
      depfile = "$_output.d"
      args += [
        "--depfile",
        rebase_path(depfile, root_build_dir),
      ]
    } else {
      args += [ "--no-type-check" ]
    }
    if (defined(invoker.builtins)) {
      inputs = [ invoker.builtins ]
      args += [
        "--builtins",
        rebase_path(invoker.builtins, root_build_dir),
      ]
    }
    deps = [
      ":$_children_target",
      ":$_program_target",
      ":$_source_target",
      ":$_tree_target",
    ]

    # The file a BootFS takes from this target, as generated_resource()
    # names one (//build/dist/generated_resource.gni). The barrier keeps the
    # walk out of the JSON targets above: the children they reach are this
    # template's group's deps already.
    metadata = {
      distribution_entries = [
        {
          source = rebase_path(_output, root_build_dir)
          destination = _meta_path
          label = get_label_info(":$_compile_target", "label_with_toolchain")
        },
      ]
      distribution_entries_barrier = []
    }
  }

  group(_main_target) {
    forward_variables_from(invoker,
                           [
                             "testonly",
                             "visibility",
                           ])

    # Public, so that a dependant may name the manifest's file as an input:
    # the decoder's test does.
    public_deps = [ ":$_compile_target" ]
    deps = _program_deps + _child_deps

    # What a parent's <name>.children reads: where this manifest lands in the
    # BootFS, keyed by the label the parent names it by. The barrier stops
    # that walk here, so a parent collects its own children and not their
    # children in turn.
    #
    # What an ancestor's <name>.tree reads: this manifest's label and its
    # `.source.json`, rebased to where the compiler runs. The walk it takes
    # does not stop here: it goes on to this manifest's children.
    metadata = {
      component_manifest = [
        {
          label = _label
          path = _meta_path
        },
      ]
      component_manifest_barrier = []
      component_manifest_tree = [
        {
          label = _label
          source = rebase_path(_source_json, root_build_dir)
        },
      ]
      component_manifest_tree_walk = _child_deps
    }
  }
}
