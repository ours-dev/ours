import("//kernel/phys/kernel_elf_binary.gni")

# The BootFS directory user programs install to unless given an install_name
# of their own. init_startup() names programs by the same rule. Defined
# before the template, which sees only what its file had defined by then.
user_program_dir = "bin"

# Defines a program that runs in ring 3 and reaches the kernel through the
# vDSO, packaged as a file in the kernel package's BootFS.
#
# What this template exists to do is make the syscall surface reachable by
# *calling it*. A program written against it declares nothing and binds
# nothing: it calls ours::debug_write(), and the linker records the call as an
# undefined symbol, ours_debug_write. Whoever loads the program (the kernel's
# userabi::launch() or the user-space launcher in //system/lib/launch)
# resolves it against the vDSO's .dynsym with elfload::Binder before it runs.
# Before this, every program carried its own copy of the
# lookup -- an entry-table struct, a magic/version check, and one accessor per
# entry doing `table + offset` arithmetic -- which is a dynamic linker written
# by hand, once per program, for a table the ELF format already describes.
#
# The shape that makes that work, and why each piece:
#
#   * A PIE executable linked against the vDSO, not a static one. -static is
#     what forbids an undefined symbol; it is also what the user toolchain
#     applies to every executable by default, so it is subtracted here.
#   * -fno-plt with -z now: an imported function then reaches the GOT the way
#     an imported variable does, so the loader has one relocation type to
#     apply and never has to service a lazily-bound PLT stub. There is no
#     lazy binding: whoever loads an image binds it once, before it runs.
#   * --no-dynamic-linker: there is none. Whoever starts the process (the
#     kernel's userabi::launch() or the user-space launcher) maps the vDSO
#     and binds the program against it, so a PT_INTERP would name something
#     that does not exist.
#   * The vDSO on the link line, so an import that no vDSO entry defines is a
#     link error here rather than an unresolved symbol discovered at boot.
#
# This mirrors //kernel/phys/physload_module.gni, which is the same
# arrangement one layer down: a phys module leaves the phys runtime undefined
# and physload binds it at load time. Zircon does it with libzircon.so, which
# its programs link against. A dynamically linked program is bound by its
# PT_INTERP dynamic linker, and a static PIE such as userboot binds itself at
# startup with elfldltl (LinkStaticPieWithVdso()).
#
# Parameters:
#
#   install_name (optional)
#     BootFS file name for the packaged program. Defaults to
#     "$user_program_dir/$target_name", "bin/shell" for the shell, as Zircon
#     installs its programs under /boot/bin. It is the name the program is
#     started by: kernel.select.userboot for a build of userboot (which pins
#     it at the top level, where the kernel looks), and userboot.next, init's
#     startup list or a launcher's BootFS lookup for any other program.
#
#   deps, sources, configs, testonly, visibility
#     Standard GN meanings.
template("user_executable") {
  if (defined(invoker.install_name)) {
    _install_name = invoker.install_name
  } else {
    _install_name = "$user_program_dir/$target_name"
  }

  # The install name on its own, for whoever starts this program by name
  # (user_program_names(), //system/user_program_names.gni). A target apart
  # from the program because a starter must not depend on the program:
  #   - the dependency would package it: the BootFS takes every file in its
  #     deps, so the dev image, which carries the shell but not fault_probe,
  #     would get fault_probe through the shell;
  #   - two programs that start each other would be a dependency cycle.
  # This one carries a name and no files, so neither happens.
  #
  # The program's own name is taken out here: inside the group, target_name
  # is the group's.
  _program_name = target_name
  group("$target_name.install_name") {
    forward_variables_from(invoker, [ "testonly" ])
    metadata = {
      user_program_names = [
        {
          name = _program_name
          path = _install_name
          label = get_label_info(":$_program_name", "label_no_toolchain")
        },
      ]
    }
  }

  # The vDSO as a link input: the linker target's own output, not the
  # packaged copy. kernel_elf_image() strips section headers from what goes
  # into the package, and a linker needs them to read .dynsym -- the *loader*
  # does not, since it reaches the same tables through PT_DYNAMIC.
  _vdso_label = "//kernel/lib/userabi/vdso:vdso.binary"
  _vdso_file = get_label_info(_vdso_label, "target_out_dir") + "/vdso"

  kernel_elf_binary(target_name) {
    forward_variables_from(invoker,
                           "*",
                           [
                             "configs",
                             "deps",
                             "install_name",
                             "ldflags",
                             "metadata",
                             "visibility",
                           ])
    forward_variables_from(invoker, [ "visibility" ])
    install_name = _install_name

    if (defined(invoker.metadata)) {
      metadata = invoker.metadata
    }

    # A user program has no kernel text to patch; asking for the section would
    # only add an empty `<name>/code-patches` file to the package. With patches
    # off, kernel_elf_image() installs the ELF as one bare file rather than a
    # `<name>/` subtree, which is what the loader looks up by name.
    has_patches = false

    # Cleared first because GN refuses to replace one non-empty list with
    # another, and kernel_elf_binary()'s own set_defaults() has already put
    # default_executable_configs here.
    configs = []
    configs = invoker.configs
    configs -= [ "//system:user.executable" ]
    configs += [ "//system:user.program" ]

    # //system/public for two things the toolchain's //system:user.headers
    # cannot give: <ours/vdso.hpp> includes a generated file,
    # ours/vdso_decls.inc, and both the include path to it
    # (:vdso_decls.config) and the edge that orders a program's compiles after
    # its generator come only through a dependency. Without this, every
    # program including <ours/vdso.hpp> fails to find the file.
    #
    # //system/lib/libc for mem* and strlen, which the compiler calls on its
    # own -- a zero-initialised array or a struct copy past its inline limit
    # -- and libc++ calls from std::string_view. Here rather than in a
    # toolchain config because a config cannot add a dependency, and rather
    # than in every program's BUILD.gn because no program chooses to need
    # it. The vDSO is not a user_executable and so never gets it: it is the
    # system-call stubs and nothing else, mapped into every process.
    deps = [
      "//system/lib/libc",
      "//system/public",
      _vdso_label,
    ]
    if (defined(invoker.deps)) {
      deps += invoker.deps
    }

    inputs = [ _vdso_file ]
    ldflags = [ rebase_path(_vdso_file, root_build_dir) ]
    if (defined(invoker.ldflags)) {
      ldflags += invoker.ldflags
    }
  }
}

set_defaults("user_executable") {
  configs = default_executable_configs
}
