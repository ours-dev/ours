import("//build/cpp/cpp_interface.gni")
import("//build/toolchain/toolchain_environment.gni")
import("//system/user_executable.gni")

assert(toolchain_environment == "user",
       "init must be built in a //build/toolchain/ours:user-* toolchain")

# How an `ours.autorun.boot` value splits into argv
# (include/init/autorun.hpp). A target of its own so that the host test
# reaches it without init; the host toolchain reads "user" for
# toolchain_environment too, so the assert above lets it through.
cpp_interface("autorun") {
  public = [ "include/init/autorun.hpp" ]
  public_deps = [ "//system/public" ]
  visibility = [
    ":*",
    "test:*",
  ]
}

# init: the first system service, the program userboot starts (userboot.next)
# with the root job and the BootFS, and the root of the component tree
# (docs/design/261004/component-framework.md): it serves /boot from the
# BootFS and each component's /svc (boot_server.cpp), resolves meta/root.cm,
# starts its components and routes their /svc (realm.cpp), serves the
# built-in protocols ours.process.Launcher (launcher_server.cpp) and
# ours.resource.Debug, .Irq and .Ioport (resource_server.cpp), and waits for
# all of it on one Loop. Since step 15 of the plan it starts nothing itself
# but its components and the autorun program; the shell is one of the
# components.
#
# Not in the host toolchain, which reaches this file only for :autorun's
# test: GN defines every target of a file it loads, and a user program does
# not configure there (//system/lib/ort draws the same line).
if (!is_host_toolchain) {
  import("//system/user_program_names.gni")

  # The header programs.hpp. init starts no program by name: its components
  # come from their manifests, and the autorun program from the command
  # line. What it reads from the header is DIRECTORY, where programs install
  # and which /boot makes executable (boot_server.cpp). The template wants at
  # least one program, so the list names init itself, which costs nothing:
  # it reads the name target alone, not the program.
  user_program_names("programs") {
    visibility = [ ":*" ]
    programs = [ ":init" ]
  }

  user_executable("init") {
    visibility = [ "//kernel/products/image/*" ]
    sources = [
      "boot_server.cpp",
      "boot_server.hpp",
      "environment.hpp",
      "init.cpp",
      "launcher_server.cpp",
      "launcher_server.hpp",
      "pools.hpp",
      "realm.cpp",
      "realm.hpp",
      "resource_server.cpp",
      "resource_server.hpp",
    ]
    deps = [
      ":autorun",
      ":programs",
      "//system/lib/bootfs:headers",
      "//system/lib/component",
      "//system/lib/ours.io",
      "//system/lib/ours.resource",
      "//system/lib/ours.process",
      "//system/lib/launch",
      "//system/lib/launch:process_launcher",
      "//system/lib/loop",
      "//system/lib/ioservice:loop_server",
      "//system/lib/wire",
    ]
  }
}
