import("//build/toolchain/toolchain_environment.gni")
import("//system/component_manifest.gni")
import("//system/user_executable.gni")

# Read only in a user toolchain: dev's root.cm names the manifest below, and
# component_manifest() moves its children and their programs there.
assert(
    toolchain_environment == "user",
    "routing_checks must be built in a //build/toolchain/ours:user-* toolchain")

# The root's on-target test component (component-framework design D24):
# what its namespace gives it through fsio, checked from inside
# (routing_checks.cpp).
user_executable("routing_checks") {
  visibility = [ ":*" ]
  sources = [ "routing_checks.cpp" ]
  deps = [
    "//examples/echo/protocol",
    "//system/lib/fsio",
    "//system/lib/ours.acpi:client",
    "//system/lib/ours.block",
    "//system/lib/ours.block:client",
    "//system/lib/ours.fshost",
    "//system/lib/ours.gpt",
    "//system/lib/ours.io",
    "//system/lib/ours.resource:client",
    "//system/lib/ours.process",
    "//system/lib/wire",
  ]
}

# Five uses of directories, which dev's root.cm offers in the matching ways
# (kernel/products/image/dev/BUILD.gn):
#   /boot    rx*, offered as is;
#   /boot-r  r*, offered under another name with `as`;
#   /bin     rx*, the bin subdirectory, joined from this use's subdir;
#   /denied  rx*, through an offer of only r*, so the route answers
#            AccessDenied at the root's offer and the entry arrives closed;
#   /vfs     rx*, fshost's `ro` view of its tree -- the `boot` mount, and
#            not the writable `tmp`, which the shell's `all` view holds: a
#            read through it walks two servers, and the listing asserts the
#            view really hides tmp.
# Eight uses of directories that the sibling files (//examples/files)
# provides, each offered from it by root.cm, and the first provider a
# directory route ends at:
#   /files         r*, the tree files serves at its declared /export/docs;
#   /files-sub     r*, through files' expose of docs with the subdir `sub`:
#                  only nested.txt is there;
#   /files-denied  rx*, through an offer that asks more than files' expose
#                  states (r*): AccessDenied at files' expose, and the entry
#                  arrives closed;
#   /files-wide    rx*, through files' expose of docs-wide, which states rx*
#                  over a declaration of r*: AccessDenied at files'
#                  declaration, and the entry arrives closed;
#   /ghost         r*, a directory files declares and exposes and its program
#                  does not serve: files' server answers NotFound;
#   /files-file    r*, through an offer of docs with the subdir hello.txt: the
#                  Open asks for a directory and the path ends at a file, so
#                  files' server answers NotDir.
# And eleven protocol uses, each at /svc/<name>:
#   ours.process.Launcher, ours.resource.Debug, ours.resource.Sampling,
#   ours.resource.Irq, ours.resource.Ioport, ours.resource.Mmio,
#   ours.resource.Iommu and ours.boot.Acpi, the root's built-ins, which
#   root.cm offers from its parent: Irq and Ioport only to this component and
#   to pc-ps2, the keyboard driver, which takes its line and ports with them
#   as this one does, Mmio and Iommu to this component alone, and the ACPI
#   tables, ours.boot.Acpi, to this component and to the route service;
#   ours.acpi.Route, which root.cm offers from the sibling acpi-route, the
#   route service (//system/service/acpi-route), that this component asks
#   about every ISA number and the ECAM window;
#   ours.test.Unoffered, which nobody offers, so its Open answers NotFound
#   at the root's offer;
#   ours.test.Echo, which root.cm offers from its sibling echo
#   (//examples/echo), renamed from ours.examples.echo.Echo, so its Open is
#   forwarded into echo's outgoing directory. The rename changes the name and
#   not the protocol, so this use says which protocol it speaks: its `type`.
component_manifest("routing_checks.cm") {
  visibility = [ "//kernel/products/image/*" ]
  program = ":routing_checks"
  manifest = {
    use = [
      {
        directory = "boot"
        path = "/boot"
        rights = [ "rx*" ]
      },
      {
        directory = "boot-r"
        path = "/boot-r"
        rights = [ "r*" ]
      },
      {
        directory = "boot"
        path = "/bin"
        rights = [ "rx*" ]
        subdir = "bin"
      },
      {
        directory = "denied"
        path = "/denied"
        rights = [ "rx*" ]
      },
      {
        directory = "vfs"
        path = "/vfs"
        rights = [ "rx*" ]
      },
      {
        directory = "disk"
        path = "/disk"
        rights = [ "rw*" ]
      },
      {
        directory = "files"
        path = "/files"
        rights = [ "r*" ]
      },
      {
        directory = "files-sub"
        path = "/files-sub"
        rights = [ "r*" ]
      },
      {
        directory = "files-denied"
        path = "/files-denied"
        rights = [ "rx*" ]
      },
      {
        directory = "files-wide"
        path = "/files-wide"
        rights = [ "rx*" ]
      },
      {
        directory = "ghost"
        path = "/ghost"
        rights = [ "r*" ]
      },
      {
        directory = "files-file"
        path = "/files-file"
        rights = [ "r*" ]
      },
      {
        protocol = [
          "ours.process.Launcher",
          "ours.resource.Debug",
          "ours.resource.Sampling",
          "ours.resource.Irq",
          "ours.resource.Ioport",
          "ours.resource.Mmio",
          "ours.resource.Iommu",
          "ours.boot.Acpi",
          "ours.acpi.Route",
          "ours.test.Unoffered",
        ]
      },
      {
        protocol = "ours.test.Echo"
        type = "ours.examples.echo.Echo"
      },
      {
        protocol = "ours.block.Block"
      },
      {
        protocol = "ours.fshost.Admin"
      },
      {
        directory = "vfs-all"
        path = "/vfs-all"
        rights = [
          "rx*",
          "w*",
        ]
      },
    ]
  }
}
