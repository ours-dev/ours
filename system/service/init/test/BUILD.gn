# Host-side tests. These link googletest and run on the build machine: how
# an `ours.autorun.boot` value splits into argv is string handling alone, so
# it is checked here rather than by booting an image with each spelling.
executable("autorun") {
  testonly = true
  sources = [ "autorun_test.cpp" ]
  deps = [
    "//system/service/init:autorun",
    "//vendor/googletest:gtest",
    "//vendor/googletest:gtest_main",
  ]
}

# The startup list's lines -- command and capabilities -- likewise: what init
# makes of config/init/startup, and which lines it refuses.
executable("startup") {
  testonly = true
  sources = [ "startup_test.cpp" ]
  deps = [
    "//system/service/init:startup",
    "//vendor/googletest:gtest",
    "//vendor/googletest:gtest_main",
  ]
}
