# The capabilities an init_startup() entry may ask for. Each names one startup
# handle init hands the program in its processargs:
#
#   init    User0: a channel whose other end init keeps and speaks its
#           liveness check on (init sends, the program answers).
#   bootfs  VmoBootfs: the BootFS VMO, duplicated from init's.
#   job     JobDefault: a job to start programs under. For now a duplicate of
#           init's own job -- the root job -- because user space cannot yet
#           create a child job; Fuchsia's component_manager gives each
#           component a job of its own, and that is where this should go.
#
# Kept here, beside the template, so that the vocabulary the build accepts and
# the one it documents cannot drift apart. init is the other side of this
# contract and must accept the same words.
init_startup_capabilities = [
  "init",
  "bootfs",
  "job",
]

# init_startup() -- one entry in init's startup list.
#
# Ours' counterpart of a child that a Fuchsia parent manifest starts eagerly
# (`children: [ { name, url, startup: "eager" } ]` in bootstrap.cml), together
# with what that child `use`s. The entry is a GN target, not a line someone
# writes into a file: it carries the line as `init_startup` metadata, and the
# kernel_package() that has `init_startup = true` gathers every such line in
# its deps into `config/init/startup` in the BootFS -- the same way it builds
# the user-visible whitelist. Which services an image starts is therefore the
# image's choice, made by listing entries in its package's deps; the same
# program can be an entry in one image and merely packaged in another.
#
# Each line is `<name>[+<arg>...] [<capability>,...]`: the command in the form
# init already parses for `ours.autorun.boot` (first `+` word is the BootFS
# name and argv[0]), then, after one space, the capabilities it is given.
#
# Parameters:
#
#   program (required)
#     Plain GN label of the user_executable() to start, without a toolchain
#     suffix -- "//examples/shell". The entry depends on it in the user
#     toolchain, so listing an entry also packages its program.
#
#   name (optional, default: the label's target name)
#     BootFS name to start. user_executable() installs a program under its
#     target name unless given install_name, so this only needs saying when
#     that was overridden.
#
#   args (optional, default [])
#     Arguments, after argv[0]. A `+`, space or comma in one would be read as
#     a separator, so those are refused.
#
#   capabilities (optional, default [])
#     Words from init_startup_capabilities.
#
#   testonly, visibility
template("init_startup") {
  assert(defined(invoker.program),
         "init_startup($target_name) requires `program`")
  _program = invoker.program
  assert(
      get_label_info(_program, "toolchain") == current_toolchain,
      "init_startup($target_name): `program` takes a plain label without a toolchain suffix")

  if (defined(invoker.name)) {
    _name = invoker.name
  } else {
    _name = get_label_info(_program, "name")
  }

  _words = [ _name ]
  if (defined(invoker.args)) {
    foreach(arg, invoker.args) {
      assert(string_split(arg, "+") == [ arg ] &&
                 string_split(arg, " ") == [ arg ] &&
                 string_split(arg, ",") == [ arg ],
             "init_startup($target_name): argument '$arg' contains a separator")
      _words += [ arg ]
    }
  }
  _line = string_join("+", _words)

  if (defined(invoker.capabilities) && invoker.capabilities != []) {
    foreach(capability, invoker.capabilities) {
      assert(filter_include(init_startup_capabilities, [ capability ]) != [],
             "init_startup($target_name): unknown capability '$capability'")
    }
    _line += " " + string_join(",", invoker.capabilities)
  }

  group(target_name) {
    forward_variables_from(invoker,
                           [
                             "testonly",
                             "visibility",
                           ])
    deps = [ "$_program(//build/toolchain/ours:user-${target_cpu})" ]
    metadata = {
      init_startup = [ _line ]
    }
  }
}
