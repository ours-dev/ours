import("//build/toolchain/toolchain_environment.gni")
import("//system/component_manifest.gni")
import("//system/user_executable.gni")

# Read only in a user toolchain, as every program under //system/service:
# dev's root.cm names the manifest below, and component_manifest() moves its
# program there.
if (!is_host_toolchain) {
  assert(
      toolchain_environment == "user",
      "device-registry must be built in a //build/toolchain/ours:user-* toolchain")

  # The device tree (the device-namespace round,
  # .agents/tasks/device-namespace/DESIGN.md): one directory where every
  # device answers, whatever driver drives it. The program (device_registry.cpp)
  # serves ours.dev.Registry, the publish protocol a driver puts its devices
  # into the tree with, and exposes the tree itself as the directory `dev`.
  user_executable("device-registry") {
    visibility = [ ":*" ]
    sources = [ "device_registry.cpp" ]
    deps = [
      "//system/lib/ddk",
      "//system/lib/ioservice:outgoing",
      "//system/lib/loop",
      "//system/lib/protocols",
      "//system/lib/server",
      "//system/lib/ustl",
      "//system/lib/wire",
    ]
  }

  # Provides ours.dev.Registry to its parent, and the tree as the directory
  # `dev`, r*: enumeration is its own right (the directory server's
  # readdir), which r* carries beside read. Uses nothing: the tree is this
  # program's own storage until a driver publishes into it.
  component_manifest("device-registry.cm") {
    visibility = [ "//kernel/products/image/*" ]
    program = ":device-registry"
    manifest = {
      use = []
      capabilities = [
        {
          protocol = "ours.dev.Registry"
        },
        {
          directory = "dev"
          path = "/dev"
          rights = [ "r*" ]
        },
      ]
      expose = [
        {
          protocol = "ours.dev.Registry"
          from = "self"
        },
        {
          directory = "dev"
          from = "self"
        },
      ]
    }
  }
}
