import("//build/toolchain/toolchain_environment.gni")
import("//system/component_manifest.gni")
import("//system/user_executable.gni")

# Read only in a user toolchain, as every program under //system/service:
# dev's root.cm names the manifest below, and component_manifest() moves its
# program there.
assert(
    toolchain_environment == "user",
    "system/service/btreefs must be built in a //build/toolchain/ours:user-* toolchain")

# The filesystem the ours-fs partition carries (btreefs design): the B+tree
# of //system/lib/ours.btreefs over the disk's partition, found through
# //system/lib/ours.gpt, reached through ours.block's Client, served as
# ours.io's Directory. It exposes its tree as the directory `disk`, which
# root.cm offers to fshost -- which mounts it at `disk` -- and to
# routing_checks, which exercises create, write and read-back on it.
user_executable("btreefs") {
  visibility = [
    ":*",
    "//kernel/products/image/*",
  ]
  sources = [ "btreefs.cpp" ]
  deps = [
    "//system/lib/fsio",
    "//system/lib/ioservice",
    "//system/lib/loop",
    "//system/lib/protocols:client",
    "//system/lib/ours.btreefs",
    "//system/lib/ours.gpt",
    "//system/lib/wire",
  ]
}

component_manifest("btreefs.cm") {
  visibility = [ "//kernel/products/image/*" ]
  program = ":btreefs"
  manifest = {
    use = [
      {
        protocol = "ours.block.Block"
      },
    ]
    capabilities = [
      {
        directory = "disk"
        path = "/disk"
        rights = [ "rw*" ]
      },
    ]
    expose = [
      {
        directory = "disk"
        from = "self"
      },
    ]
  }
}
