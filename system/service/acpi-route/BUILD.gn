import("//build/cpp/cpp_interface.gni")
import("//build/toolchain/toolchain_environment.gni")
import("//system/component_manifest.gni")
import("//system/user_executable.gni")

# The ACPI route service: the one program that reads the firmware's tables on
# behalf of the rest of user space, so that no driver has to know a GSI or an
# ECAM base. It holds the read-only VMO of the tables (ours.boot.Acpi) and
# nothing else, and answers, from the static tables, which GSI an ISA
# interrupt arrives on and where a PCI segment's configuration space is. The
# questions only AML can answer (a PCI function's interrupt, from _PRT) are
# not asked of it yet. Design: .agents/tasks/driver-manager/DESIGN.md, the
# route service.
#
# The part with no system calls in it, the reader of the tables' directory and
# the two answers, is host-visible, so that the tests reach it. The program that
# serves them is user-only, as every program is: GN defines every target of a
# file it loads, and a user program does not configure in the host toolchain.

cpp_interface("headers") {
  public = [
    "include/acpi_route/routes.hpp",
    "include/acpi_route/table_directory.hpp",
  ]
  public_deps = [
    "//kernel/lib/acpi:header",
    "//system/lib/ustl:headers",
    "//system/public",
  ]
}

source_set("logic") {
  sources = [
    "src/routes.cpp",
    "src/table_directory.cpp",
  ]
  public_deps = [ ":headers" ]
}

# The tests run on the host against real directories: the tables of a
# synthesised machine (the library's own test builder), laid out by the same
# acpi::export_tables() the kernel hands user space, then read back.
executable("acpi-route-test") {
  testonly = true
  sources = [
    "//kernel/lib/acpi/src/table_export.cpp",
    "//kernel/lib/acpi/src/table_set.cpp",
    "test/acpi_route_test.cpp",
  ]
  deps = [ ":logic" ]
}

group("tests") {
  testonly = true
  deps = [ ":acpi-route-test" ]
}

if (!is_host_toolchain) {
  assert(
      toolchain_environment == "user",
      "acpi-route must be built in a //build/toolchain/ours:user-* toolchain")

  # The program (src/acpi_route.cpp): maps the tables, serves ours.acpi.Route
  # from its outgoing directory on a Loop, and exits when it has no tables.
  user_executable("acpi-route") {
    visibility = [ ":*" ]
    sources = [ "src/acpi_route.cpp" ]
    deps = [
      ":logic",
      "//system/lib/ddk",
      "//system/lib/ioservice:outgoing",
      "//system/lib/loop",
      "//system/lib/ours.acpi",
      "//system/lib/ours.resource:client",
      "//system/lib/wire",
    ]
  }

  # Uses one built-in, ours.boot.Acpi, the tables as a read-only VMO, and
  # provides ours.acpi.Route to its parent. It holds no resource: dev's root.cm
  # offers it the tables and nothing else.
  component_manifest("acpi-route.cm") {
    visibility = [ "//kernel/products/image/*" ]
    program = ":acpi-route"
    manifest = {
      use = [
        {
          protocol = [ "ours.boot.Acpi" ]
        },
      ]
      capabilities = [
        {
          protocol = "ours.acpi.Route"
        },
      ]
      expose = [
        {
          protocol = "ours.acpi.Route"
          from = "self"
        },
      ]
    }
  }
}
