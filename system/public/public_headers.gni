# Headers that form the Ours system interface exposed to kernel code and to
# future operating systems built on Ours.  Paths are relative to
# //system/public so the same list can drive both the source interface target
# and the generated sysroot.
ours_public_headers = [
  "ours/assert.hpp",
  "ours/compiler.hpp",
  "ours/macro_abi.hpp",
  "ours/panic.hpp",
  "ours/process_args.hpp",
  "ours/rights.hpp",
  "ours/signals.hpp",
  "ours/status.hpp",
  "ours/syscall.hpp",
  "ours/types.hpp",
  "ours/vdso.hpp",
]
