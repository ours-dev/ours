# Public Ours headers, modeled after Zircon's system/public GN target.
#
# Kernel toolchains consume :public.config through BUILDCONFIG.gn. Future OS
# products can depend on :public to propagate the same include directory.
import("public_headers.gni")

source_set("public") {
  public = ours_public_headers

  # This target indexes and publishes headers only.  Do not attach implicit
  # compile or link inputs from the consuming toolchain's defaults.
  configs = []
  public_configs = [ ":public.config" ]

  # rights.hpp and signals.hpp spell their bitmask operators with
  # USTL_ENABLE_ENUM_BITMASK, which needs only <type_traits> and <utility>.
  # They were always written that way; the ustl include path simply never had
  # to reach a user program until <ours/vdso.hpp> started naming Signals in
  # ours_object_wait_one(). Exported rather than hand-copied, so that the
  # operators on an ABI enum are the same ones the kernel compiles against.
  public_deps = [
    ":vdso_decls",
    "//system/lib/ustl:headers",
  ]
}

config("public.config") {
  visibility = [ "*" ]
  include_dirs = [ "." ]
}

# The system-call ABI, generated from one description (design 4.7).
#
# The outputs do not depend on the toolchain that asks for them, so they are
# produced once, in the default toolchain -- a fixed, always-loaded place --
# and every other toolchain reaches them through :syscalls.private or
# :vdso_decls below. (The default toolchain does compile some host-side tools
# and tests; what matters is only that it is one toolchain, so the action runs
# once rather than once per toolchain that asks.)
import("ours/syscalls.gni")

_syscalls_gen_dir =
    get_label_info(":syscalls.gen($default_toolchain)", "target_gen_dir")

if (current_toolchain == default_toolchain) {
  # The description as JSON: GN parses the .gni, so the generator never has to.
  generated_file("syscalls.json") {
    outputs = [ "$target_gen_dir/syscalls.json" ]
    contents = ours_syscalls
    output_conversion = "json"
    visibility = [ ":syscalls.gen" ]
  }

  action("syscalls.gen") {
    script = "//build/syscall/gen_syscalls.py"
    _description = "$target_gen_dir/syscalls.json"
    _numbers = "$target_gen_dir/private/syscall_abi/numbers.hpp"
    _vdso_stubs = "$target_gen_dir/private/syscall_abi/vdso_stubs.inc"
    _kernel_decls = "$target_gen_dir/private/syscall_abi/kernel_decls.inc"
    _kernel_shims = "$target_gen_dir/private/syscall_abi/kernel_shims.inc"
    _vdso_decls = "$target_gen_dir/public/ours/vdso_decls.inc"
    sources = [ _description ]
    outputs = [
      _numbers,
      _vdso_stubs,
      _kernel_decls,
      _kernel_shims,
      _vdso_decls,
    ]
    args = [
      rebase_path(_description, root_build_dir),
      "--numbers",
      rebase_path(_numbers, root_build_dir),
      "--vdso-stubs",
      rebase_path(_vdso_stubs, root_build_dir),
      "--kernel-decls",
      rebase_path(_kernel_decls, root_build_dir),
      "--kernel-shims",
      rebase_path(_kernel_shims, root_build_dir),
      "--vdso-decls",
      rebase_path(_vdso_decls, root_build_dir),
    ]
    deps = [ ":syscalls.json" ]
    visibility = [
      ":syscalls.private",
      ":vdso_decls",
    ]
  }
}

if (current_toolchain == default_toolchain) {
  # The vDSO's ABI as a text stub: its SONAME and one Func per call. What the
  # linked vDSO actually exports is checked against this
  # (//kernel/lib/userabi/vdso:vdso.abi_check).
  import("//build/toolchain/generated_ifs_file.gni")

  _libours_symbols = []
  foreach(call, ours_syscalls) {
    _libours_symbols += [ "ours_${call.name}" ]
  }

  generated_ifs_file("libours") {
    soname = "libours.so"
    symbols = _libours_symbols
    visibility = [ "//kernel/lib/userabi/vdso:*" ]
  }
}

config("syscalls.private.config") {
  include_dirs = [ "$_syscalls_gen_dir/private" ]
  visibility = [ ":syscalls.private" ]
}

# The half of the generated ABI that is nobody's business but the kernel's and
# the vDSO's: the call numbers, and what is built from them. A program names a
# call by its vDSO symbol and never sees a number (design D8), which is what
# the visibility below is for -- a user program that depended on this would
# be depending on the one thing the vDSO exists to hide. Visibility only
# limits direct dependents, so the two it admits must not pass it on:
# //kernel/lib/syscall:headers is itself private to that library, and the
# vDSO is a leaf.
group("syscalls.private") {
  public_deps = [ ":syscalls.gen($default_toolchain)" ]
  public_configs = [ ":syscalls.private.config" ]
  visibility = [
    "//kernel/lib/syscall/*",
    "//kernel/lib/userabi/vdso/*",
  ]
}

config("vdso_decls.config") {
  include_dirs = [ "$_syscalls_gen_dir/public" ]
  visibility = [ ":vdso_decls" ]
}

# The public half of the generated ABI: the declarations <ours/vdso.hpp>
# includes. Carried by :public, so a target that depends on the public headers
# gets both the include path and the edge that orders its compiles after the
# generator. A target that reaches the headers only through a toolchain config
# -- as every user program does, through //system:user.headers -- has no such
# edge, and user_executable() adds one for it.
group("vdso_decls") {
  public_deps = [ ":syscalls.gen($default_toolchain)" ]
  public_configs = [ ":vdso_decls.config" ]
  visibility = [ ":public" ]
}
