# The system calls, described once.
#

# The system calls, described once -- one file per category under
# ours/syscalls/, this file importing them in the order that
# assigns the call numbers.
#
# Everything that has to agree about a call is generated from the
# concatenated list by //build/abi/gen_syscalls.py: the private
# call numbers the kernel and the vDSO share, the vDSO stubs, the
# extern "C" declarations <ours/vdso.hpp> includes, the kernel's
# typed syscall::<name> declarations (no sys_ prefix) and the
# shims that unpack a register frame into them. GN derives
# libours.ifs, which the vDSO's exports are checked against, from
# the same list. Adding a call is two things by hand: an entry in
# ours/syscalls/<category>.gni, and the body of syscall::<name>()
# in //kernel/lib/syscall/src/<category>.cpp.
#
# The position of an entry is its call number. The numbers are
# private to the kernel and the vDSO -- a program names a call by
# its vDSO symbol, never by a number -- so the category order here
# renumbers them freely; the vDSO's symbols and signatures, the
# only ABI a program sees, do not move.

import("syscalls/bti.gni")
import("syscalls/channel.gni")
import("syscalls/command.gni")
import("syscalls/debug.gni")
import("syscalls/exception.gni")
import("syscalls/handle.gni")
import("syscalls/interrupt.gni")
import("syscalls/ioport.gni")
import("syscalls/object.gni")
import("syscalls/pager.gni")
import("syscalls/port.gni")
import("syscalls/process.gni")
import("syscalls/sampler.gni")
import("syscalls/task.gni")
import("syscalls/time.gni")
import("syscalls/vma.gni")
import("syscalls/vmo.gni")

ours_syscalls =
    ours_syscalls_debug + ours_syscalls_command + ours_syscalls_handle +
    ours_syscalls_channel + ours_syscalls_object + ours_syscalls_port +
    ours_syscalls_process + ours_syscalls_task + ours_syscalls_vmo +
    ours_syscalls_vma + ours_syscalls_exception + ours_syscalls_interrupt +
    ours_syscalls_sampler + ours_syscalls_ioport + ours_syscalls_pager +
    ours_syscalls_bti + ours_syscalls_time

# The categories in number order, for the build steps that lay outputs out
# from the list: system/public/BUILD.gn's action declares one generated
# declaration file per category.
ours_syscall_categories = [
  "debug",
  "command",
  "handle",
  "channel",
  "object",
  "port",
  "process",
  "task",
  "vmo",
  "vma",
  "exception",
  "interrupt",
  "sampler",
  "ioport",
  "pager",
  "bti",
  "time",
]
