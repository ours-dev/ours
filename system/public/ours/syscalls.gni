# The system calls, described once.
#
# Everything that has to agree about a call is generated from this list by
# //build/abi/gen_syscalls.py: the private call numbers the kernel and the
# vDSO share, the vDSO stubs, the extern "C" declarations a program calls, the
# kernel's typed sys_* declarations and the shims that unpack a register frame
# into them. Before this file each of those was written by hand, in four
# places, kept in step by nothing but care; a handler whose definition drifts
# from the entry here now fails to link (design 4.7).
#
# Adding a call is three things by hand: an entry here, the body of
# sys_<name>() in //kernel/lib/syscall, and its ou:: wrapper.
#
# The position of an entry is its call number. The numbers are private to the
# kernel and the vDSO -- a program names a call by its vDSO symbol, never by a
# number -- so reordering is allowed, but it changes both sides at once and
# nothing else, which is exactly what a private number is for.
#
# Each entry:
#
#   name    The call, without the ours_ prefix. The vDSO exports ours_<name>,
#           the kernel defines sys_<name>.
#   brief   One line.
#   doc     More lines, as a list of strings. Written for the program that
#           calls it; what the kernel does inside belongs with sys_<name>.
#   args    In order, at most 8, and not exactly 7 (the vDSO has no 7-argument
#           stub yet; the first call to need one is vmar_map, design P1-C).
#           Each is a scope:
#             name     The parameter's name.
#             type     A primitive (u8 .. u64, i8 .. i64, usize, char, void) or
#                      a type in namespace ours.
#             dir      Only on a pointer, and what makes it one: "in" (the
#                      kernel reads through it) or "out" (it writes).
#             count    Only on a pointer: the name of the argument that holds
#                      its length in elements. Without one the pointer names
#                      exactly one element.
#             release  Only on a HandleValue passed by value or as an input
#                      array: true when the call consumes the handle (every
#                      handle in the array) whatever its outcome.
#   attrs   Any of "blocking" (may wait), "noreturn" (never comes back; the
#           stub ends in ud2), "debug" (a debug facility with no counterpart
#           in a finished system).
#   ret     The return type. "Status" unless the call returns a plain value.

ours_syscalls = [
  {
    name = "debug_write"
    brief = "Writes |length| bytes of |buffer| to the kernel's debug console."
    doc = [
      "A debug facility, not a console: it exists so a program can prove it",
      "reached ring 3 and got back. One call takes at most MAX_DEBUG_WRITE",
      "bytes (<ours/syscall.hpp>) and answers OutOfRange past it rather than",
      "truncating, so that a program cannot hold a CPU in the kernel for as",
      "long as it likes by asking for a gigabyte of output.",
    ]
    args = [
      {
        name = "buffer"
        type = "char"
        dir = "in"
        count = "length"
      },
      {
        name = "length"
        type = "usize"
      },
    ]
    attrs = [ "debug" ]
    ret = "Status"
  },
  {
    name = "command_list"
    brief = "Writes the kshell command registry into |buffer| as text."
    doc = [
      "One command per line, always NUL terminated. NoSpace when the registry",
      "does not fit; what did fit is still terminated, so a caller can show",
      "it and ask again with more room.",
    ]
    args = [
      {
        name = "buffer"
        type = "char"
        dir = "out"
        count = "length"
      },
      {
        name = "length"
        type = "usize"
      },
    ]
    attrs = [ "debug" ]
    ret = "Status"
  },
  {
