# The sampling-profiler calls. One file per category; the
# import order in ../syscalls.gni, not this file, assigns the
# call numbers. Each entry names its category, which
# //build/abi/gen_syscalls.py uses to group the per-category
# declaration headers it emits. The calls' handlers live in
# //kernel/lib/syscall/src/sampler.cpp.
ours_syscalls_sampler = [
  {
    name = "sampler_create"
    brief = "Makes a sampling profiler session and writes a handle to it into |out|."
    doc = [
      "A session samples every online CPU every |config|'s period once",
      "started, recording into per-CPU buffers of |config|'s buffer size;",
      "see SamplerConfig. There is one session at a time: AlreadyExists while",
      "another exists, until its last handle is closed, and while another",
      "sampler_create is still building one. |resource| must name",
      "a System resource covering the SAMPLING slot (BadHandle, BadType,",
      "OutOfRange). |options| must be 0, |config|'s reserved field 0, its",
      "targets at least one known target, its period from",
      "SAMPLER_MIN_PERIOD to SAMPLER_MAX_PERIOD and its buffer size from one",
      "record to SAMPLER_MAX_BUFFER_SIZE (InvArgs). The handle has Transfer,",
      "Duplicate, Inspect, Read and Write: sampler_start and sampler_stop ask",
      "for Write, sampler_read for Read. Closing its last handle stops the",
      "session and ends it.",
    ]
    args = [
      {
        name = "resource"
        type = "Uandle"
      },
      {
        name = "options"
        type = "u64"
      },
      {
        name = "config"
        type = "SamplerConfig"
        dir = "in"
      },
      {
        name = "out"
        type = "Uandle"
        dir = "out"
      },
    ]
    attrs = []
    ret = "Status"
    category = "sampler"
  },
  {
    name = "sampler_start"
    brief = "Starts the session |handle| names sampling."
    doc = [
      "Empties its buffers and arms every online CPU's sampling timer before",
      "it returns. BadState while the session runs, or while a",
      "sampler_read on it is copying. |handle| must name a sampler",
      "(BadType) with Write (AccessDenied).",
    ]
    args = [
      {
        name = "handle"
        type = "Uandle"
      },
    ]
    attrs = []
    ret = "Status"
    category = "sampler"
  },
  {
    name = "sampler_stop"
    brief = "Stops the session |handle| names."
    doc = [
      "When it returns no CPU is recording into the session any more, and",
      "its samples can be read. BadState unless the session runs. |handle|",
      "must name a sampler (BadType) with Write (AccessDenied).",
    ]
    args = [
      {
        name = "handle"
        type = "Uandle"
      },
    ]
    attrs = []
    ret = "Status"
    category = "sampler"
  },
  {
    name = "sampler_read"
    brief = "Copies the stopped session's samples into |data| and writes how many bytes into |actual|."
    doc = [
      "The bytes are a SamplerDumpHeader, then every CPU's retained",
      "SamplerRecords in CPU order (<ours/sampler.hpp>). With |data| null,",
      "|actual| gets the size they need; with",
      "|data_size| less than that, BufferTooSmall, and |actual| gets the",
      "size. A copy that faults stops there and answers the fault's status,",
      "with |actual| at the bytes copied before it, if any were. BadState",
      "while the session runs. |handle| must name a sampler (BadType) with",
      "Read (AccessDenied).",
    ]
    args = [
      {
        name = "handle"
        type = "Uandle"
      },
      {
        name = "data"
        type = "void"
        dir = "out"
        count = "data_size"
      },
      {
        name = "data_size"
        type = "usize"
      },
      {
        name = "actual"
        type = "usize"
        dir = "out"
      },
    ]
    attrs = []
    ret = "Status"
    category = "sampler"
  },
]
