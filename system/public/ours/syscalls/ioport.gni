# The I/O port calls. One file per category; the
# import order in ../syscalls.gni, not this file, assigns the
# call numbers. Each entry names its category, which
# //build/abi/gen_syscalls.py uses to group the per-category
# declaration headers it emits. The calls' handlers live in
# //kernel/lib/syscall/src/ioport.cpp.
ours_syscalls_ioport = [
  {
    name = "ioports_request"
    brief = "Lets the calling process's threads use the I/O ports [|io_addr|, |io_addr| + |len|)."
    doc = [
      "From ring 3, with in and out. Once this returns, an access to one of",
      "them reaches the device on every CPU the process's threads run on,",
      "without entering the kernel; in any other process, and in this one",
      "before the call, it raises a general-protection fault, which kills",
      "the process unless its exception handler takes it. |resource| must",
      "be an I/O port resource covering the range: BadHandle, BadType for",
      "another object or another kind of resource, OutOfRange for a port",
      "past its range (the root covers all 65536), and AccessDenied for a",
      "port the kernel drives itself, which no resource grants. The handle",
      "needs no right. Ports already open stay open; a |len| of 0 opens",
      "nothing, after the same checks. OutOfMem when the ports cannot be",
      "recorded.",
    ]
    args = [
      {
        name = "resource"
        type = "Uandle"
      },
      {
        name = "io_addr"
        type = "u16"
      },
      {
        name = "len"
        type = "u32"
      },
    ]
    attrs = []
    ret = "Status"
    category = "ioport"
  },
  {
    name = "ioports_release"
    brief = "Refuses the I/O ports [|io_addr|, |io_addr| + |len|) to the calling process's threads again."
    doc = [
      "Once this returns, an in or out on one of them raises a",
      "general-protection fault on every CPU the process's threads run on.",
      "|resource| is checked as ioports_request checks it, with the same",
      "answers. Ports that are not open stay closed; a |len| of 0 closes",
      "nothing, after the checks. OutOfMem when the kernel cannot set aside",
      "the one record a release may need, which it does before every release",
      "of a port or more, whether or not this one splits an open range in",
      "two; a release that answers OutOfMem has closed nothing.",
    ]
    args = [
      {
        name = "resource"
        type = "Uandle"
      },
      {
        name = "io_addr"
        type = "u16"
      },
      {
        name = "len"
        type = "u32"
      },
    ]
    attrs = []
    ret = "Status"
    category = "ioport"
  },
]
