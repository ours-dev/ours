# C++-free smoke test for the three-layer distribution manifest system
# (//build/dist).  This target exists so the pipeline can be validated on
# machines where kernel C++ sources do not compile (and without touching any
# C++ code):
#
#   gn gen out/smoke --args='target_cpu="x86"'
#   ninja -C out/smoke //tests/dist-smoke:good
#   cat out/smoke/gen/tests/dist-smoke/good.fini
#
# The :good target must produce a .fini listing both files; :collision must
# FAIL at build time with a "Conflicting distribution entries" error.

import("//build/dist/fini_manifest.gni")
import("//build/obi/resource.gni")

# Two distinct destinations, no conflict.
resource("good_res") {
  sources = [ "hello.txt" ]
  outputs = [ "data/hello.txt" ]
}

resource("good_res2") {
  sources = [ "world.txt" ]
  outputs = [ "data/world.txt" ]
}

fini_manifest("good") {
  deps = [
    ":good_res",
    ":good_res2",
  ]
}

# Both claim the same destination with different sources -> the expand step
# must report a conflict and fail the build.
resource("collision_a") {
  sources = [ "hello.txt" ]
  outputs = [ "data/same.txt" ]
}

resource("collision_b") {
  sources = [ "world.txt" ]
  outputs = [ "data/same.txt" ]
}

fini_manifest("collision") {
  deps = [
    ":collision_a",
    ":collision_b",
  ]
}

# renamed_binary smoke: install hello.txt under a different destination and
# drop the original (keep_original unset).
import("//build/dist/renamed_binary.gni")
group("renamed_source") {
  metadata = {
    distribution_entries = []
    distribution_entries_barrier = []

    distribution_entries += [
      {
        source = rebase_path("hello.txt", root_build_dir)
        destination = "bin/original"
        label = get_label_info(":$target_name", "label_with_toolchain")
      },
    ]
  }
}

renamed_binary("renamed") {
  source = rebase_path("hello.txt", root_build_dir)
  source_deps = [ ":renamed_source" ]
  dest = "bin/renamed"
}

fini_manifest("with_rename") {
  deps = [
    ":renamed",
    ":renamed_source",
  ]
}

# Full build/obi -> kernel/lib/obi wiring smoke: obi_input() emits the
# obit .rsp arguments, obi() generates the rsp and runs pack_action.py
# which invokes `obit pack`.  Produces a real, validate-able .obi from
# the three-layer distribution pipeline output.
import("//build/obi/obi.gni")
import("//build/obi/obi_input.gni")
obi_input("input_block") {
  # obi_input collects distribution entries from its OWN deps (the producers),
  # not from a fini_manifest target (fini_manifest() is created internally).
  deps = [
    ":good_res",
    ":good_res2",
  ]
}

obi("obi_smoke") {
  output_name = "dist-smoke"
  deps = [ ":input_block" ]
}

# Nested-container smoke: an obi() containing another obi() directly
# (the inner one self-registers as --type=container via its obi_input_args
# metadata).  Also exercises compressed =
# true (bool) -> --compressed=lz4.
obi("inner_obi") {
  output_name = "inner"
  deps = [ ":input_block" ]
}

# NOTE: an obi() target can be a DIRECT dep of another obi() — the inner
# one self-registers as --type=container through its obi_input_args metadata
# (walked from the pack action via public_deps), so no explicit
# obi_input(container=...) is needed.  An obi_input() whose deps point at an
# obi() would be wrong: obi() emits no distribution_entries.
obi("outer_obi") {
  output_name = "outer"
  compressed = true
  deps = [ ":inner_obi" ]
}
