# Root build entry for the Ours kernel.
#
# Products are defined under //products/.  The selected product (ours_product
# build arg, default "bringup") is built by the default target:
#
#   tools/set.py bringup.x86          # writes args.gn + runs gn gen
#   ninja -C out/bringup.x86 //products/bringup:bringup
#   → out/bringup.x86/kernel.dev.obi
#     out/bringup.x86/kernel.dev.dbg_1.obi
#     out/bringup.x86/product_info.json

group("default") {
  testonly = true
  deps = [
    # The selected product (ours_product build arg, default "bringup").
    "//products/$ours_product",

    # C++-free smoke of the three-layer distribution pipeline; keeps the
    # fini_manifest() path exercised on every default build.  The
    # intentionally-failing :collision target stays out of this graph.
    "//tests/dist-smoke:good",
    "//tests/dist-smoke:obi_smoke",
    "//tests/dist-smoke:with_rename",
    "//tests/hermetic-smoke:extract_ifs",
    "//tests/hermetic-smoke:hermetic",

    # C++-free smoke of the product() assembly engine; exercises the
    # product-level cmdline/bootfs injection + product_info.json that the
    # bringup product itself leaves empty.
    "//tests/product-smoke:product_smoke",

    # The phys boot chain assembled around a stand-in kernel.  vmours does
    # not build yet, so this is what keeps physload, the physboot module and
    # the packaging path exercised end to end on every default build; see
    # //kernel/tests/fake-kernel/README.md.
    "//kernel/products/image/fake",

    # The x86 GRUB-facing artifact: parses Multiboot2, loads physload out of
    # the OBI container above as a separate image, and jumps to it.  Not
    # itself an OBI item -- the "GRUB two-file flow" pairs this binary with
    # a .obi handed to GRUB as a Multiboot2 module.
    #
    # Explicit toolchain suffix: phys_executable() targets only exist in the
    # kernel.phys toolchain family (see //build/switch/phys_switchset.gni)
    # and carry no default-toolchain redirect of their own -- every caller
    # outside that family names the toolchain itself, the same way
    # //kernel/products/image/dev already does for vmours.
    "//kernel/arch/x86/phys/bootshim:bootshim(//build/switch/set/phys.dbg_0:kernel.phys_$current_cpu.phys.dbg_0)",

    # Rust-free-optional smoke of the rustc toolchain wiring (rust_bin tool
    # of the host toolchain); keeps the Rust contract exercised on every
    # default build.
    "//build/rust:rust-toolchain-smoke-test($host_toolchain)",

    # Host-toolchain smoke of the C++ side (see
    # //build/toolchain/host-smoke-test/BUILD.gn — deliberately not in
    # //build/toolchain/ours, which defines toolchain() instances);
    # explicit ($host_toolchain) because the default toolchain carries
    # target identity.
    "//build/toolchain/host-smoke-test:host-toolchain-smoke-test($host_toolchain)",

    # Logic-only unit tests for //kernel/lib/arch.
    # These exercise pure bit-layout code (no inline asm) and are written
    # as plain hosted `int main()` + <cassert> programs, so they belong on
    # the host toolchain like the smoke tests above — the default toolchain
    # is a bare switchset mount point with no prelude/libc++ wiring of its
    # own (see //kernel/products:headers vs. the per-toolchain overrides in
    # //build/toolchain/ours/BUILD.gn).
    "//kernel/lib/arch:cpu-mask-smoke($host_toolchain)",
    "//kernel/lib/arch:x86-feature-smoke($host_toolchain)",
    "//kernel/lib/arch:x86-paging-smoke($host_toolchain)",
    "//kernel/lib/arch:x86-system-smoke($host_toolchain)",
    "//system/lib/logz4:logz4-test($host_toolchain)",

    # Every //system/lib/ustl test, through ustl's own group rather than a
    # line per test. This list used to name them one by one and reached only
    # five; the rest, most of the intrusive containers' tests among them, were
    # compiled by nothing, so a header change could break them unseen. Plain
    # hosted main()s, hence the host toolchain as for the tests above.
    "//system/lib/ustl:tests($host_toolchain)",

    # //system/lib/concurrent's chain lock. Its arbitration rule is a pure
    # decision over two token values and its state is one std::atomic, so the
    # whole protocol runs on the host; the concurrent half it cannot reach is
    # covered by the TLA+ model named in the header.
    "//system/lib/concurrent:chain-lock-test($host_toolchain)",

    # gktl::DeferredAction's run-at-most-once contract; see the target.
    "//kernel/lib/gktl:tests($host_toolchain)",

    # //kernel/mm's pure-bookkeeping smoke tests: plain hosted main()s over
    # the mm sources they exercise (the buddy allocator, the protection-range
    # tracker). The group sat unwired for a while -- frame-buddy-smoke was
    # never built by anything -- so both are named here explicitly.
    "//kernel/mm/tests:frame-buddy-smoke($host_toolchain)",
    "//kernel/mm/tests:protection-ranges-smoke($host_toolchain)",

    # //kernel/lib/acpi is pure table decoding behind a single mapper seam, so
    # the whole library runs on the host against synthesised table images.
    # Benchmarks, which report timings rather than passing or failing. Here so
    # that they keep compiling; the numbers are quoted in docs/changes.
    "//benches:benches",

    "//kernel/lib/acpi:tests($host_toolchain)",

    # The OBI container format: the parser, the builder, the CLI and the
    # command-line/memory-config views.  The group qualifies the host
    # toolchain itself -- the labels inside are plain hosted `int main()`
    # programs and the group's own toolchain is not host-capable.
    #
    # //kernel/phys:tests is deliberately not here: reaching it evaluates
    # //kernel/phys/BUILD.gn under the host toolchain, where
    # phys_executable("physload") fails on the missing
    # ours_toolchain.link_output_suffix.  The phys-side tests need their
    # deps decoupled from that file before they can build at all.
    "//kernel/lib/obi:tests",

    # The DWARF CFI unwinder core: pure, allocation-free parsing/evaluation
    # over synthesised .eh_frame byte streams on the host.
    "//kernel/lib/unwind:tests",

    # The sampling profiler's wire format: sizes, offsets and magics the
    # host-side prof-fold tool parses the serial dump against.
    "//kernel/lib/prof:tests",

    # prof-fold turns a serial prof.dump capture into flamegraph.pl folded
    # stacks; it is the host half of the sampling-profiler pipeline.
    "//kernel/lib/prof/cli:prof-fold($host_toolchain)",

    # The bootshim's machine-independent half (memory-map conversion and
    # image placement) and the Multiboot2 parse it reads.  Neither needs a
    # machine, and until they were wired in here neither group was built by
    # anything at all.
    "//kernel/phys/lib/bootshim:tests",
    "//kernel/phys/lib/multiboot:tests",

    # The C library's byte loops -- mem* and strlen, shared by the kernel and
    # user programs -- called by their ours::libc names, so that the host's
    # own functions stay out of the way.
    "//system/lib/libc:tests",

    # processargs, the message a process is started with: the encoder in
    # <ours/process_args.hpp> and //system/lib/ort's decoder, against
    # each other and against Zircon's golden bytes.
    "//system/lib/ort:tests",

    # The BootFS reader, bootfs::View: the page rule it holds every BootFS
    # to, so that a file sliced out of one carries no neighbour's bytes.
    "//system/lib/bootfs:tests",

    # The launcher's planner: how the segments of a program are mapped, decided
    # from numbers alone.
    "//system/lib/launch:tests",

    # The framing every hand-written protocol codec shares, and the codec of
    # the fuchsia.io subset on top of it: each message written, read back and
    # broken on purpose, from bytes alone.
    "//system/lib/wire:tests",
    "//system/lib/fuchsia-io:tests",

    # The compiled component manifest's decoder, against manifests that
    # component_manifest() built from fixture targets in two toolchains.
    "//system/lib/component:tests",

    # init's `ours.autorun.boot` parsing: which argv a value becomes. The
    # test itself is named, not a tests group beside init: that file asserts
    # a user toolchain, which the default one is not and the host one is.
    "//system/service/init/test:autorun($host_toolchain)",

    # init's startup list, config/init/startup: how its lines split into a
    # command and the capabilities it asks for.
    "//system/service/init/test:startup($host_toolchain)",

    # A user program on the runtime's start-up code, built to be linked and
    # inspected rather than run; nothing packages it. The toolchain is named
    # because the program exists only in the user one.
    "//system/lib/ort/test:ort_smoke(//build/toolchain/ours:user-$current_cpu)",

    # The user-copy range check, and CopyAllowed, what a type must be to cross
    # the user/kernel boundary as bytes. CopyAllowed's cases are static_asserts,
    # so building this target is what checks them. It was compiled by nothing
    # until it was named here.
    "//kernel/lib/user_copy/test:user_copy($host_toolchain)",

    # The panic crash record's format: write, read back, and reject a record
    # that is torn, flipped or from another version.
    "//kernel/lib/crashlog/test:crashlog($host_toolchain)",

    # Fixed-point arithmetic, which the scheduler's weighting needs and which
    # the kernel cannot get from floating point. Almost all of its checking is
    # static_assert inside the test translation unit, so building this target
    # is most of what running it proves.
    "//system/lib/ffl:tests",
  ]
}
