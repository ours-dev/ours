# Claude Code state stays local, except the root .claude/skills/ links that
# make .agents/skills visible to it, and .claude/settings.json, whose hooks
# every agent working here needs. settings.local.json stays personal.
**/.claude/*
!/.claude/skills/
!/.claude/settings.json
.reasonix
.zcode
.mypy_cache
__pycache__/
*.pyc

.legacy

out
target

# Git worktrees for parallel work (CLAUDE.md, Repo conventions).
/.worktrees/

# Prebuilt toolchains (clang/gcc/gn/ninja/rust/ccache), fetched from upstream
# releases, not repository content. No trailing slash: in a worktree made by
# scripts/new_worktree.py, prebuilt is a symlink to the project root's, and a
# pattern ending in / matches only a directory.
/prebuilt

# macOS finder metadata
.DS_Store

compile_commands.json
