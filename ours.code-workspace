{
    "folders": [
        {
            "path": ".",
        },
    ],

    // ---- One-key kernel debugging -------------------------------------------
    //
    // Press F5. It builds, boots the image under QEMU halted before the first
    // instruction, attaches lldb, installs whatever breakpoints are set in the
    // editor, and lets the machine go -- so execution stops at the first
    // breakpoint that is hit, including ones in the earliest boot code. That is
    // the reason QEMU is started with -S: by the time a *running* kernel could
    // be attached to, start_kernel is long past.
    //
    // Needs no setup. The debug adapter is the lldb-dap extension
    // (llvm-vs-code-extensions.lldb-dap), which finds the system lldb-dap
    // through xcrun; QEMU, GRUB and clang all come from //prebuilt.
    //
    // These live here rather than in .vscode/ because that is where this
    // project keeps its shared editor configuration -- with the consequence
    // that they apply when VS Code is opened through this file, which is how
    // the workspace is meant to be opened.
    "launch": {
        "version": "0.2.0",
        "configurations": [
            {
                "name": "Kernel: debug (dbg.1, asserts on)",
                "type": "lldb-dap",
                "request": "launch",
                "preLaunchTask": "kernel: qemu debug (dbg.1)",
                "postDebugTask": "kernel: stop qemu",
                // A custom launch: there is no local process to start, so the
                // target is created by hand and "running" it means connecting
                // to QEMU's gdbstub.
                "targetCreateCommands": [
                    "target create ${workspaceFolder}/out/bringup.x86/kernel_x86.dbg.1/obj/kernel/products/bin/vmours"
                ],
                "processCreateCommands": [
                    // The kernel links at 0 and physboot loads it at
                    // KERNEL_LOAD_BASE, so the symbols have to be slid to where
                    // the image actually is or every address is off by 64 GiB.
                    // The constant is ARCH_PHYSMAP_SIZE + GB(1) above
                    // KERNEL_ASPACE_BASE; it moves if KASLR is ever switched
                    // on, and the boot log's "Reserve area k:head" line is
                    // where to read the real value.
                    "target modules load --file vmours --slide 0xffffff8840000000",
                    "gdb-remote localhost:1234"
                ],
                // False on purpose: stopping here would stop in the UEFI
                // firmware, several seconds of boot before any of this kernel's
                // code runs. Letting it go means the session stops at the first
                // breakpoint that is actually hit.
                "stopOnEntry": false
            },
            {
                "name": "Kernel: debug (dev, asserts off)",
                "type": "lldb-dap",
                "request": "launch",
                "preLaunchTask": "kernel: qemu debug (dev)",
                "postDebugTask": "kernel: stop qemu",
                // The same kernel with KERNEL_DEBUG_LEVEL=0: no DEBUG_ASSERT
                // and no trace/debug logging. Worth its own entry because a bug
                // that asserts in one image goes silent in the other, and the
                // symbols live under a different switchset directory.
                "targetCreateCommands": [
                    "target create ${workspaceFolder}/out/bringup.x86/kernel_x86.dbg.0/obj/kernel/products/bin/vmours"
                ],
                "processCreateCommands": [
                    "target modules load --file vmours --slide 0xffffff8840000000",
                    "gdb-remote localhost:1234"
                ],
                "stopOnEntry": false
            },
            {
                "name": "Kernel: attach to a QEMU I started myself",
                "type": "lldb-dap",
                "request": "launch",
                // No preLaunchTask: for when ./scripts/qemu-debug.sh is already
                // running in a terminal and the session should not restart it.
                "targetCreateCommands": [
                    "target create ${workspaceFolder}/out/bringup.x86/kernel_x86.dbg.1/obj/kernel/products/bin/vmours"
                ],
                "processCreateCommands": [
                    "target modules load --file vmours --slide 0xffffff8840000000",
                    "gdb-remote localhost:1234"
                ],
                "stopOnEntry": false
            }
        ]
    },

    "tasks": {
        "version": "2.0.0",
        "tasks": [
            {
                "label": "kernel: build",
                "type": "shell",
                "command": "prebuilt/ninja/ninja -C out/bringup.x86",
                "options": { "cwd": "${workspaceFolder}" },
                "group": { "kind": "build", "isDefault": true },
                // Clang's diagnostics, so a build error is a click in the
                // Problems panel rather than a line to read in the terminal.
                "problemMatcher": {
                    "owner": "cpp",
                    "fileLocation": [ "relative", "${workspaceFolder}/out/bringup.x86" ],
                    "pattern": {
                        "regexp": "^(.*?):(\\d+):(\\d+):\\s+(warning|error|fatal error):\\s+(.*)$",
                        "file": 1, "line": 2, "column": 3, "severity": 4, "message": 5
                    }
                }
            },
            {
                // Boots the image halted with the gdbstub open, and does not
                // report ready until the port actually accepts a connection --
                // the debugger attaches the instant this task says it is up,
                // and attaching to a port nothing is listening on fails the
                // launch.
                "label": "kernel: qemu debug (dbg.1)",
                "type": "shell",
                "command": "./scripts/qemu-debug.sh",
                "options": { "cwd": "${workspaceFolder}" },
                "dependsOn": "kernel: build",
                "isBackground": true,
                "problemMatcher": {
                    "pattern": {
                        "regexp": "^(__nomatch__)(__nomatch__)(__nomatch__)$",
                        "file": 1, "line": 2, "message": 3
                    },
                    "background": {
                        "activeOnStart": true,
                        "beginsPattern": "^qemu-debug: booting",
                        "endsPattern": "^qemu-debug: gdbstub ready"
                    }
                }
            },
            {
                "label": "kernel: qemu debug (dev)",
                "type": "shell",
                "command": "IMAGE=$PWD/out/bringup.x86/kernel.dev.obi ./scripts/qemu-debug.sh",
                "options": { "cwd": "${workspaceFolder}" },
                "dependsOn": "kernel: build",
                "isBackground": true,
                "problemMatcher": {
                    "pattern": {
                        "regexp": "^(__nomatch__)(__nomatch__)(__nomatch__)$",
                        "file": 1, "line": 2, "message": 3
                    },
                    "background": {
                        "activeOnStart": true,
                        "beginsPattern": "^qemu-debug: booting",
                        "endsPattern": "^qemu-debug: gdbstub ready"
                    }
                }
            },
            {
                // Ending a debug session leaves QEMU behind otherwise, and the
                // next session's stub cannot open a port the old one holds.
                "label": "kernel: stop qemu",
                "type": "shell",
                "command": "pids=$(lsof -ti tcp:1234 || true); [ -z \"$pids\" ] || kill $pids",
                "options": { "cwd": "${workspaceFolder}" },
                "presentation": { "reveal": "never" },
                "problemMatcher": []
            }
        ]
    },

    "settings": {
        "editor.fontFamily": "'Fira Code'",
        "files.exclude": {
            "**/.git": true,
            "**/.venv": true,
            "**/.mypy_cache":true,
            "**/.cache": true,
        },
        "files.associations": {
            "*.compose": "dockercompose",
            "*.tcc": "cpp",
        },
        "clangd.path": "clangd",

        "editor.semanticTokenColorCustomizations": {
          "rules": {
            "variable": { "fontStyle": "underline" },
            "variable.readonly": { "fontStyle": "" },
            "method": { "fontStyle": "underline" },
            "method.readonly": { "fontStyle": "" }
          }
        }
    }
}
