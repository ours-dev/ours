{
    "folders": [
        {
            "path": ".",
        },
    ],

    // ---- One-key kernel debugging -------------------------------------------
    //
    // Press F5, pick which kernel to debug, and that is the whole procedure.
    // It builds, boots the chosen image under QEMU halted before its first
    // instruction, and attaches lldb. The session opens stopped at the reset
    // vector: set breakpoints there and press continue, and even the earliest
    // boot code stops. That is the reason QEMU is started with -S -- by the
    // time a *running* kernel could be attached to, start_kernel is long past.
    //
    // Needs no setup. The debug adapter is the lldb-dap extension
    // (llvm-vs-code-extensions.lldb-dap), which finds the system lldb-dap
    // through xcrun; QEMU, GRUB and clang all come from //prebuilt.
    //
    // "request" is "attach", not "launch", and that is forced rather than
    // stylistic: lldb-dap's launch schema *requires* "program" and runs it as a
    // local process, which is not what a kernel inside QEMU is. Only "attach"
    // offers attachCommands -- commands that run "instead of attaching to a
    // process ID", and are allowed to create the target themselves. That is the
    // hook the three commands below hang on.
    //
    // There is ONE configuration for every kernel rather than one per kernel,
    // and the difference is not tidiness. A per-kernel configuration has to
    // name an image and an ELF in two different places, and they drift: the
    // entry that claimed to debug kernel.dev.obi pointed at `vmours`, while
    // that image carries `vmours.with-tests`. start_kernel sits 0xE000 (56 KiB)
    // apart in the two, so every breakpoint landed in unrelated code -- and
    // dbg.0's `vmours` is not even a build target any more (ninja -t query says
    // unknown), so it was a week-old leftover that would never be rebuilt.
    //
    // Nothing here writes that pairing down any more. kernel_image() emits an
    // <image>.debug.json beside each .obi, and scripts/qemu-debug.sh resolves
    // the three answers below against it, boots the image, and links the
    // matching unstripped ELF to out/.debug/kernel.elf.
    //
    // That path has no product or architecture in it on purpose. It varies --
    // out/<product>.<arch> -- and spelling it here would mean reading the same
    // ${input:} from the launch section as well as the tasks section, which
    // VS Code resolves separately: every prompt would come up twice. One
    // pointer per checkout also matches the situation, there being one gdbstub
    // port and one debugger.
    //
    // The debugger therefore knows nothing about which kernel it is opening,
    // which is the point: symbols that disagree with the running image are not
    // representable.
    "launch": {
        "version": "0.2.0",
        "configurations": [
            {
                "name": "Kernel: debug",
                "type": "lldb-dap",
                "request": "attach",
                "preLaunchTask": "kernel: qemu debug",
                "postDebugTask": "kernel: stop qemu",
                // These three run instead of lldb-dap's own attach: create the
                // target from whatever the boot published, slide it, connect.
                // There is no process to find by pid or by name -- the
                // "process" is a gdbstub on a TCP port.
                "attachCommands": [
                    "target create ${workspaceFolder}/out/.debug/kernel.elf",
                    // The kernel links at 0 and physboot loads it at
                    // KERNEL_LOAD_BASE, so the symbols have to be slid to where
                    // the image actually is or every address is off by 64 GiB.
                    // The constant is ARCH_PHYSMAP_SIZE + GB(1) above
                    // KERNEL_ASPACE_BASE; it moves if KASLR is ever switched
                    // on, and the boot log's "Reserve area k:head" line is
                    // where to read the real value.
                    //
                    // --file matches on the module's basename, and lldb keeps
                    // the name it was given rather than resolving the symlink,
                    // so this stays "kernel.elf" whichever kernel is behind it.
                    "target modules load --file kernel.elf --slide 0xffffff8840000000",
                    "gdb-remote localhost:1234"
                ]
            },
            {
                "name": "Kernel: attach to a QEMU I started myself",
                "type": "lldb-dap",
                "request": "attach",
                // No preLaunchTask: for when ./scripts/qemu-debug.sh is already
                // running in a terminal and the session should not restart it.
                // It published the symlink on its way up, so this needs to know
                // nothing about which kernel that was.
                "attachCommands": [
                    "target create ${workspaceFolder}/out/.debug/kernel.elf",
                    "target modules load --file kernel.elf --slide 0xffffff8840000000",
                    "gdb-remote localhost:1234"
                ]
            }
        ]
    },

    "tasks": {
        "version": "2.0.0",
        "tasks": [
            {
                // Cmd+Shift+B, for the tree as configured. Not on the F5 path
                // -- see the note on "kernel: qemu debug" above.
                "label": "kernel: build",
                "type": "shell",
                "command": "prebuilt/ninja/ninja -C out/bringup.x86",
                "options": { "cwd": "${workspaceFolder}" },
                "group": { "kind": "build", "isDefault": true },
                // Clang's diagnostics, so a build error is a click in the
                // Problems panel rather than a line to read in the terminal.
                "problemMatcher": {
                    "owner": "cpp",
                    "fileLocation": [ "relative", "${workspaceFolder}/out/bringup.x86" ],
                    "pattern": {
                        "regexp": "^(.*?):(\\d+):(\\d+):\\s+(warning|error|fatal error):\\s+(.*)$",
                        "file": 1, "line": 2, "column": 3, "severity": 4, "message": 5
                    }
                }
            },
            {
                // Builds and then boots the chosen image, halted, with the
                // gdbstub open -- and does not report ready until the port
                // actually accepts a connection, because the debugger attaches
                // the instant this task says it is up and attaching to a port
                // nothing is listening on fails the launch.
                //
                // The build is spliced in with && rather than expressed as
                // dependsOn: "kernel: build". A dependsOn task is a separate
                // execution with its own variable-resolution pass, so it would
                // ask for the product and the architecture a second time (the
                // remembered answer is pre-selected, but the prompt still
                // appears), and asking four questions to start one debug
                // session is not one-key. The cost is that a compile error
                // shows up in this terminal instead of the Problems panel;
                // "kernel: build" below still has the clang matcher for
                // Cmd+Shift+B.
                //
                // This is also the only place the kernel is named. The
                // debugger's own configuration has no idea which one it is
                // about to look at, which is the point.
                "label": "kernel: qemu debug",
                "type": "shell",
                "command": "prebuilt/ninja/ninja -C out/${input:product}.${input:arch} && ./scripts/qemu-debug.sh ${input:product} ${input:arch} ${input:switchset}",
                "options": { "cwd": "${workspaceFolder}" },
                "isBackground": true,
                "problemMatcher": {
                    "pattern": {
                        "regexp": "^(__nomatch__)(__nomatch__)(__nomatch__)$",
                        "file": 1, "line": 2, "message": 3
                    },
                    "background": {
                        "activeOnStart": true,
                        "beginsPattern": "^qemu-debug: booting",
                        "endsPattern": "^qemu-debug: gdbstub ready"
                    }
                }
            },
            {
                // Ending a debug session leaves QEMU behind otherwise, and the
                // next session's stub cannot open a port the old one holds.
                "label": "kernel: stop qemu",
                "type": "shell",
                "command": "pids=$(lsof -ti tcp:1234 || true); [ -z \"$pids\" ] || kill $pids",
                "options": { "cwd": "${workspaceFolder}" },
                "presentation": { "reveal": "never" },
                "problemMatcher": []
            }
        ],

        // The three dropdowns F5 puts up, in this order: product, then
        // architecture, then which kernel out of that product.
        //
        // They live in "tasks" rather than "launch" because the task's command
        // is the only thing that references them -- VS Code resolves ${input:}
        // in each section against that section's own inputs, and the two passes
        // do not share answers. An input referenced from BOTH the launch
        // configuration and its preLaunchTask is asked twice, once per pass;
        // routing the whole choice through the script is what keeps it to one
        // prompt each.
        //
        // The order is the order the inputs appear in the command string above,
        // and it is also the order they narrow in: the product decides which
        // images exist, product and architecture together decide which build
        // directory (out/<product>.<arch>, the one tools/set.py writes), and
        // the switchset picks one image out of that product's set.
        //
        // These lists are typed out because VS Code cannot compute a
        // pickString's options -- there is no hook for it short of a
        // third-party extension. They are also the ONLY place any of this is
        // typed out, and they carry names, never paths or pairings: pass a name
        // the build does not have and scripts/qemu-debug.sh answers with the
        // ones it does, so the menu and the build cannot quietly disagree.
        //
        // Labels do not repeat the value: VS Code renders an option as
        // "<label>: <value>". "default" only pre-selects and tags the row;
        // nothing here can skip a prompt.
        "inputs": [
            {
                "id": "product",
                "type": "pickString",
                "description": "Product?",
                "default": "bringup",
                "options": [
                    {
                        "label": "minimal bootable image set",
                        "value": "bringup"
                    }
                ]
            },
            {
                "id": "arch",
                "type": "pickString",
                "description": "Architecture?",
                "default": "x86",
                "options": [
                    {
                        "label": "the one that boots today",
                        "value": "x86"
                    },
                    {
                        // Offered because the toolchain knows it. There is no
                        // out/bringup.arm until someone runs tools/set.py, and
                        // the script says exactly that rather than failing
                        // somewhere further in.
                        "label": "aarch64, not configured yet",
                        "value": "arm"
                    }
                ]
            },
            {
                "id": "switchset",
                "type": "pickString",
                "description": "Which kernel?",
                "default": "dbg.1",
                "options": [
                    {
                        "label": "asserts and trace on",
                        "value": "dbg.1"
                    },
                    {
                        // A bug that asserts in dbg.1 goes silent here, so both
                        // have to be debuggable, not just the noisy one.
                        "label": "asserts compiled out, unit tests linked in",
                        "value": "dbg.0"
                    }
                    // The spelling is the build's: //build/switch/set/<name>.
                    // fake.obi is reachable from the script but not from here --
                    // it belongs to no product, and it does not boot anyway
                    // (docs/repairs/260909/products.md).
                ]
            }
        ]
    },

    "settings": {
        "editor.fontFamily": "'Fira Code'",
        "files.exclude": {
            "**/.git": true,
            "**/.venv": true,
            "**/.mypy_cache":true,
            "**/.cache": true,
        },
        "files.associations": {
            "*.compose": "dockercompose",
            "*.tcc": "cpp",
        },
        "clangd.path": "clangd",

        "editor.semanticTokenColorCustomizations": {
          "rules": {
            "variable": { "fontStyle": "underline" },
            "variable.readonly": { "fontStyle": "" },
            "method": { "fontStyle": "underline" },
            "method.readonly": { "fontStyle": "" }
          }
        }
    }
}
