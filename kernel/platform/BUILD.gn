import("//build/cpp/cpp_interface.gni")
import("//build/ours/cpu.gni")

# Stable platform seam used by the kernel executable. Architecture-specific
# implementations stay behind the local x86/arm/riscv directory names.
if (toolchain_environment == "kernel") {
  # mmio.cpp is the one source every platform shares: the RAM half of the
  # question touches_kernel_physical() answers comes from the boot memory map,
  # which does not depend on the CPU.
  source_set("platform") {
    sources = [ "mmio.cpp" ]
    public_deps = [ ":headers" ]

    # mmio.cpp copies the memory manager's map of RAM
    # (<ours/mm/early_mem.hpp>) from an init hook.
    deps = [
      "//kernel/lib/gktl",
      "//kernel/mm:headers",
      "//system/lib/logz4:headers",
    ]
  }
}

cpp_interface("headers") {
  public = [
    "include/ours/platform/acpi.hpp",
    "include/ours/platform/debug_console.hpp",
    "include/ours/platform/init.hpp",
    "include/ours/platform/interrupt.hpp",
    "include/ours/platform/ioport.hpp",
    "include/ours/platform/isa.hpp",
    "include/ours/platform/mmio.hpp",
    "include/ours/platform/power.hpp",
    "include/ours/platform/timer.hpp",
  ]

  # ours/platform/acpi.hpp includes <acpi/table_set.hpp>, and
  # ours/platform/ioport.hpp <ustl/views/span.hpp>.
  public_deps = [
    "//kernel/lib/acpi:header",
    "//system/lib/ustl:headers",
  ]
}

group("kernel-tests") {
  testonly = true
  deps = [ "//kernel/platform/$ours_cpu:kernel-tests" ]
}
