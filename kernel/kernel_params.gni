import("//build/ours/cpu.gni")

declare_args() {
  # Compatibility names used by the existing Ours GN and source macros.
  # Keeping these as arguments means old command lines still override them;
  # otherwise they inherit the canonical values above.
  mp_max_cpus = 16
  kernel_extra_defines = []

  lockdep_enable = false
  lockdep_metadata_only = false
  lockdep_lock_name_tracing = false

  # Which discipline occupies Discipline::Normal. The two are mutually
  # exclusive: RoundRobin is a deliberately plain stand-in that keeps the rest
  # of the kernel running while it is brought up, and Fair (EEVDF) is the
  # intended one. Only the selected discipline's source is compiled, and
  # Runtime's Normal run queue takes that discipline's queue type, so
  # switching is this argument rather than a hand edit of a source list.
  sched_normal_discipline = "rr"

  sched_hptick = false
  sched_delay_dequeue = false
  sched_extra_invariant_validation = false
  sched_unpark_preempt = true
  sched_nohz = false

  # Whether the dev images boot with `kernel.time.oneshot=true`: each CPU's
  # tick device then runs one-shot, armed for the earliest deadline in that
  # CPU's timer queue, and the tick is a timer in that queue. It is a boot
  # option and not a compile-time switch, so the same kernel serves both; this
  # argument only decides what the images' command lines say. True by
  # default (.agents/tasks/high-res-timers/DESIGN.md); turn it off like any
  # other argument, through args.gn:
  #   tools/set.py bringup.x86 --args time_oneshot=false
  time_oneshot = true

  mm_numa = false
  mm_numa_emulation = false
  mm_allocation_policy = false

  # Selects the memory model. The two are mutually exclusive: exactly one is
  # compiled, and `MemMap` names whichever it is. False keeps the sparse
  # section-table model, which is the default; true builds the virtually-flat
  # one instead.
  mm_vflat_memmap = false

  # Whether a CPU can be taken offline and brought back at run time
  # (task::take_cpu_offline(), .agents/tasks/cpu-hotplug). On, the code an
  # application processor starts through -- its per-CPU hardware set-up and
  # the low-memory trampoline page -- stays after boot, for a CPU that comes
  # back to start through again; off, it is freed with the rest of the init
  # sections, as at boot, and taking a CPU offline answers NotSupported.
  #   tools/set.py bringup.x86 --args cpu_hotplug=false
  cpu_hotplug = true

  # Whether the kernel shell is linked into the kernel at all.
  #
  # kshell reads COM1 in ring 0 and runs whatever GKTL_COMMAND a line names, so
  # anyone who can write to the serial line can run every console command. The
  # boot option `kernel.shell` keeps it from starting; this keeps it from
  # existing, which is the answer for a kernel that must not carry it. False
  # drops //kernel/lib/kshell, //kernel/commands and the architecture's own
  # commands (//kernel/arch/x86/commands) from the link (see
  # //kernel/top/BUILD.gn for what stays and why).
  #
  # True by default so the bring-up images, which are driven over that console,
  # are unchanged. Select it like any other argument here, through args.gn:
  #   tools/set.py bringup.x86 --args kernel_shell_enabled=false
  kernel_shell_enabled = true

  # Whether the kernel is built with no user space at all, for development
  # only: bringing up a new architecture before it has what a user program
  # needs.
  #
  # True drops //kernel/lib/syscall (the system calls and their dispatch
  # table) and //kernel/lib/userabi (the kernel's half of starting userboot,
  # with the ELF loaders only it uses) from the kernel, and defines
  # KERNEL_NO_USERABI, under which the boot ends where userboot would start,
  # the crash record a boot recovers is reported but handed to no one, and
  # x86's system-call entry calls a panic where the dispatcher was. The kernel
  # objects (//kernel/object) and the user copies stay: they are what a later
  # system call is built on, and nothing in them needs a user program to
  # exist. The images still package userboot and the rest of user space; such
  # a kernel never starts them.
  #
  # True by default on riscv, whose user-side half (the vDSO, the system-call
  # entry, the ELF loader's relocations) is not written yet, so the rest of
  # the kernel can be ported and booted first; false everywhere else. Select
  # it like any other argument here:
  #   tools/set.py bringup.x86 --args kernel_no_userabi=true
  kernel_no_userabi = ours_cpu == "riscv"
}
