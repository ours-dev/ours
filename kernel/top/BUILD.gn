import("//build/ours/cpu.gni")
import("//build/toolchain/toolchain_environment.gni")
import("//kernel/kernel_params.gni")

source_set("top") {
  sources = [
    "boot_options.cpp",
    "crash_record.cpp",
    "handoff.cpp",
    "main.cpp",
    "panic.cpp",
  ]
  deps = [
    "//kernel/arch/$ours_cpu/kernel",
    "//kernel/kernel",
    "//kernel/lib/acpi:header",
    "//kernel/lib/ccrt",
    "//kernel/lib/crashlog",
    "//kernel/lib/gktl",
    "//kernel/lib/logz4",
  ]

  # User space: the system calls and the kernel's half of starting userboot.
  # Without them (kernel_no_userabi, //kernel/kernel_params.gni) the boot ends
  # where userboot would start; main.cpp and crash_record.cpp compile their
  # two calls into userabi out under KERNEL_NO_USERABI.
  #
  # Each keeps its place in the list, and so in the link line, which follows
  # the order of deps: with the switch off the kernel links exactly as it did
  # before the switch existed.
  if (!kernel_no_userabi) {
    deps += [ "//kernel/lib/syscall" ]
  }
  deps += [ "//kernel/lib/unwind" ]
  if (!kernel_no_userabi) {
    deps += [ "//kernel/lib/userabi" ]
  }
  deps += [
    "//kernel/mm",
    "//kernel/object",
    "//kernel/phys:handoff",
    "//kernel/platform:headers",
    "//system/lib/logz4",
  ]

  # The console, gated on the dependency edge rather than on an #if inside
  # either library: neither has a line that makes sense without the other, so
  # the whole of each is in or out, and a kernel built without them never
  # compiles them. See kernel_shell_enabled in //kernel/kernel_params.gni.
  #
  # Both go together. kshell is the front end that runs commands; //kernel/
  # commands exists only to put commands on its prompt (its BUILD.gn says so),
  # so without the shell it is callbacks nothing can reach and help strings
  # nothing prints.
  #
  # What deliberately stays is the registry itself. gktl is not the console --
  # it also carries the init hooks and counters every kernel needs -- and a
  # command that belongs to a subsystem's own file (mm's `dump-frame`) keeps its
  # record in .gktl.commands, where syscall::command_list still finds it. That
  # is the right answer rather than a leak: the syscall lists the registry and
  # never runs it, and with the shell gone nothing calls gktl::run_command(), so
  # --gc-sections drops the dispatcher and no command is reachable at all.
  #
  # The benchmarks that run as commands (//benches/kernel:commands) go with them
  # for the same reason.
  if (kernel_shell_enabled) {
    deps += [
      "//benches/kernel:commands",
      "//kernel/commands",
      "//kernel/lib/kshell",
    ]
  }
}
