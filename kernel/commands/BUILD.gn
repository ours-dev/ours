# Console commands.
#
# A file belongs here when it exists only to put something on the kshell
# prompt: the command callbacks, plus whatever state those callbacks need and
# nobody else does. Keeping them out of the subsystems they inspect stops the
# subsystem from depending on gktl's command registry, and stops a kernel
# built without a console from carrying the callbacks and their help strings:
# //kernel/top links this directory only when kernel_shell_enabled
# (//kernel/kernel_params.gni) links the shell.
#
# Commands that are a natural part of a subsystem's own file -- mm's
# `dump-frame`, say -- stay where they are; this directory is for the ones
# that would otherwise need a file of their own.

source_set("commands") {
  sources = [
    "bti_stress_test.cpp",
    "bti_test.cpp",
    "cov.cpp",
    "cpu.cpp",
    "crash.cpp",
    "hotplug_test.cpp",
    "idle.cpp",
    "interrupt_line_test.cpp",
    "interrupt_test.cpp",
    "ioport_test.cpp",
    "irq_controller_test.cpp",
    "irq_rcu_test.cpp",
    "irq_registry_test.cpp",
    "irq_revoke_test.cpp",
    "irq_test.cpp",
    "large_page_test.cpp",
    "lockup.cpp",
    "log.cpp",
    "memory_pressure_test.cpp",
    "mutex_stress.cpp",
    "page_queues_test.cpp",
    "page_reclaim_test.cpp",
    "page_source_test.cpp",
    "pager_test.cpp",
    "pin_lines_test.cpp",
    "pm_node_test.cpp",
    "port_test.cpp",
    "preempt_test.cpp",
    "resource_test.cpp",
    "sleep_test.cpp",
    "thread_join_test.cpp",
    "tick_replace_test.cpp",
    "timer_share_test.cpp",
    "timer_test.cpp",
    "user_copy_test.cpp",
    "vmo_snapshot_test.cpp",
  ]
  deps = [
    "//kernel/lib/gktl",
    "//kernel/lib/heap",
    "//kernel/lib/ktl",

    # pmnode.test checks the machine's distance table and CPU placement.
    "//kernel/lib/numa",

    # `lockup status` asks the detector for its notes.
    "//kernel/lib/lockup_detector:headers",
    "//kernel/lib/user_copy",
    "//kernel/mm:headers",
    "//kernel/object:headers",
    "//kernel/platform:headers",
    "//system/lib/lockdep",

    # `cov dump` builds a raw profile of the kernel's coverage counters.
    "//system/lib/profdata",
    "//system/lib/logz4:headers",
  ]
  visibility = [ "*" ]
}
