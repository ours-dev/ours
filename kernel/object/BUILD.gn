import("//build/cpp/cpp_interface.gni")

if (toolchain_environment == "kernel") {
  source_set("object") {
    sources = [
      "bti_dispatcher.cpp",
      "channel_dispatcher.cpp",
      "clock.cpp",
      "dispatcher.cpp",
      "exception_dispatcher.cpp",
      "exceptionate.cpp",
      "handle.cpp",
      "handle_table.cpp",
      "interrupt_dispatcher.cpp",
      "interrupt_event_dispatcher.cpp",
      "iommu_dispatcher.cpp",
      "job_dispatcher.cpp",
      "message_packet.cpp",
      "pager_dispatcher.cpp",
      "pager_proxy.cpp",
      "pmt_dispatcher.cpp",
      "port_dispatcher.cpp",
      "process_dispatcher.cpp",
      "resource_dispatcher.cpp",
      "sampler_dispatcher.cpp",
      "suspend_token_dispatcher.cpp",
      "thread_dispatcher.cpp",
      "virtual_interrupt_dispatcher.cpp",
      "vma_dispatcher.cpp",
      "vmo_dispatcher.cpp",
      "wait.cpp",
    ]
    public_deps = [ ":headers" ]

    # resource_dispatcher.cpp refuses the ports the platform says the kernel
    # drives (<ours/platform/ioport.hpp>), and interrupt_event_dispatcher.cpp
    # asks it which line an ISA IRQ arrives on (<ours/platform/isa.hpp>);
    # SamplerDispatcher owns a sampler::Session and calls into it.
    deps = [
      "//kernel/lib/sampler",
      "//kernel/platform:headers",
      "//system/public:kernel_version($default_toolchain)",
    ]
  }
}

cpp_interface("headers") {
  public = [
    "include/ours/object/bti_dispatcher.hpp",
    "include/ours/object/channel_dispatcher.hpp",
    "include/ours/object/clock.hpp",
    "include/ours/object/dispatcher.hpp",
    "include/ours/object/exception_dispatcher.hpp",
    "include/ours/object/exceptionate.hpp",
    "include/ours/object/handle_table.hpp",
    "include/ours/object/handle.hpp",
    "include/ours/object/interrupt_dispatcher.hpp",
    "include/ours/object/interrupt_event_dispatcher.hpp",
    "include/ours/object/iommu_dispatcher.hpp",
    "include/ours/object/job_dispatcher.hpp",
    "include/ours/object/message_packet.hpp",
    "include/ours/object/observer.hpp",
    "include/ours/object/pager_dispatcher.hpp",
    "include/ours/object/pager_proxy.hpp",
    "include/ours/object/pmt_dispatcher.hpp",
    "include/ours/object/port_dispatcher.hpp",
    "include/ours/object/process_dispatcher.hpp",
    "include/ours/object/resource_dispatcher.hpp",
    "include/ours/object/sampler_dispatcher.hpp",
    "include/ours/object/suspend_token_dispatcher.hpp",
    "include/ours/object/thread_dispatcher.hpp",
    "include/ours/object/types.hpp",
    "include/ours/object/virtual_interrupt_dispatcher.hpp",
    "include/ours/object/vma_dispatcher.hpp",
    "include/ours/object/vmo_dispatcher.hpp",
    "include/ours/object/wait.hpp",
  ]
  public_deps = [
    "//kernel/lib/gktl:headers",
    "//kernel/lib/sampler:headers",
    "//kernel/lib/user_copy:headers",
    "//kernel/lib/ktl:headers",
    "//kernel/mm:headers",
    "//system/lib/ustl:headers",
    "//system/public",
  ]
}

group("kernel-tests") {
  testonly = true
}
