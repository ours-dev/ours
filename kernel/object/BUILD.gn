import("//build/cpp/cpp_interface.gni")

if (toolchain_environment == "kernel") {
  source_set("object") {
    sources = [
      "dispatcher.cpp",
      "process_dispatcher.cpp",
      "resource_dispatcher.cpp",
      "thread_dispatcher.cpp",
    ]
    public_deps = [ ":headers" ]
  }
}

cpp_interface("headers") {
  public = [
    "include/ours/object/channel_dispatcher.hpp",
    "include/ours/object/dispatcher.hpp",
    "include/ours/object/handle_table.hpp",
    "include/ours/object/handle.hpp",
    "include/ours/object/job_dispatcher.hpp",
    "include/ours/object/observer.hpp",
    "include/ours/object/pager_dispatcher.hpp",
    "include/ours/object/process_dispatcher.hpp",
    "include/ours/object/resource_dispatcher.hpp",
    "include/ours/object/thread_dispatcher.hpp",
    "include/ours/object/types.hpp",
    "include/ours/object/vm_area_dispatcher.hpp",
  ]
  public_deps = [
    "//kernel/lib/gktl:headers",
    "//kernel/lib/ktl:headers",
    "//kernel/mm:headers",
    "//system/lib/ustl:headers",
    "//system/public",
  ]
}

group("kernel-tests") {
  testonly = true
}
