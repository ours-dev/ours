import("//build/dist/generated_resource.gni")
import("//build/obi/obi_input.gni")

# user_bootfs() -- the BootFS user space boots from, as a StorageBootFs item.
#
# The boot image carries two BootFS items, as Zircon's ZBI carries
# STORAGE_KERNEL and STORAGE_BOOTFS:
#   - the kernel package (kernel_package(), StorageKernel), which phys loads
#     the kernel from and the kernel loads userboot and the vDSO from;
#   - this one, the files user space gets: its programs, the vDSO they bind
#     against, and init's startup list.
# userboot finds this item in the boot image, decompresses it into a VMO and
# hands that on, so the kernel never reads it
# (.agents/tasks/userboot-bootfs/DESIGN.md). What user space may see is
# therefore decided here, by what goes into the item, and not by a list the
# kernel applies at boot.
#
# Every file of everything in deps goes in, as its distribution entries name
# it (a user_executable() installs its program under its install_name), at
# the BootFS's top level. LZ4-compressed, like the kernel package.
#
# With `init_startup = true` it also packages `config/init/startup`: init's
# startup list, one line per init_startup() entry in deps
# (//system/service/init/init_startup.gni), gathered from their
# `init_startup` metadata. Only meaningful in an image whose user space
# starts with init.
#
# Parameters:
#   deps (required)     -- the user programs and files, in the user toolchain.
#   init_startup        -- package init's startup list (default false).
#   testonly, visibility
template("user_bootfs") {
  assert(defined(invoker.deps), "user_bootfs($target_name) requires `deps`")

  _init_startup = defined(invoker.init_startup) && invoker.init_startup
  if (_init_startup) {
    _startup = "$target_name.init_startup"
    generated_resource(_startup) {
      forward_variables_from(invoker,
                             [
                               "deps",
                               "testonly",
                             ])
      visibility = [ ":*" ]
      data_keys = [ "init_startup" ]
      output_conversion = "list lines"
      outputs = [ "config/init/startup" ]
    }
  }

  # No `type`: obit's default for a block of files is a StorageBootFs item
  # (PackState's files_type "bootfs", //kernel/lib/obi/cli/pack.cpp).
  obi_input(target_name) {
    forward_variables_from(invoker,
                           [
                             "deps",
                             "testonly",
                             "visibility",
                           ])
    if (_init_startup) {
      deps += [ ":$_startup" ]
    }
    prefix = ""
    compressed = "lz4"
  }
}
