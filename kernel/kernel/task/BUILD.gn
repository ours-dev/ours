source_set("task") {
  sources = [
    "cpu_hotplug.cpp",
    "cpu_stopper.cpp",
    "dpc.cpp",
    "idle_thread.cpp",
    "init.cpp",
    "ipi_service.cpp",
    "owned_wait_queue.cpp",
    "preemption_state.cpp",
    "thread.cpp",
    "wait_queue.cpp",
  ]
  deps = [
    "//kernel/kernel/task/sched",

    # Carried over with the wait queues, which reach for the kernel counters
    # and the lock annotations.
    "//kernel/lib/gktl:headers",

    # The chain-lock transaction layer. Nothing here takes a chain lock yet;
    # the dependency is what puts the library in the build graph at all --
    # //kernel/lib:standalone-libs is discovery scaffolding that nothing
    # reaches -- and kernel/task is where the first user will be, when
    # Thread's PI lock and WaitQueue's lock become chain locks.
    "//kernel/lib/kconcurrent",
    "//kernel/lib/ktl:headers",

    # process_pending_signals() hands a SampleStack request to the sampling
    # session, which walks the user stack and records it.
    "//kernel/lib/sampler:request",
    "//kernel/mm:headers",
    "//kernel/object:headers",
    "//system/lib/lockdep",
  ]
  visibility = [ "*" ]
}
