source_set("sched") {
    sources = [
        "driver.cpp",
        # fair.cpp is out of the build while the boot is walked on the
        # round-robin discipline; it is not deleted. Put it back here and
        # remove rr.cpp to run on Fair again.
        "rr.cpp",
        "features.cpp",
        "scheduler.cpp",
        "scheduler_pi.cpp",
        "scheduler_migrator.cpp",
    ]
    deps = [
        "//kernel/lib/gktl:headers",
        "//kernel/lib/ktl:headers",
        "//kernel/mm:headers",
        "//system/lib/lockdep",
    ]
    visibility = ["*"]
}

