import("//kernel/kernel_params.gni")

source_set("sched") {
  sources = [
    "sched_clock.cpp",
    "features.cpp",
    "scheduler.cpp",
    "scheduler_pi.cpp",
    "scheduler_migrator.cpp",
  ]

  # Exactly one discipline occupies Discipline::Normal; see
  # sched_normal_discipline in //kernel/kernel_params.gni. Compiling both
  # would register two entries for one policy slot, which
  # Scheduler::init() asserts against.
  if (sched_normal_discipline == "fair") {
    sources += [ "fair.cpp" ]
  } else {
    sources += [ "rr.cpp" ]
  }
  deps = [
    # ours/task/thread.hpp holds a sampler::StackSampleRequest.
    "//kernel/lib/sampler:request",
    "//kernel/lib/gktl:headers",
    "//kernel/lib/ktl:headers",
    "//kernel/mm:headers",
    "//system/lib/lockdep",
  ]
  visibility = [ "*" ]
}
