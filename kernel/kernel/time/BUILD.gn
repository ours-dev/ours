source_set("time") {
  sources = [
    "clock_event_device.cpp",
    "clock_source.cpp",
    "tick_broadcast.cpp",
    "tick_device.cpp",
    "tick_sched.cpp",
    "timer.cpp",
    "timer_queue.cpp",
    "clock.cpp",
    "init.cpp",
    "ticks_per_second.cpp",
  ]
  deps = [
    # ours/task/thread.hpp holds a sampler::StackSampleRequest.
    "//kernel/lib/sampler:request",
    "//kernel/lib/gktl:headers",
    "//kernel/lib/ktl:headers",
    "//kernel/lib/mtl:headers",
    "//kernel/mm:headers",
    "//system/lib/lockdep",

    # <arch/auto_interrupt_disabler.hpp> and <arch/spin_hint.hpp> (timer.cpp,
    # timer_queue.cpp), the generic half of the architecture's interface, and
    # <logz4/log.hpp> (the clock and tick files and timer_queue.cpp).
    "//kernel/lib/arch:headers",
    "//system/lib/logz4:headers",
  ]
  visibility = [ "*" ]
}
