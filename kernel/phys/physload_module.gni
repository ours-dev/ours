import("//build/config/compiler/clang.gni")
import("//build/elf/elf_build_id.gni")

# Defines a phys module: an image physload loads at run time, out of the
# kernel package.
#
# This builds a loadable module, not a freestanding executable that happens
# to be relocatable.  The distinction is the point of the template:
#
#   * loadable_module, with the shared-object config set.  A module has no
#     entry point, no startup files, and no link-time closure over its
#     symbols -- the executable config set assumes all three.
#   * -fPIC: physload picks the load address at run time.
#   * Undefined symbols are expected, not an error.  A module carries only
#     its own logic; the phys runtime it uses stays undefined here and is
#     bound to physload's definitions when the module is loaded (see
#     ours/phys/exports.hpp).
#   * -fno-plt with -z now: an imported function then reaches the GOT the
#     same way an imported variable does, so the loader has one relocation
#     type to apply and never has to service a lazy PLT stub.
#   * No linker script.  The default shared-object layout is what the loader
#     reads: .init_array for constructors, .phys.module for the entry the
#     module declared with PHYS_MODULE().
#   * Section headers survive packaging.  They are how the loader finds
#     those two sections; a kernel image would be stripped of them.
#   * A build ID, which the executable config set would have supplied.  It
#     is what a future loader/module pairing check would compare.
#
# Subtargets:
#
#   $target_name.module
#     The underlying linker target.
#
# Parameters:
#
#   install_name (optional)
#     BootFS file name for the packaged module.  Defaults to target_name.
#     This is the name `kernel.phys.next` selects.
#
#   deps, sources, configs, testonly, visibility
#     Standard GN meanings.
template("physload_module") {
  _main_target = target_name
  _module_target = "$target_name.module"
  _build_id_target = "_physload_module.$target_name.build-id"
  _package_target = "_physload_module.$target_name.strip"

  _module_path = "$target_out_dir/$target_name.module"
  _package_path = "$target_out_dir/$target_name.bootfs"

  if (defined(invoker.install_name)) {
    _install_name = invoker.install_name
  } else {
    _install_name = _main_target
  }

  loadable_module(_module_target) {
    forward_variables_from(invoker,
                           "*",
                           [
                             "configs",
                             "install_name",
                             "metadata",
                             "output_dir",
                             "output_extension",
                             "output_name",
                             "visibility",
                           ])
    forward_variables_from(invoker, [ "visibility" ])
    if (defined(visibility)) {
      visibility += [ ":*" ]
    }

    # Replace rather than append: this template's set_defaults() below has
    # already put the shared-object config set on `invoker.configs`, and
    # loadable_module's own defaults are the same list.
    configs = []
    configs = invoker.configs + [
                "//build/config:build_id",
                "//kernel/phys:phys-module",
              ]

    # Every module carries physload's build ID as its PT_INTERP -- the
    # loader/module pairing check ModuleLoader runs before calling into the
    # module (kernel/phys/build-id.hpp).  Not caller-specified: a module
    # author has no reason to opt out of the one check that keeps a stale
    # module from running against raw struct layouts it no longer matches.
    if (!defined(deps)) {
      deps = []
    }

    # <format> (reached through ours/phys/print.hpp) needs the out-of-line
    # libc++ string members that only the explicit instantiation in the glue
    # provides; a module defines its own copy instead of importing one
    # physload does not export.
    # logz4: headers only — the module's log calls bind to physload's
    # exported global-logger symbols at load time.
    deps += [
      ":physload.interp",
      "//kernel/lib/libc:format-glue",
      "//system/lib/logz4:headers",
    ]

    output_name = _main_target
    output_extension = "module"
  }

  elf_build_id(_build_id_target) {
    visibility = [ ":*" ]
    forward_variables_from(invoker, [ "testonly" ])
    deps = [ ":$_module_target" ]
    elf = _module_path
    output = "$_module_path.build-id"
  }

  # --strip-debug, not --strip-sections: the loader reads .phys.module and
  # .init_array out of the section table, so the section headers have to
  # survive.  Debug information does not.
  action(_package_target) {
    visibility = [ ":*" ]
    forward_variables_from(invoker, [ "testonly" ])
    deps = [ ":$_module_target" ]
    sources = [ _module_path ]
    outputs = [ _package_path ]
    script = "//kernel/phys/strip-phys-module.py"
    args = [
      "--objcopy",
      rebase_path("$clang_tool_dir/llvm-objcopy", root_build_dir),
      "--input",
      rebase_path(_module_path, root_build_dir),
      "--output",
      rebase_path(_package_path, root_build_dir),
    ]
  }

  group(_main_target) {
    forward_variables_from(invoker,
                           [
                             "testonly",
                             "visibility",
                           ])
    public_deps = [ ":$_module_target" ]
    data_deps = [
      ":$_build_id_target",
      ":$_package_target",
    ]

    metadata = {
      distribution_entries = []
      distribution_entries_barrier = []
      distribution_entries += [
        {
          # A bare BootFS name: physload looks the module up by the name
          # `kernel.phys.next` carries, with no directory around it.
          destination = _install_name
          source = rebase_path(_package_path, root_build_dir)
          label = get_label_info(":$_main_target", "label_with_toolchain")
        },
      ]
    }
  }
}

set_defaults("physload_module") {
  # The shared-object config set, which is what a loadable module is.  The
  # executable set adds -nostartfiles/--no-dynamic-linker/build-id and a
  # closed-world link policy that does not describe a module.
  configs = default_shared_library_configs
}
