import("//build/cpp/cpp_interface.gni")
import("//build/cpp/host_test.gni")

cpp_interface("headers") {
  public = [
    "include/multiboot/memory_map.hpp",
    "include/multiboot/multiboot2.hpp",
    "include/multiboot/view.hpp",
  ]
  public_deps = [
    "//kernel/phys/lib/bootmem:headers",
    "//system/lib/ustl:headers",
    "//system/public",
  ]
}

# Header-only today, same seam bootmem keeps for the same reason: sources
# can be added later without changing callers.
group("multiboot") {
  public_deps = [ ":headers" ]
}

group("tests") {
  testonly = true

  # Plain hosted programs: they must build in the host toolchain (see
  # kernel/lib/obi:tests for the same fix) -- the default toolchain is a
  # bare switchset mount point with no hosted-libc/prelude wiring of its
  # own.
  deps = [
    ":memory-map-smoke($host_toolchain)",
    ":view-smoke($host_toolchain)",
  ]
}

host_test("view-smoke") {
  sources = [ "test/view_smoke.cpp" ]
  deps = [
    ":headers",
    "//system/lib/ustl:headers",
    "//system/public",
  ]
  visibility = [ "*" ]
}

host_test("memory-map-smoke") {
  sources = [ "test/memory_map_smoke.cpp" ]
  deps = [
    ":headers",
    "//kernel/phys/lib/bootmem:headers",
    "//system/lib/ustl:headers",
    "//system/public",
  ]
  visibility = [ "*" ]
}
