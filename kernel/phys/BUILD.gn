import("//build/config/link_config.gni")
import("//build/config/ours/standard.gni")
import("//build/cpp/cpp_interface.gni")
import("//build/ours/cpu.gni")
import("//build/toolchain/ours/ours_toolchain_suite.gni")

import("//kernel/kernel_package.gni")
import("physload_module.gni")
import("kernel_elf_interp.gni")
import("phys_executable.gni")

declare_args() {
  # Expand this phys boot-test rollup for every supported Ours CPU.  The
  # targets remain structural until the boot-test runner is implemented.
  all_cpu_phys_boot_tests = false
}

config("phys.config") {
  configs = [
    "//kernel/products:standalone",
    "//kernel/products:warnings",
    "//kernel/arch/$ours_cpu:abi",
  ]
  # KERNEL_DEBUG_LEVEL comes from //kernel/products:kernel.config (the
  # switchset-selected level); this config adds only the phys identity.
  defines = [
    "PHYS_ENVIRONMENT=1",
  ]
}

link_config("phys.link") {
  link_script = "phys.ld"
  symbols = [ "PHYS_LOAD_ADDRESS=0" ]
}

# physload's own link policy: ET_DYN at base 0, loaded and relocated by
# boot-shim rather than GRUB.  No PHYS_LOAD_ADDRESS -- physload.ld links
# at 0 unconditionally, the way any ET_DYN image does.
link_config("physload.link") {
  link_script = "physload.ld"
}

# The first pass of an export_table image (phys_executable.gni).  Section
# GC is off here, and only here: a function that physload defines but
# never calls itself is exactly what a module wants to bind to, and if GC
# drops it before the table is generated the export disappears silently.
# The second pass keeps its GC -- the table references every exported
# symbol, so nothing it names can be collected.
config("phys-prelink") {
  ldflags = [ "-Wl,--no-gc-sections" ]
}

# How a phys module is built and how it reaches physload
# (physload_module.gni).
#
# -fPIC because physload picks the load address at run time.  -fno-plt
# because a call through a PLT stub needs lazy-binding machinery no boot
# image can service; without it an imported function reaches the GOT the
# same way an imported variable does, leaving ModuleLoader a single
# relocation type to apply.  -z now says the same thing to the linker.
#
# -nostdlib rather than the executable set's -nostartfiles/-nolibc: a
# module has no startup files to suppress in the first place.  There is
# no linker script either -- the default shared-object layout is what the
# loader reads.
#
# -shared: redundant for a physload_module() (its loadable_module GN
# target type already gets this from the toolchain's solink_module tool)
# but required for physload itself, which is a plain executable() target
# (phys_executable.gni) reusing this same config for its compile/link
# flags -- without it the linker produces a fixed-address EXEC image with
# no dynamic table at all, silently ignoring -fPIC.
config("phys-module") {
  cflags = [
    "-fPIC",
    "-fno-plt",
  ]
  asmflags = [ "-fPIC" ]
  ldflags = [
    "-shared",
    "-nostdlib",
    "-nostdlib++",
    "-Wl,-z,now",
    "-Wl,--no-dynamic-linker",

    # There is no dynamic linker (the flag above), so a default-visibility
    # defined symbol has nothing that could ever preempt it and nothing
    # able to resolve a deferred lookup for it if the linker left one.
    # -Bsymbolic makes the linker resolve those symbols at link time
    # instead: an ordinary R_X86_64_RELATIVE entry boot-shim's relocation
    # pass already handles, rather than a dynamic (`.rela.dyn`
    # non-RELATIVE) entry that would need a resolver which does not
    # exist.  Physload's export table (.phys.exports, ours/phys/exports.hpp)
    # is exactly this: absolute pointers to its own default-visibility
    # functions, referenced from hand-written assembly with no PLT/GOT
    # indirection of its own.
    "-Wl,-Bsymbolic",
  ]
}

# physload carries the whole phys runtime.  A physload_module() links none
# of it -- ModuleLoader binds the module's undefined symbols against the
# export table this image publishes (ours/phys/exports.hpp), so there is
# one console list, one BootMem and one Aspace in the system rather than
# a copy per ELF.
source_set("physload.core") {
  sources = [
    "acpi.cpp",
    "aspace.cpp",
    "boot-options.cpp",
    "build-id-note.cpp",
    "build-id.cpp",
    "console.cpp",
    "elf-image-mapping.cpp",
    "elf-image.cpp",
    "exports.cpp",
    "memory.cpp",
    "module-loader.cpp",
    "panic.cpp",
    "physload.cpp",
    "raw-image.cpp",
  ]
  # phys-module's cflags (-fPIC -fno-plt), not just its ldflags: this is
  # the source_set whose *compiled objects* end up in physload's final
  # ET_DYN link (phys_executable("physload") below has no sources of its
  # own to apply configs to -- everything it links comes through deps).
  configs += [ "//kernel/phys:phys-module" ]
  deps = [
    "//kernel/lib/ccrt",
    "//kernel/lib/eftl",
    "//kernel/lib/ktl:headers",
    "//kernel/lib/libc:string",
    "//kernel/lib/obi",
  ]
  public_deps = [
    ":headers",
    # Public: phys sources reach the architecture's paging and boot-memory
    # types straight out of these headers.
    "//kernel/arch/$ours_cpu/phys:$ours_cpu",
    "//kernel/lib/acpi",
  ]
  visibility = [ "*" ]
}

# The arch-neutral pieces boot-shim needs to load and jump to physload:
# the ELF loader (init/load_at/relocate -- not relocate_and_bind or
# section, which only ModuleLoader uses, and not fix_mapping, which
# elf-image-mapping.cpp keeps out of this on purpose since it would drag
# in Aspace/BootMem, neither of which exists yet at this point), plus a
# console and panic() to have somewhere to report a failure before
# physload exists to report it through.  Everything else physload.core
# has -- BootMem, module loading, the export table -- is physload's own
# job, not boot-shim's.
source_set("boot-shim.core") {
  sources = [
    "console.cpp",
    "elf-image.cpp",
    "panic.cpp",
  ]
  deps = [
    "//kernel/lib/ccrt",
    "//kernel/lib/eftl",
    "//kernel/lib/ktl:headers",
    "//kernel/lib/libc:string",
  ]
  public_deps = [
    ":headers",
    # elf-image.cpp's declarations reach Aspace (kernel-image.hpp's
    # fix_mapping() signature, even though boot-shim.core never compiles
    # that body -- elf-image-mapping.cpp stays out of these sources), and
    # Aspace pulls in the architecture's paging types straight out of
    # these headers, same as physload.core does via its own arch dep.
    "//kernel/arch/$ours_cpu:headers",
    "//kernel/arch/$ours_cpu/phys:headers",
    "//kernel/lib/obi",
  ]
  visibility = [ "*" ]
}

# physload's own build ID, embedded into every physload_module()'s
# PT_INTERP so ModuleLoader can refuse to load one built against a
# different physload (ours/phys/build-id.hpp reads the runtime half of
# this pairing).  Not a module's own deps entry: physload_module() below
# links it into every module automatically.
kernel_elf_interp("physload.interp") {
  deps = [ ":physload" ]
}

# The physboot module, packaged as the bare BootFS file "physboot"
# (kernel_package("physboot") below) and loaded by physload at run time.
#
# Sources are physboot's own logic and nothing else.  The console, panic,
# boot memory, address space and ELF loader it uses stay undefined here and
# bind to physload at load time; deps carry only headers, so the module
# picks up no object code it would otherwise duplicate.
physload_module("physboot") {
  visibility = [ "image/*" ]
  install_name = "physboot"
  sources = [
    "kernel-boot.cpp",
    "kernel-package-loader.cpp",
    "physboot.cpp",
  ]
  deps = [
    ":headers",
    "//kernel/arch/$ours_cpu:headers",
    # kernel-boot.hpp reaches the kernel's address-space layout constants.
    "//kernel/arch/$ours_cpu/kernel:headers",
    "//kernel/arch/$ours_cpu/phys:headers",
    "//kernel/lib/arch:headers",
    "//kernel/lib/eftl:headers",
    "//kernel/lib/ktl:headers",
    "//kernel/lib/obi",

    # Linked, not bound: ccrt drives *this* image's .ccrt_init array, and
    # the compiler open-codes calls to memcpy/memset that must resolve
    # inside the module.  Everything else comes from physload.
    "//kernel/lib/ccrt",
    "//kernel/lib/libc:string",
  ]
}

