import("//build/config/link_config.gni")
import("//build/config/ours/standard.gni")
import("//build/cpp/cpp_interface.gni")
import("//build/ours/cpu.gni")
import("//build/toolchain/ours/ours_toolchain_suite.gni")

import("//kernel/kernel_package.gni")
import("physload_module.gni")
import("kernel_elf_interp.gni")
import("phys_executable.gni")

declare_args() {
  # Expand this phys boot-test rollup for every supported Ours CPU.  The
  # targets remain structural until the boot-test runner is implemented.
  all_cpu_phys_boot_tests = false
}

if (current_toolchain == default_toolchain) {
  foreach(cpu, standard_ours_cpus) {
    ours_toolchain_suite("kernel.phys_${cpu}") {
      cpu = cpu
      os = target_os
      environment = "kernel.phys"
      # Link with the target GNU ld rather than the Clang driver.  The driver
      # hands an ELF-target link off to the host `gcc`, which rejects the
      # cross-architecture flags outright on a non-x86 host.
      elf_linker = true
      # Resolve the compiler through clang_tool_dir like every other kernel
      # suite (//build/toolchain/ours/BUILD.gn, //build/switch/*).  Without
      # this the tools fall back to bare PATH names, which is not reproducible
      # across machines.
      tool_dir = clang_tool_dir
      tags = [
        "kernel",
        "no-floating-point",
        "standalone",
      ]

      configs = [
        "//build/config:frame_pointers",
        "//kernel/products:kernel.config",
        # Provides PHYS_ENVIRONMENT=1 / KERNEL_DEBUG_LEVEL=2 and the
        # standalone/warnings/abi config stack — without it the phys
        # sources compile against the hosted print/ABI paths.
        "//kernel/phys:phys.config",
      ]
    }
  }
} else if (toolchain_environment == "kernel.phys") {
  config("phys.config") {
    configs = [
      "//kernel/products:standalone",
      "//kernel/products:warnings",
      "//kernel/arch/$ours_cpu:abi",
    ]
    # KERNEL_DEBUG_LEVEL comes from //kernel/products:kernel.config (the
    # switchset-selected level); this config adds only the phys identity.
    defines = [
      "PHYS_ENVIRONMENT=1",
    ]
  }

  link_config("phys.link") {
    link_script = "phys.ld"
    symbols = [ "PHYS_LOAD_ADDRESS=0" ]
  }

  # physload-loaded modules are ET_DYN images linked at base 0 whose
  # e_entry is the phys_load_handoff adapter (see phys-module.ld).
  link_config("phys-module.link") {
    link_script = "phys-module.ld"
  }

  # How a module reaches physload.
  #
  # -fPIC, because the module is an ET_DYN image loaded at an address
  # physload picks at runtime.  -fno-plt, because a call through a PLT stub
  # would need a .plt section and lazy-binding machinery that nothing in a
  # boot image can service; without it every imported symbol -- function or
  # variable alike -- becomes a single R_X86_64_GLOB_DAT against the GOT,
  # which is the one relocation ModuleLoader has to understand.  -z now
  # keeps the linker from assuming anything will bind lazily later.
  # The first pass of an export_table image (phys_executable.gni).  Section
  # GC is off here, and only here: a function that physload defines but
  # never calls itself is exactly what a module wants to bind to, and if GC
  # drops it before the table is generated the export disappears silently.
  # The second pass keeps its GC -- the table references every exported
  # symbol, so nothing it names can be collected.
  config("phys-prelink") {
    ldflags = [ "-Wl,--no-gc-sections" ]
  }

  config("phys-module.compile") {
    cflags = [
      "-fPIC",
      "-fno-plt",
    ]
    ldflags = [ "-Wl,-z,now" ]
  }
}

if (toolchain_environment == "kernel.phys") {
  # physload carries the whole phys runtime.  A physload_module() links none
  # of it -- ModuleLoader binds the module's undefined symbols against the
  # export table this image publishes (ours/phys/exports.hpp), so there is
  # one console list, one BootMem and one Aspace in the system rather than
  # a copy per ELF.
  source_set("physload.core") {
    sources = [
      "acpi.cpp",
      "aspace.cpp",
      "boot-options.cpp",
      "console.cpp",
      "elf-image.cpp",
      "exports.cpp",
      "memory.cpp",
      "module-loader.cpp",
      "panic.cpp",
      "physload.cpp",
      "raw-image.cpp",
    ]
    deps = [
      "//kernel/lib/ccrt",
      "//kernel/lib/eftl",
      "//kernel/lib/ktl:headers",
      "//kernel/lib/libc:string",
      "//kernel/lib/obi",
    ]
    public_deps = [
      ":headers",
      # Public: phys sources reach the architecture's paging and boot-memory
      # types straight out of these headers.
      "//kernel/arch/$ours_cpu/phys:$ours_cpu",
      "//kernel/lib/acpi",
    ]
    visibility = [ "*" ]
  }

  # The physboot module: an ET_DYN image packaged as the bare BootFS file
  # "physboot" (kernel_package("physboot") below), loaded and relocated by
  # physload's ModuleLoader.
  #
  # Sources are physboot's own logic and nothing else.  The console, panic,
  # boot memory, address space and ELF loader it uses stay undefined here and
  # bind to physload at load time; deps carry only headers, so the module
  # picks up no object code it would otherwise duplicate.
  physload_module("physboot.module") {
    visibility = [ ":*" ]
    install_name = "physboot"
    sources = [
      "kernel-boot.cpp",
      "kernel-package-loader.cpp",
      "physboot.cpp",
    ]
    deps = [
      ":headers",
      "//kernel/arch/$ours_cpu:headers",
      # kernel-boot.hpp reaches the kernel's address-space layout constants.
      "//kernel/arch/$ours_cpu/kernel:headers",
      "//kernel/arch/$ours_cpu/phys:headers",
      "//kernel/lib/arch:headers",
      "//kernel/lib/eftl:headers",
      "//kernel/lib/ktl:headers",
      "//kernel/lib/obi",

      # Linked, not bound: ccrt drives *this* image's .ccrt_init array, and
      # the compiler open-codes calls to memcpy/memset that must resolve
      # inside the module.  Everything else comes from physload.
      "//kernel/lib/ccrt",
      "//kernel/lib/libc:string",
    ]
  }
}

cpp_interface("headers") {
  public = []

  # The physical-environment interfaces expose memory-address and page-table
  # types in their public headers.  Keep that dependency at the interface
  # boundary so both phys sources and kernel-side consumers receive the same
  # include contract rather than relying on a toolchain-global include path.
  public_deps = [
    "//kernel/lib/acpi:header",
    "//kernel/lib/arch:headers",
    "//kernel/arch/$ours_cpu/phys:headers",
    "//kernel/lib/eftl:headers",
    "//kernel/lib/ktl:headers",
    "//kernel/mm:headers",
    "//system/lib/ustl:headers",
    "//system/public",
    "//kernel/lib/obi",
  ]
}

# Kernel-side ABI seam for the handoff structure.  The phys executable owns
# its implementation, while the kernel only needs this propagated header
# interface and the generated PT_INTERP dependency below.
cpp_interface("handoff") {
  public = [
    "include/ours/phys/handoff.hpp",
  ]
  public_deps = [
    "//kernel/arch/$ours_cpu/phys:headers",
    "//kernel/lib/obi",
    "//kernel/phys/lib/bootmem:headers",
    "//system/lib/ustl:headers",
  ]
}

if (toolchain_environment == "kernel.phys") {
  # Standard adapter linked into every physload-loaded module (physboot,
  # netboot, fastboot, ...).  Provides the PhysLoadHandoff entry point
  # that physload calls after loading and relocating the module ELF.
  source_set("physload.module") {
    sources = [ "physload-module.cpp" ]
    deps = [
      ":headers",
      "//kernel/arch/$ours_cpu/phys:headers",
      "//kernel/lib/ccrt:headers",
    ]
    visibility = [
      ":*",
      "//kernel/phys/*",
    ]
  }
}

# physload — the first-stage loader.  The bootloader (Multiboot2) hands the
# OBI container to the x86 boot shim, which loads the physload ELF from the
# container's item 0 (obi_executable_item below); the raw .bin remains the
# direct-load distribution for the GRUB two-file flow.
phys_executable("physload") {
  output_dir = target_out_dir
  output_extension = "bin"
  release_output = true
  obi_executable_item = true
  export_table = true
  deps = [ ":physload.core" ]
}

kernel_package("physboot") {
  # 产品的镜像配方（product() 的 extra_deps）把 physboot 模块收进镜像。
  visibility = [
    "//kernel/*",
    "//products/*",
    "//tests/*",
  ]
  # BootFS 顶层是扁平命名空间：physboot 模块以裸名 "physboot" 打包，
  # 不带 kernel_package 目标名前缀（见 .agents/tasks/phys-module-and-obi-tree）。
  prefix = ""
  # The packaged input is the module ELF itself (ET_DYN, e_entry =
  # phys_load_handoff); physload loads it via ModuleLoader.
  #
  # $current_cpu is correct in every context (Fuchsia spells it the same way):
  # the default toolchain carries target identity, so its current_cpu names
  # the product's target machine rather than the build host, and kernel/phys
  # toolchain contexts set current_cpu through toolchain_args.
  deps = [ ":physboot.module(:kernel.phys_$current_cpu)" ]
}