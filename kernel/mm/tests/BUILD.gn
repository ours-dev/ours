# Host unit tests for the memory-management subsystem.
#
# These targets build with the default (host) toolchain and run on the build
# machine — no kernel boot required. They compile the parts of mm that touch
# no kernel globals (the buddy allocator, protection ranges) plus a
# host-friendly arch include set, mirroring the kernel/lib/arch smoke-test
# convention.

executable("frame-buddy-smoke") {
  testonly = true
  sources = [
    "frame_buddy_smoke.cpp",
    "//kernel/mm/frame_buddy.cpp",
  ]

  # <ours/node_mask.hpp> lives beside cpu_mask.hpp in //kernel/include, and
  # these tests already force-include ours/prelude.hpp from there, so the
  # directory is a dependency either way. //kernel/lib/arch:cpu-mask-smoke
  # says it the same way.
  include_dirs = [ "//kernel/include" ]

  # The mm headers ride in via the generated include-path config rather than
  # //kernel/mm:headers, whose //kernel/phys:handoff dep does not evaluate
  # under the host toolchain these tests build in.
  configs += [ "//kernel/mm:headers.config" ]
  deps = [
    "//kernel/lib/arch:headers",
    "//kernel/arch/x86:headers",
    "//system/lib/ustl:headers",
    "//kernel/lib/gktl:headers",
    "//kernel/lib/ktl:headers",
    "//system/public",
  ]
  visibility = [ "*" ]
}

executable("protection-ranges-smoke") {
  testonly = true
  sources = [
    "protection_ranges_smoke.cpp",
    "//kernel/mm/protection_ranges.cpp",
  ]

  # <ours/node_mask.hpp> lives beside cpu_mask.hpp in //kernel/include, and
  # these tests already force-include ours/prelude.hpp from there, so the
  # directory is a dependency either way. //kernel/lib/arch:cpu-mask-smoke
  # says it the same way.
  include_dirs = [ "//kernel/include" ]
  configs += [ "//kernel/mm:headers.config" ]
  deps = [
    "//kernel/lib/arch:headers",
    "//kernel/arch/x86:headers",
    "//system/lib/ustl:headers",
    "//kernel/lib/gktl:headers",
    "//kernel/lib/ktl:headers",
    "//system/public",
  ]
  visibility = [ "*" ]
}

executable("alloc-request-smoke") {
  testonly = true

  # resolve_request() is inline in priv/alloc_request.hpp, so there is no mm
  # source to compile: the header is deliberately thin enough to reach from
  # here, pulling in neither <ours/cpu.hpp> nor <ours/mm/types.hpp>.
  sources = [ "alloc_request_smoke.cpp" ]

  # <ours/node_mask.hpp> lives beside cpu_mask.hpp in //kernel/include, and
  # this test already force-includes ours/prelude.hpp from there.
  include_dirs = [ "//kernel/include" ]

  # NUMA on, for this test only. MAX_NODES is 1 in the default build, and the
  # AllocFlags::ThisNode narrowing this test exists to pin is a no-op with one
  # node:
  # the caller's mask, the home node and the result are all {0}. The function's
  # logic does not depend on the configured node count, so testing it at 32
  # nodes tests the branches that a one-node build cannot reach.
  #
  # MM_NUMA is the switch the kernel products pass, and node_mask.hpp derives
  # MAX_NODES from it directly, so this passes the same one rather than the
  # OURS_CONFIG_NUMA that mm/cfg.hpp used to derive from it --
  # //kernel/lib/arch:cpu-mask-smoke passes MP_MAX_CPUS the same way.
  defines = [ "MM_NUMA=1" ]

  configs += [ "//kernel/mm:headers.config" ]
  deps = [
    "//kernel/lib/arch:headers",
    "//kernel/arch/x86:headers",
    "//system/lib/ustl:headers",
    "//kernel/lib/gktl:headers",
    "//kernel/lib/ktl:headers",
    "//system/public",
  ]
  visibility = [ "*" ]
}

executable("address-smoke") {
  testonly = true
  sources = [ "address_smoke.cpp" ]
  include_dirs = [
    "//kernel/include",
    "//kernel/arch/x86/kernel/include",
  ]
  configs += [ "//kernel/mm:headers.config" ]
  deps = [
    "//kernel/lib/arch:headers",
    "//kernel/arch/x86:headers",
    "//system/lib/ustl:headers",
    "//kernel/lib/gktl:headers",
    "//kernel/lib/ktl:headers",
    "//system/public",
  ]
}

group("tests") {
  testonly = true
  public_deps = [
    ":address-smoke",
    ":frame-buddy-smoke",
    ":protection-ranges-smoke",
    ":alloc-request-smoke",
  ]
}
