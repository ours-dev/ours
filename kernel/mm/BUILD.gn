import("//build/cpp/cpp_interface.gni")
import("//build/ours/cpu.gni")
import("//build/toolchain/toolchain_environment.gni")

if (toolchain_environment == "kernel") {
  source_set("mm") {
    sources = [
      "core/frame_buddy.cpp",
      "cpu_local.cpp",
      "early_mem.cpp",
      "init_pmm.cpp",
      "init_vmm.cpp",
      "memory_model.cpp",
      "object_cache.cpp",
      "page_queues.cpp",
        "page_request.cpp",
      "pm_frame.cpp",
      "pm_node.cpp",
      "pm_zone.cpp",
      "pmm.cpp",
      "slab.hpp",
      "stack.cpp",
      "vflat_model.cpp",
      "vm_area.cpp",
      "vm_area_or_mapping.cpp",
      "vm_aspace.cpp",
      "vm_cow_pages.cpp",
      "vm_mapping.cpp",
      "vm_object.cpp",
      "vm_object_paged.cpp",
      "vm_object_physical.cpp",
      "vmm.cpp",
    ]
    deps = [
      "//kernel/arch/$ours_cpu/mm",
      "//kernel/lib/logz4:headers",
    ]
    public_deps = [ ":headers" ]
    visibility = [ "*" ]
  }
}

cpp_interface("headers") {
  public = []
  public_configs = [ "//kernel/arch/$ours_cpu/mm:headers.config" ]
  public_deps = [
    "//kernel/phys:handoff",
    "//kernel/lib/gktl:headers",
    "//kernel/lib/ktl:headers",
    "//system/lib/derive:headers",
    "//system/lib/lockdep",
    "//system/lib/ustl:headers",
    "//system/public",
  ]
}

group("tests") {
  testonly = true
  public_deps = [ "tests:tests" ]
}
