import("//build/cpp/cpp_interface.gni")
import("//build/ours/cpu.gni")
import("//kernel/kernel_params.gni")
import("//build/toolchain/toolchain_environment.gni")

if (toolchain_environment == "kernel") {
  source_set("mm") {
    sources = [
      "frame_buddy.cpp",
      "cpu_local.cpp",
      "early_mem.cpp",
      "init_pmm.cpp",
      "init_vmm.cpp",
      "memmap_init.cpp",
      "object_cache.cpp",
      "page_queues.cpp",
      "page_table_deposits.cpp",
        "page_request.cpp",
      "pm_frame.cpp",
      "pm_node.cpp",
      "pm_node_init.cpp",
      "pm_node_topology.cpp",
      "pm_zone.cpp",
      "pmm.cpp",
      "protection_ranges.cpp",
      "slab.hpp",
      "stack.cpp",
      "vm_area.cpp",
      "vm_area_or_mapping.cpp",
      "vm_aspace.cpp",
      "vm_cow_pages.cpp",
      "vm_mapping.cpp",
      "vm_object.cpp",
      "vm_object_paged.cpp",
      "vm_object_physical.cpp",
      "vm_page_splice_list.cpp",
      "vmm.cpp",
    ]
    # The two memory models are mutually exclusive: exactly one is compiled, and
    # `MemMap` names whichever it is. Selecting here rather than with an
    # #if inside the sources keeps the unselected one from having to compile at
    # all. See mm_vflat_memmap in //kernel/kernel_params.gni.
    if (mm_vflat_memmap) {
      sources += [ "vflat_memmap.cpp" ]
    } else {
      sources += [ "sparse_memmap.cpp" ]
    }

    deps = [
      # ours/task/thread.hpp holds a sampler::StackSampleRequest.
      "//kernel/lib/sampler:request",
      "//kernel/arch/$ours_cpu/mm",
      # VmObjectPaged::read_user()/write_user() copy between a VMO page and a
      # user buffer directly, with the fault-capturing copies, and no bounce
      # page in between.
      "//kernel/lib/user_copy",
      "//system/lib/logz4:headers",
    ]
    public_deps = [ ":headers" ]
    visibility = [ "*" ]
  }
}

cpp_interface("headers") {
  public = []
  public_configs = [
    "//kernel/arch/$ours_cpu/mm:headers.config",

    # vm_object.hpp names user_copy::UserOutPtr/UserInPtr in read_user() and
    # write_user(), so whoever includes it needs user_copy's include path.
    # Only the include path, not a dependency on //kernel/lib/user_copy:headers:
    # that target depends back on this one (its header reaches mm::VmfCause),
    # and a dependency both ways is a cycle GN refuses. heap takes mm's config
    # back the same way, for the same reason.
    "//kernel/lib/user_copy:headers.config",
  ]
  public_deps = [
    "//kernel/phys:handoff",
    "//kernel/lib/gktl:headers",
    # Every mm source that says `new (gaf)` needs <heap/new.hpp>; heap takes
    # only mm's include-path config back, so this stays a DAG.
    "//kernel/lib/heap:headers",
    "//kernel/lib/ktl:headers",
    "//system/lib/derive:headers",
    "//system/lib/lockdep",
    "//system/lib/ustl:headers",
    "//system/public",
  ]
}

group("tests") {
  testonly = true
  public_deps = [ "tests:tests" ]
}
