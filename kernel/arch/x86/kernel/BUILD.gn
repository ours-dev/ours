# x86_64 main 架构特有代码
source_set("kernel") {
  sources = [
    "bootstrap.cpp",
    "bootstrap16.S",
    "context.S",
    "descriptor.cpp",
    "exception.S",
    "faults.cpp",
    "feature.cpp",
    "gdt.S",
    "idt.S",
    "idt.cpp",
    "init.cpp",
    "io_bitmap.cpp",
    "irq/init.cpp",
    "mp.cpp",
    "start.S",
    "syscall.S",
    "task/idle_thread.cpp",
    "task/thread.cpp",
    "time/hpet.cpp",
    "time/time.cpp",
    "user_copy.S",
    "user_copy.cpp",
    "uspace.S",
  ]

  deps = [
    # ours/task/thread.hpp holds a sampler::StackSampleRequest.
    "//kernel/lib/sampler:request",
    ":headers",
    "//kernel/arch/x86/apic",
    "//kernel/arch/x86/mm:headers",
    "//kernel/driver:headers",
    "//kernel/lib/acpi",
    "//kernel/lib/gktl",

    # The NMI vector hands every NMI to the lockup detector (faults.cpp).
    "//kernel/lib/lockup_detector",
    "//system/lib/logz4:headers",
    "//kernel/lib/mtl:headers",
    "//kernel/mm:headers",
  ]
  visibility = [ "*" ]
}

cpp_interface("headers") {
  public = [ "include/ours/arch/hpet_regs.hpp" ]
}
