import("//kernel/kernel_params.gni")

# x86_64 main 架构特有代码
source_set("kernel") {
  sources = [
    "bootstrap.cpp",
    "bootstrap16.S",
    "context.S",
    "descriptor.cpp",
    "exception.S",
    "faults.cpp",
    "feature.cpp",
    "gdt.S",
    "idt.S",
    "idt.cpp",
    "init.cpp",
    "io_bitmap.cpp",
    "irq/init.cpp",
    "mp.cpp",
    "start.S",
    "syscall.S",
    "task/idle_thread.cpp",
    "task/thread.cpp",
    "time/hpet.cpp",
    "time/time.cpp",
    "user_copy.S",
    "user_copy.cpp",
    "uspace.S",
  ]

  deps = [
    # ours/task/thread.hpp holds a sampler::StackSampleRequest.
    "//kernel/lib/sampler:request",
    ":headers",
    "//kernel/arch/x86/apic",
    "//kernel/arch/x86/lib/idle_states",
    "//kernel/arch/x86/mm:headers",

    # The PC's interval timer, the i8253: time/time.cpp drives the legacy
    # timer line with it until the HPET takes the line over. A PC device, so
    # x86's arch code links it rather than the generic kernel.
    "//kernel/driver",
    "//kernel/lib/acpi",
    "//kernel/lib/gktl",

    # The NMI vector hands every NMI to the lockup detector (faults.cpp).
    "//kernel/lib/lockup_detector",
    "//system/lib/logz4:headers",
    "//kernel/lib/mtl:headers",
    "//kernel/mm:headers",

    # <ours/platform/init.hpp> (bootstrap.cpp, faults.cpp),
    # <ours/platform/interrupt.hpp> (faults.cpp) and <ours/platform/isa.hpp>
    # (time/hpet.cpp, time/time.cpp): the seam x86's kernel code calls the
    # board through. Before this edge only private ones reached it, such as
    # the commands below, and GN does not read an include through those.
    "//kernel/platform:headers",
  ]

  # The console commands that only make sense on x86, linked when the kernel
  # has a console, as //kernel/top links //kernel/commands: a kernel built
  # without kshell has no use for their callbacks. They go in with x86's
  # kernel target and not with //kernel/top, which has to stay the same for
  # every $ours_cpu.
  if (kernel_shell_enabled) {
    deps += [ "//kernel/arch/x86/commands" ]
  }
  visibility = [ "*" ]
}

# Every header in this directory's include root. The toolchain already puts the
# root on every kernel compile's -I line, so listing the files does not make
# them findable; it tells GN which target owns them. That is what
# `gn check --check-system` reads (the kernel includes with <angle brackets>,
# which a plain `gn check` skips): it ignores an include of a header no target
# lists, and holds an include of a listed one to a dependency on its target.
cpp_interface("headers") {
  public = [
    # ours/arch/ is the per-arch set: the headers every architecture provides
    # under the same name, which generic code includes as <ours/arch/NAME.hpp>.
    # riscv's own headers target lists the ones riscv has written so far.
    "include/ours/arch/aspace_layout.hpp",
    "include/ours/arch/cpu_local.hpp",
    "include/ours/arch/entry.hpp",
    "include/ours/arch/idle_thread.hpp",
    "include/ours/arch/thread.hpp",

    # Not part of that set: a migration stub that nothing includes, which the
    # x86 virtual-address-space interface will replace.
    "include/ours/arch/vm_aspace.hpp",

    # ours/arch/x86/ is private to x86: a path with x86/ in it resolves only
    # while x86's include root is on the command line.
    "include/ours/arch/x86/apic.hpp",
    "include/ours/arch/x86/asm.hpp",
    "include/ours/arch/x86/bootstrap.hpp",
    "include/ours/arch/x86/cpu.hpp",
    "include/ours/arch/x86/descriptor.hpp",
    "include/ours/arch/x86/entry.hpp",
    "include/ours/arch/x86/faults.hpp",
    "include/ours/arch/x86/feature.hpp",
    "include/ours/arch/x86/hpet.hpp",
    "include/ours/arch/x86/hpet_regs.hpp",
    "include/ours/arch/x86/idt.hpp",
    "include/ours/arch/x86/init.hpp",
    "include/ours/arch/x86/io_bitmap.hpp",
    "include/ours/arch/x86/mem_cfg.hpp",
    "include/ours/arch/x86/mp.hpp",
    "include/ours/arch/x86/numa.hpp",
    "include/ours/arch/x86/page_table.hpp",
    "include/ours/arch/x86/percpu.hpp",
    "include/ours/arch/x86/time.hpp",
  ]

  # ours/arch/x86/page_table.hpp derives from the page-table walks' base, so
  # whoever includes it needs that library's headers.
  public_deps = [ "//kernel/arch/x86/lib/page_tables" ]
}
