import("//kernel/phys/phys_executable.gni")

# boot-shim: the actual file GRUB boots via Multiboot2.  It is the only
# thing in this tree that understands Multiboot2 at all -- it parses the
# handoff, finds the OBI container GRUB also loaded as a module, loads
# physload out of that container's item 0, and jumps to it.  Downstream of
# that jump, only OBI's own vocabulary exists.
#
# Unlike physload (physload.link, ET_DYN, placed by boot-shim at an address
# only known at boot), boot-shim keeps the default phys.link: a fixed load
# address is what GRUB's Multiboot2 loading actually needs, since nothing
# upstream of boot-shim relocates it.
#
# Only exists in the kernel.phys toolchain family, same as phys_executable
# itself: no toolchain judgment here or in the template.  A caller outside
# that family (//kernel/products/image/fake, say) reaches this with an
# explicit toolchain-qualified label.
phys_executable("bootshim") {
  output_dir = target_out_dir
  output_extension = "bin"
  release_output = true
  deps = [
    "//kernel/arch/x86/phys:bootshim",
    "//kernel/phys:bootshim.core",
  ]
}
