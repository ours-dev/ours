import("//build/config/link_config.gni")
import("//build/cpp/cpp_interface.gni")

# Arch support for physload: its page tables, boot memory and console.  A
# physload_module() links none of this; it binds what it needs against
# physload's export table at load time (ours/phys/exports.hpp), so there is
# one console list, one page table and one boot-memory allocator.
if (toolchain_environment == "kernel.phys") {
  source_set("riscv") {
    sources = [
      "aspace.cpp",
      "memory.cpp",
      "sbi_console.cpp",
    ]

    # These sources end up in physload's ET_DYN link, which is what
    # phys-module's -fPIC is for.
    configs += [ "//kernel/phys:phys-module" ]
    deps = [ "//system/lib/logz4:headers" ]
    public_deps = [
      ":headers",
      "//kernel/arch/riscv:headers",

      # physload's address-space code reads the kernel's layout.
      "//kernel/arch/riscv/kernel:headers",
      "//kernel/phys:headers",
    ]
    visibility = [ "*" ]
  }
}

# The shim runs where it is loaded, at 0x80200000, which is outside
# the +-2 GiB around address zero that the default code model can reach.
# medany generates pc-relative addressing, so the code works wherever it is
# placed.
config("phys.model") {
  cflags = [ "-mcmodel=medany" ]
  asmflags = cflags
}

# The boot shim is linked at a fixed address, where QEMU's `virt` machine
# loads a flat image: the first 2 MiB boundary above the end of the firmware,
# which sits at the start of RAM (0x80000000) and is smaller than 2 MiB. That
# is a fact of the platform, not of any one firmware: another SBI
# implementation of that size lands the shim at the same address, and a board
# whose RAM starts elsewhere needs another one.
link_config("bootshim.link") {
  link_script = "//kernel/phys/phys.ld"
  symbols = [ "PHYS_LOAD_ADDRESS=0x80200000" ]
}

# The riscv boot shim: the firmware's entry point and what runs first.  It
# reads the device tree, then loads physload out of the initrd and calls it;
# see bootshim/shim.cpp.  Like the x86 shim it links its own copy of the
# phys runtime pieces it needs before physload exists (bootshim.core: the ELF
# loader, a console list, panic) and its own console, compiled again here
# without physload's -fPIC.
if (toolchain_environment == "kernel.phys") {
  source_set("bootshim") {
    sources = [
      "bootshim/shim.cpp",
      "sbi_console.cpp",
      "start.S",
    ]
    configs += [ ":phys.model" ]
    deps = [
      ":headers",
      "//kernel/lib/ccrt",
      "//kernel/phys:bootshim.core",

      # The machine-independent half of this shim: the device tree reader
      # and its conversion into the memory map, kept where a host test can
      # reach them.
      "//kernel/phys/lib/bootshim",
      "//kernel/phys/lib/fdt",
      "//system/lib/logz4:headers",

      # memcmp, memchr and strlen: std::string_view's comparisons and
      # searches, which the tree reader is built on, reach them; memcpy and
      # memset: the ELF loader's copy of physload.
      "//system/lib/libc",
    ]
    public_deps = [
      "//kernel/arch/riscv:headers",

      # LegacyPlatformInfo, what the shim hands physload.
      "//kernel/phys:headers",
    ]
    visibility = [ "*" ]
  }
}

cpp_interface("headers") {
  public = [
    "include/ours/phys/arch_bootmem.hpp",
    "include/ours/phys/arch_handoff.hpp",
    "include/ours/phys/arch_paging.hpp",
  ]
  public_deps = [
    # arch_paging.hpp names the Sv39 scheme from riscv's arch headers.
    "//kernel/arch/riscv:headers",
    "//kernel/phys/lib/bootmem:headers",
  ]
}

group("tests") {
  testonly = true
}
