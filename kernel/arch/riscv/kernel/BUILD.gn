import("//build/cpp/cpp_interface.gni")

# Placeholder for the future RISC-V kernel implementation.
if (toolchain_environment == "kernel") {
  source_set("kernel") {
    public_deps = [ ":headers" ]
  }
}

# The kernel's own headers that phys reads too: physboot places the kernel
# image and maps the physmap by the addresses in aspace_layout.hpp.
cpp_interface("headers") {
  public = [ "include/ours/arch/aspace_layout.hpp" ]
}
