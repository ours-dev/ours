# Native kernel compile/link policy.  Artifact construction (physboot, kernel
# packages, validation, and product images) stays in the dedicated templates
# and product targets rather than being exposed through these configs.

import("//build/config/compiler/clang.gni")
import("//build/config/current_target_tuple.gni")
import("//build/ours/cpu.gni")
import("//kernel/kernel_params.gni")

config("headers") {
  include_dirs = [
    "//kernel/include",
    "//system/public",
  ]
  inputs = [ "//kernel/include/ours/prelude.hpp" ]
  cflags = [
    "-include",
    rebase_path(inputs[0], root_build_dir),
  ]
}

config("host-prelude") {
  # Host-built C++（如 obit）会 include system/public/ours/*
  # 头，这些头依赖 prelude.hpp
  # 定义的全局整数别名（u8/u32/usize/...）。内核工具链通过上面的
  # config("headers") 强制 -include prelude；host 工具链的 C++
  # 目标需要同样的 prelude（仅 cflags_cc：prelude 是 C++
  # 头，不能喂给 C 编译）。
  inputs = [ "//kernel/include/ours/prelude.hpp" ]
  cflags_cc = [
    "-include",
    rebase_path(inputs[0], root_build_dir),
  ]
}

config("standalone") {
  configs = [
    "//build/config:freestanding",
    ":debug-only-unwind-tables",
    ":kernel-heap-alignment",
    ":static-pic-link",
  ]
}

config("static-pic-link") {
  configs = [ "//build/config:static-link" ]

  # The compiler runtime is a link input, not a driver option. clang emits
  # calls into it -- __udivti3 and friends, today from libc++'s std::format,
  # whose integer formatter is instantiated for unsigned __int128 whether or
  # not anything prints one -- with no call site in the source to show for
  # it, and -nostdlib below drops it along with libc. Naming the archive is what
  # brings it back: this links with ld.lld directly, so -rtlib=compiler-rt
  # would never be seen by the driver that understands it.
  inputs = [
    "//kernel/include/ours/hidden.hpp",
    "$clang_runtime_lib_dir/$current_target_tuple/libclang_rt.builtins.a",
  ]
  cflags = [
    "-include",
    rebase_path(inputs[0], root_build_dir),
  ]
  ldflags = [
    "-nostdlib",
    rebase_path(inputs[1], root_build_dir),
  ]
}

config("debug-only-unwind-tables") {
  inputs = [ "//kernel/debug_frame.S" ]
  cflags = [ "-fno-unwind-tables" ]
  asmflags = [
    "-include",
    rebase_path(inputs[0], root_build_dir),
  ]
}

# The sampling profiler unwinds kernel frames from .eh_frame, which clang
# does not emit for the freestanding x86_64-unknown-none target unless asked
# to. Switching this off shrinks the image but leaves the profiler with
# depth-1 records.
declare_args() {
  kernel_unwind_tables_enabled = true
}

config("unwind-tables") {
  if (kernel_unwind_tables_enabled) {
    cflags = [ "-fasynchronous-unwind-tables" ]
  }
}

config("kernel-heap-alignment") {
  cflags_cc = [ "-faligned-new=8" ]
}

config("warnings") {
  cflags = [
    "-Wformat=2",
    "-Wmissing-declarations",
    "-Wshadow",
    "-Wvla",
  ]
  cflags_c = [ "-Wmissing-prototypes" ]
}

config("kernel_debug") {
  # The one debug switch. <ours/assert.hpp> turns DEBUG_ASSERT on for any level
  # above 0, and logz4 turns Debug/Trace logging on with it; neither has a
  # define of its own to keep in step.
  defines = [ "KERNEL_DEBUG_LEVEL=$kernel_debug_level" ]
}

config("unit-tests-enabled") {
  if (kernel_unit_tests_enabled) {
    defines = [ "UNITTESTS_ENABLED" ]
  }
}

config("lockdep") {
  defines = []
  if (lockdep_enable) {
    defines += [
      "CONFIG_LOCK_DEP=1",
      "LOCK_DEP_ENABLED_FEATURE_LEVEL=2",
    ]
  } else if (lockdep_metadata_only || lockdep_lock_name_tracing) {
    defines += [
      "CONFIG_LOCK_DEP=1",
      "LOCK_DEP_ENABLED_FEATURE_LEVEL=1",
    ]
  }
}

config("scheduler") {
  assert(sched_normal_discipline == "rr" || sched_normal_discipline == "fair",
         "sched_normal_discipline must be \"rr\" or \"fair\"")
  _sched_normal_is_fair = sched_normal_discipline == "fair"
  defines = [
    "SCHED_HPTICK=$sched_hptick",
    "SCHED_NORMAL_DISCIPLINE_FAIR=$_sched_normal_is_fair",
    "SCHED_DELAY_DEQUEUE=$sched_delay_dequeue",
    "SCHED_EXTRA_INVARIANT_VALIDATION=$sched_extra_invariant_validation",
    "SCHED_UNPARK_PREEMPT=$sched_unpark_preempt",
    "SCHED_NOHZ=$sched_nohz",
  ]
}

config("memory") {
  defines = [
    "MM_NUMA=$mm_numa",
    "MM_NUMA_EMULATION=$mm_numa_emulation",
    "MM_ALLOCATION_POLICY=$mm_allocation_policy",
    "MM_VFLAT_MEMMAP=$mm_vflat_memmap",
  ]
}

config("kernel.config") {
  configs = [
    ":headers",
    ":standalone",
    ":kernel_debug",
    ":lockdep",
    ":scheduler",
    ":memory",
    ":unit-tests-enabled",
    ":warnings",
    "//kernel/arch/$ours_cpu:abi",
    "//kernel/arch/$ours_cpu:kernel",
  ]
  defines = [ "MP_MAX_CPUS=$mp_max_cpus" ] + kernel_extra_defines
  if (cpu_hotplug) {
    defines += [ "CONFIG_CPU_HOTPLUG" ]
  }
  cflags = [ "-fpie" ]
}

config("kernel.link") {
  # The scheduler's discipline registry used to be collected by a separate
  # `INSERT AFTER` fragment, //kernel/kernel/task/task.ld. That could not work:
  # its section was named .init.rodata.schedules, and kernel.ld's own
  # `.init.rodata` output section ends in a `*(.init.rodata*)` catch-all that
  # matched it first, so the entries landed in .init.rodata and the fragment's
  # bounds delimited nothing. The registry is collected in kernel.ld now, with
  # the other three, and the fragment is gone.
  #
  # A kernel image links as a static PIE: physboot loads it at
  # KERNEL_LOAD_BASE + KASLR, so every absolute pointer (the .ccrt_init
  # table, vtables, string tables) needs an R_X86_64_RELATIVE relocation for
  # ElfImage::relocate() to apply. ET_EXEC would bake link-time addresses,
  # which is exactly how the first global constructor jumped to address 0x3020.
  configs = [ "//build/config:pie-link" ]
  inputs = [ "//kernel/kernel.ld" ]
  ldflags = [
    "-Wl,-T," + rebase_path(inputs[0], root_build_dir),
    "-Wl,-defsym,KERNEL_GOT_TOLERANCE=0",
    "-Wl,-defsym,KERNEL_BASE_ADDRESS=0",
  ]
}
