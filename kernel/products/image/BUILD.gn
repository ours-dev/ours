# Kernel image definitions.
#
# Each image is one subdirectory (dev/, dev.dbg_1/, fake/) holding a
# kernel_package (the kernel storage item, which builds the kernel executable
# in the switchset's toolchain), a kernel_cmdline (the image's command line)
# and a kernel_image (the assembled product). A product
# (//products/<name>.gni) only selects an image by label; images are not
# instantiated here.
#
# This file holds only the assembly parts every image shares:
#   common_package_items -- referenced by every product's kernel_package; the
#   bootfs payload all images share (the vDSO, and userboot, the default
#   first user program).

group("common_package_items") {
  visibility = [
    "./*",
    "//products/*",
    "//tests/*",
  ]

  # userboot is user-space payload every image carries, so it hangs off the
  # shared part rather than being declared again in each image -- which is
  # why this group exists.
  #
  # It has to name the user toolchain explicitly: deps are evaluated in the
  # kernel toolchain's context, and without the toolchain suffix kernel-x86
  # would build a "user program" with -mcmodel=kernel. userboot is a file in
  # the kernel package's BootFS, not an OBI item of its own.
  #
  # Only what every image needs goes here. userboot is the program the kernel
  # always starts first, and the vDSO is the only code that can enter the
  # kernel; both qualify. An image that wants to run another program declares
  # it in its own kernel_package (see ./dev/BUILD.gn) rather than pushing that
  # program into this shared group -- //examples/shell once lived here, so
  # every product, every image, even the //tests/* smoke images had to carry
  # a copy of the sample program, and which one to run was left for the
  # kernel to guess from the package.
  deps = [
    "//kernel/lib/userabi/userboot(//build/toolchain/ours:user-${target_cpu})",
    "//kernel/lib/userabi/vdso(//build/toolchain/ours:user-${target_cpu})",
  ]
}
