# dev 内核镜像（带单测的开发内核）。
#
# 一个镜像 = 一个子目录， 内含
# kernel_package（内核存储块，按 switchset
# 工具链编译内核可执行文件）+ kernel_cmdline（镜像级
# cmdline）+ kernel_image（组装产物）。产品
# （//products/<name>.gni）只按 label 选择，不在这里实例化。
#
# 产物：$root_out_dir/kernel.dev.obi（默认扁平输出在 out 根）。

import("//build/obi/kernel_cmdline.gni")
import("//build/product/ours_args.gni")
import("//kernel/kernel_image.gni")
import("//kernel/kernel_package.gni")
import("//kernel/user_bootfs.gni")
import("//system/component_manifest.gni")

# The user programs this image carries: its boot flow first, then whatever
# the build adds through `ours.with` (//build/product/ours_args.gni;
# tools/set.py --with).
#
# The boot flow is this image's own and is not a per-build choice -- userboot
# starts init, init starts what meta/root.cm names -- so that what boots
# does not depend on how the build was configured. `ours.with` adds to this
# list and never replaces it: a program it names is built and packaged, and
# runs when something running starts it.
_user_programs = [
  # The first system service and the root of the component tree. It is what
  # userboot starts in this image (userboot.next in the cmdline below), and
  # it starts the components meta/root.cm names (root.cm below), which bring
  # their own programs into the BootFS.
  "//system/service/init",

  # The sampling profiler, which the shell starts in its checks
  # (check_profile()); it reaches the Sampling resource through the
  # namespace the shell hands on. Not a component, so root.cm does not bring
  # it.
  "//examples/profile",
]

if (defined(ours.with)) {
  # A program already in the boot flow is skipped rather than listed twice,
  # so naming one in --with is harmless instead of a duplicate-dependency
  # error.
  foreach(program, ours.with) {
    if (filter_include(_user_programs, [ program ]) == []) {
      _user_programs += [ program ]
    }
  }
}

# The root manifest, meta/root.cm (component-framework design D5): the
# component tree init grows from on this image. It has children and no
# program. The root starts them in this order, one after another:
#   - routing_checks, the root's on-target test, which uses the built-in
#     `boot` the four ways offered here: whole with rx*, renamed with `as` and
#     r*, through a subdir of its own use, and once through an offer narrower
#     than its use, which the root answers AccessDenied; and the built-in
#     protocols ours.process.Launcher, ours.resource.Debug and
#     ours.resource.Sampling through its /svc, with ours.resource.Irq and
#     ours.resource.Ioport, the roots of the
#     interrupt lines and the I/O ports, which only it and pc-ps2 are offered;
#   - echo (//examples/echo), which provides ours.examples.echo.Echo, and
#     which routing_checks reaches under another name through an offer from
#     its sibling: the route through echo's expose and into its outgoing
#     directory;
#   - shell, the serial console's shell, with /boot rx* and the same three
#     protocols: it runs its commands through the Launcher, reads the
#     console with the resource ours.resource.Debug gives it, and holds
#     ours.resource.Sampling for the profiler it starts
#     (//system/app/shell's shell.cm);
#   - pc-ps2, the PS/2 keyboard driver (//system/driver/pc-ps2), with
#     ours.resource.Irq and ours.resource.Ioport alone: it takes the
#     keyboard's interrupt line and the i8042's ports with them, and logs
#     each key.
component_manifest("root.cm") {
  visibility = [ ":*" ]
  children = [
    {
      name = "routing_checks"
      manifest = "//system/service/init/test/routing_checks:routing_checks.cm"
      startup = "eager"
    },
    {
      name = "echo"
      manifest = "//examples/echo:echo.cm"
      startup = "eager"
    },
    {
      name = "shell"
      manifest = "//system/app/shell:shell.cm"
      startup = "eager"
    },
    {
      name = "pc-ps2"
      manifest = "//system/driver/pc-ps2:pc-ps2.cm"
      startup = "eager"
    },
  ]
  manifest = {
    offer = [
      # /boot, and for routing_checks, through its own use's subdir, /bin.
      {
        directory = "boot"
        from = "parent"
        to = [
          "#routing_checks",
          "#shell",
        ]
        rights = [ "rx*" ]
      },

      # The same directory under another name, with fewer rights.
      {
        directory = "boot"
        from = "parent"
        to = "#routing_checks"
        as = "boot-r"
        rights = [ "r*" ]
      },

      # r* where the use asks rx*: the route answers AccessDenied here.
      {
        directory = "boot"
        from = "parent"
        to = "#routing_checks"
        as = "denied"
        rights = [ "r*" ]
      },

      # The root's built-in protocols, which routing_checks and shell reach
      # through their /svc. routing_checks' ours.test.Unoffered is offered by
      # nobody.
      {
        protocol = [
          "ours.process.Launcher",
          "ours.resource.Debug",
          "ours.resource.Sampling",
        ]
        from = "parent"
        to = [
          "#routing_checks",
          "#shell",
        ]
      },

      # The roots of the interrupt lines and the I/O ports, to the keyboard
      # driver, and to routing_checks, which takes a line and a port with
      # them as a driver would. The root asks nothing else of a component
      # that reaches them: routing is the only gate, so a component holds
      # them only if an offer here leads to it.
      {
        protocol = [
          "ours.resource.Irq",
          "ours.resource.Ioport",
        ]
        from = "parent"
        to = [
          "#routing_checks",
          "#pc-ps2",
        ]
      },

      # echo's protocol, from the sibling that exposes it, renamed on the
      # way: echo serves it as ours.examples.echo.Echo, and routing_checks
      # finds it at /svc/ours.test.Echo.
      {
        protocol = "ours.examples.echo.Echo"
        from = "#echo"
        to = "#routing_checks"
        as = "ours.test.Echo"
      },
    ]
  }
}

# 内核存储块：共享配方 + 带单测的内核可执行文件（dbg.0
# switchset 工具链）。prefix="" ——BootFS
# 顶层是扁平命名空间，内核落在 vmours/image.elf 等顶层路径。
kernel_package("ours") {
  visibility = [
    ":*",
    "//products/*",
  ]

  # 含带单测的内核（vmours.with-tests 是 testonly），必须
  # testonly。
  testonly = true
  prefix = ""
  deps = [
    "..:common_package_items",
    "//kernel/products/bin:vmours.with-tests(//build/switch/set/dbg.0:kernel_${target_cpu}.dbg.0)",
  ]
}

# The BootFS user space boots from, a StorageBootFs item of its own
# (//kernel/user_bootfs.gni): the user programs and the vDSO they bind
# against, and meta/root.cm with every manifest and program of its tree, the
# shell's among them. userboot unpacks it and hands it on; the kernel never
# reads it.
user_bootfs("bootfs") {
  visibility = [ ":*" ]
  testonly = true
  deps = [
    ":root.cm",
    "//kernel/lib/userabi/vdso(//build/toolchain/ours:user-${target_cpu})",
  ]

  # The toolchain suffix is added here, once: without it a program would be
  # built in the kernel toolchain as a -mcmodel=kernel "user program". So the
  # list above takes plain labels, and a label that already names a toolchain
  # is rejected rather than suffixed a second time into something GN cannot
  # parse.
  foreach(program, _user_programs) {
    assert(get_label_info(program, "toolchain") == current_toolchain,
           "ours.with takes plain labels without a toolchain suffix: $program")
    deps += [ "$program(//build/toolchain/ours:user-${target_cpu})" ]
  }
}

# The image-level kernel cmdline. `userboot.next` names the program userboot
# starts next: init, which takes the root job userboot hands it and starts the
# components of meta/root.cm under it, the shell among them
# (docs/design/261004/component-framework.md). Fixed here rather than
# taken from a build argument: the boot flow belongs to the image (see
# _user_programs at the top of this file).
#
# The first user process is always userboot -- kernel.select.userboot is left
# unset, so it takes its default -- and init no longer runs in its place. The
# kernel does not parse `userboot.next`: it forwards every `userboot.*` token
# as an environment string in userboot's processargs
# (collect_user_options() in kernel/lib/userabi/src/userboot.cpp), and
# the userboot program reads it (kernel/lib/userabi/userboot/userboot.cpp).
# Without this line userboot only says hello and halts.
#
# The value is a file name in the user BootFS, not a label: user_executable()
# installs init as `bin/init` (//system/user_executable.gni), one bare file
# rather than an `init/` subtree since a user program has no code-patches.
#
# `kernel.shell=true` would start the kernel shell on COM1 (the option is
# off by default; see ours::boot::BootOptions::shell()). This image leaves it
# off: its COM1 belongs to the user shell the root starts. dev.dbg_1 is the
# image with the kernel shell (kernel/lib/kshell/README.md).
kernel_cmdline("cmdline") {
  visibility = [
    ":*",
    "//products/*",
  ]
  args = [
    "userboot.next=bin/init",
    "kernel.shell=false",
    "kernel.debug_read=true",

    # 16 KiB at 64 MiB for the panic crash record. Phys reserves it on every
    # boot; it lies above the range OVMF unpacks its DXE volume into on each
    # boot (from 9 MiB) and far below the top of RAM, where OVMF keeps its own
    # memory. See .agents/tasks/panic-crashlog/DESIGN.md.
    "kernel.crashlog=0x4000@0x4000000",
  ]

  # A build's own program to run once the shell is up (ours.autorun,
  # //build/product/ours_args.gni). Last, because init takes the last
  # `ours.autorun.boot` it sees, so an entry here overrides any the image might
  # carry in future rather than being overridden by it.
  if (defined(ours.autorun)) {
    _autorun = ours.autorun
    args += [ "ours.autorun.boot=$_autorun" ]
  }
}

# dev 镜像：physload 以 stripped ELF 进入 OBI item 0（x86 boot shim
# 从容器 里加载它）；GRUB 双文件流程的 physload.bin
# 仍照常发布。rsp 顺序 = kernel_image deps 的后序 DFS，physload
# 声明在首位即 item 0（--bootable 在打包期断言该拓扑）。
kernel_image("dev") {
  visibility = [ "//products/*" ]
  testonly = true

  # The artifact everything else already calls it: //BUILD.gn,
  # products/README.md, products/bringup/BUILD.gn and the comment above all say
  # kernel.dev.obi, but without this the image took its basename from the target
  # name and landed at dev.obi.
  output_name = "kernel.dev"

  # Order is the OBI topology, and physload was missing from it entirely --
  # the comment above already described the intended shape, but item 0 came
  # out as the kernel-storage block and obit's --bootable check rejected it.
  # physboot also needs the phys toolchain spelled out, or it resolves in the
  # kernel toolchain and lands at a different path than the packer expects.
  # This mirrors //kernel/products/image/fake, which builds.
  deps = [
    ":bootfs",
    ":cmdline",
    ":ours",
    "//kernel/phys:physload(//build/switch/set/phys.dbg_0:kernel.phys_${target_cpu}.phys.dbg_0)",
    "//kernel/phys/image/physboot(//build/switch/set/phys.dbg_0:kernel.phys_${target_cpu}.phys.dbg_0)",
  ]
}
