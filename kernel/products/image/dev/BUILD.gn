# dev 内核镜像（带单测的开发内核）。
#
# 对标 Fuchsia //zircon/kernel/image/user/BUILD.gn：一个镜像 =
# 一个子目录， 内含 kernel_package（内核存储块，按 switchset
# 工具链编译内核可执行文件）+ kernel_cmdline（镜像级
# cmdline）+ kernel_image（组装产物）。产品
# （//products/<name>.gni）只按 label 选择，不在这里实例化。
#
# 产物：$root_out_dir/kernel.dev.obi（默认扁平输出在 out 根）。

import("//build/obi/kernel_cmdline.gni")
import("//build/product/ours_args.gni")
import("//kernel/kernel_image.gni")
import("//kernel/kernel_package.gni")

# The user programs this image carries, and which one userboot starts. Both
# can be replaced per build through the `ours` argument bundle
# (//build/product/ours_args.gni; tools/set.py --with/--next); what
# follows are this image's own defaults.
if (defined(ours.with)) {
  _user_programs = ours.with
} else {
  _user_programs = [
    # 示例 shell。它不再是这个镜像的第一个用户程序 ——
    # 那是下面的 init —— 而是 init 用 process_spawn_boot
    # 起的第二个，所以仍要打进包里。
    # 它不在共享零件里，因为「包里有哪些程序」是镜像的属性。
    "//examples/shell",

    # The first system service. It is what userboot starts in this image
    # (userboot.next in the cmdline below), and it starts the shell above with
    # process_spawn_boot -- which is why the shell is still packaged.
    "//system/service/init",
  ]
}

if (defined(ours.next)) {
  _next = ours.next
} else {
  _next = "init"
}

# 内核存储块：共享配方 + 带单测的内核可执行文件（dbg.0
# switchset 工具链，对标 Fuchsia kernel_package("zircon") 的 deps
# 写法）。prefix="" ——BootFS 顶层是扁平命名空间，内核落在
# vmours/image.elf 等顶层路径。
kernel_package("ours") {
  # This package carries the image's user programs, so it carries the
  # whitelist of what user space may see (//kernel/kernel_package.gni).
  user_bootfs = true

  visibility = [
    ":*",
    "//products/*",
  ]

  # 含带单测的内核（vmours.with-tests 是 testonly），必须
  # testonly。
  testonly = true
  prefix = ""
  deps = [
    "..:common_package_items",
    "//kernel/products/bin:vmours.with-tests(//build/switch/set/dbg.0:kernel_${target_cpu}.dbg.0)",
  ]

  # 工具链后缀在这里统一补上：不写就会在内核工具链里编出一个
  # -mcmodel=kernel 的“用户程序”。So the list above takes plain
  # labels, and a label that already names a toolchain is rejected rather than
  # suffixed a second time into something GN cannot parse.
  foreach(program, _user_programs) {
    assert(get_label_info(program, "toolchain") == current_toolchain,
           "ours.with takes plain labels without a toolchain suffix: $program")
    deps += [ "$program(//build/toolchain/ours:user-${target_cpu})" ]
  }
}

# The image-level kernel cmdline. `userboot.next` names the program userboot
# starts next: init by default, which takes the root job userboot hands it
# and starts the shell with it (P0's first vertical slice,
# docs/design/260923/userspace-interface.md section 5). ours.next overrides
# the name (see _next at the top of this file).
#
# The first user process is always userboot -- kernel.select.userboot is left
# unset, so it takes its default -- and init no longer runs in its place. The
# kernel does not parse `userboot.next`: it forwards every `userboot.*` token
# as an environment string in userboot's processargs
# (collect_userboot_options() in kernel/lib/userabi/src/userboot.cpp), and
# the userboot program reads it (kernel/lib/userabi/userboot/userboot.cpp),
# as Zircon's userboot reads its own userboot.next. Without this line
# userboot only says hello and halts.
#
# The value is a file name in the BootFS, not a label:
# kernel_elf_binary("shell") sets has_patches = false, so it lands as a bare
# `shell` file rather than a `shell/` subtree.
#
# `kernel.shell=true` starts the kernel shell on COM1 (the option is off by
# default, as in Zircon; see ours::boot::BootOptions::shell()). This image is
# driven through that console in automated runs -- prof.start/stop/dump
# (kernel/lib/kshell/README.md), mutex.stress -- so it asks for it.
kernel_cmdline("cmdline") {
  visibility = [
    ":*",
    "//products/*",
  ]
  args = [
    "userboot.next=$_next",
    "kernel.shell=true",
  ]
}

# dev 镜像：physload 以 stripped ELF 进入 OBI item 0（x86 boot shim
# 从容器 里加载它）；GRUB 双文件流程的 physload.bin
# 仍照常发布。rsp 顺序 = kernel_image deps 的后序 DFS，physload
# 声明在首位即 item 0（--bootable 在打包期断言该拓扑）。
kernel_image("dev") {
  visibility = [ "//products/*" ]
  testonly = true

  # The artifact everything else already calls it: //BUILD.gn,
  # products/README.md, products/bringup/BUILD.gn and the comment above all say
  # kernel.dev.obi, but without this the image took its basename from the target
  # name and landed at dev.obi.
  output_name = "kernel.dev"

  # Order is the OBI topology, and physload was missing from it entirely --
  # the comment above already described the intended shape, but item 0 came
  # out as the kernel-storage block and obit's --bootable check rejected it.
  # physboot also needs the phys toolchain spelled out, or it resolves in the
  # kernel toolchain and lands at a different path than the packer expects.
  # This mirrors //kernel/products/image/fake, which builds.
  deps = [
    ":cmdline",
    ":ours",
    "//kernel/phys:physload(//build/switch/set/phys.dbg_0:kernel.phys_${target_cpu}.phys.dbg_0)",
    "//kernel/phys/image/physboot(//build/switch/set/phys.dbg_0:kernel.phys_${target_cpu}.phys.dbg_0)",
  ]
}
