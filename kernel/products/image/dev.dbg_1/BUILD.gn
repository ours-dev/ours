# kernel.dev.dbg_1 内核镜像（无单测的调试镜像，dev 的对照）。
#
# 同
# //kernel/products/image/kernel.dev/：镜像本体定义在这里，产品只选择。
#
# 产物：$root_out_dir/kernel.dev.dbg_1.obi（默认扁平输出在 out
# 根）。

import("//build/obi/kernel_cmdline.gni")
import("//kernel/kernel_image.gni")
import("//kernel/kernel_package.gni")
import("//kernel/user_bootfs.gni")

kernel_package("ours") {
  # This package carries the image's user programs, so it carries the
  # whitelist of what user space may see (//kernel/kernel_package.gni).
  user_bootfs = true

  visibility = [
    ":*",
    "//products/*",
  ]
  prefix = ""
  deps = [
    "..:common_package_items",

    # dbg.1, not dbg.0 -- the whole point of this image is the diagnostics
    # kernel_debug_level 1 turns on (KERNEL_DEBUG_LEVEL=1, and with it
    # DEBUG_ASSERT and logz4's Debug/Trace levels).
    # Built against dbg.0 it was a byte-for-byte policy twin of kernel.dev.
    "//kernel/products/bin:vmours(//build/switch/set/dbg.1:kernel_${target_cpu}.dbg.1)",

    # 这个镜像里 userboot 启动的程序：示例
    # shell。它不在共享零件里，因为「跑哪个程序」
    # 是镜像的属性 —— 由本镜像声明它，再由下面 cmdline 的
    # userboot.next 指名它。工具链后缀同上：
    # 不写就会在内核工具链里编出一个 -mcmodel=kernel
    # 的“用户程序”。
    "//examples/shell(//build/toolchain/ours:user-${target_cpu})",

    # lib/syscall's test: the program the shell starts and watches die, one
    # probe at a time (examples/shell/shell.cpp, run_probes()). Here only:
    # this is the image whose shell holds the root job, and the one with
    # DEBUG_ASSERT on, so the kill path runs under every assertion it has.
    "//kernel/lib/syscall/test/fault_probe(//build/toolchain/ours:user-${target_cpu})",
  ]
}

# The BootFS user space boots from, a StorageBootFs item of its own
# (//kernel/user_bootfs.gni): the shell, fault_probe and the vDSO. Nothing
# reads it yet; see //kernel/products/image/dev/BUILD.gn.
user_bootfs("bootfs") {
  visibility = [ ":*" ]
  deps = [
    "//examples/shell(//build/toolchain/ours:user-${target_cpu})",
    "//kernel/lib/syscall/test/fault_probe(//build/toolchain/ours:user-${target_cpu})",
    "//kernel/lib/userabi/vdso(//build/toolchain/ours:user-${target_cpu})",
  ]
}

# The image-level kernel cmdline. `userboot.next=shell` names the program
# userboot starts next.
#
# The first user process is always userboot (kernel.select.userboot is left
# at its default). It hands the root job and the BootFS on to the shell, so
# the shell starts with exactly what it had when the kernel started it
# directly. Zircon's userboot.next; the mechanism is described at the same
# place in //kernel/products/image/dev.
#
# The value is a file name in the BootFS, not a label:
# kernel_elf_binary("shell") sets has_patches = false, so it lands as a bare
# `shell` file rather than a `shell/` subtree.
#
# `kernel.shell=true`: the kernel shell is off by default (see
# //kernel/products/image/dev), and this image had it before the option
# existed, so it keeps it.
kernel_cmdline("cmdline") {
  visibility = [
    ":*",
    "//products/*",
  ]
  args = [
    "userboot.next=shell",
    "kernel.shell=true",
  ]
}

kernel_image("dev.dbg_1") {
  visibility = [ "//products/*" ]

  # See //kernel/products/image/dev: the documented name is
  # kernel.dev.dbg_1.obi.
  output_name = "kernel.dev.dbg_1"

  # Same topology fix as //kernel/products/image/dev: physload has to be item
  # 0 for obit's --bootable check, and physboot has to name the phys toolchain.
  deps = [
    ":bootfs",
    ":cmdline",
    ":ours",
    "//kernel/phys:physload(//build/switch/set/phys.dbg_0:kernel.phys_${target_cpu}.phys.dbg_0)",
    "//kernel/phys/image/physboot(//build/switch/set/phys.dbg_0:kernel.phys_${target_cpu}.phys.dbg_0)",
  ]
}
