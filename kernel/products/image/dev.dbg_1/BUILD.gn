# kernel.dev.dbg_1 内核镜像（无单测的调试镜像，dev 的对照）。
#
# 同 //kernel/products/image/kernel.dev/：镜像本体定义在这里，产品只选择。
#
# 产物：$root_out_dir/kernel.dev.dbg_1.obi（默认扁平输出在 out 根）。

import("//build/obi/kernel_cmdline.gni")
import("//kernel/kernel_image.gni")
import("//kernel/kernel_package.gni")

kernel_package("ours") {
  visibility = [ ":*", "//products/*" ]
  prefix = ""
  deps = [
    "..:common_package_items",
    # dbg.1, not dbg.0 -- the whole point of this image is the diagnostics
    # kernel_debug_level 1 turns on (KERNEL_DEBUG_LEVEL=1, and with it
    # DEBUG_ASSERT and logz4's Debug/Trace levels).
    # Built against dbg.0 it was a byte-for-byte policy twin of kernel.dev.
    "//kernel/products/bin:vmours(//build/switch/set/dbg.1:kernel_${target_cpu}.dbg.1)",
  ]
}

kernel_cmdline("cmdline") {
  visibility = [ ":*", "//products/*" ]
  args = []
}

kernel_image("dev.dbg_1") {
  visibility = [ "//products/*" ]

  # See //kernel/products/image/dev: the documented name is kernel.dev.dbg_1.obi.
  output_name = "kernel.dev.dbg_1"

  # Same topology fix as //kernel/products/image/dev: physload has to be item
  # 0 for obit's --bootable check, and physboot has to name the phys toolchain.
  deps = [
    "//kernel/phys:physload(//build/switch/set/phys.dbg_0:kernel.phys_${target_cpu}.phys.dbg_0)",
    ":cmdline",
    ":ours",
    "//kernel/phys/image/physboot(//build/switch/set/phys.dbg_0:kernel.phys_${target_cpu}.phys.dbg_0)",
  ]
}
