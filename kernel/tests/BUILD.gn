import("kernel_test.gni")

# The interface's own smoke tests: the KTEST declaration, the assertion
# families and the skip state, run inside a booted kernel. Subsystem tests
# arrive here as they migrate from console commands.
kernel_test("framework") {
  sources = [ "ktest_test.cpp" ]
}

# Kernel tests and the interface that runs them. The tests themselves arrive
# as they migrate from console commands; the aggregate label is what
# vmours.with-tests links, so its dependencies are the test interface and one
# kernel_test() target per area.
source_set("kernel.tests") {
  testonly = true
  deps = [
    ":framework",
    "//kernel/lib/ktest",
  ]
}
