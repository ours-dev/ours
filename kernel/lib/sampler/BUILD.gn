import("//build/cpp/cpp_interface.gni")

# The sampling profiler, in two halves.
#
# :sampler is the session a Sampler object stands for, its per-CPU
# timers and what it records into. It is built on the kernel's timers, IPIs
# and locks, so it is kernel-only and has no host tests.
#
# :core turns a stack into addresses and stores them: the KernelUnwinder,
# the frame-pointer walk, the Recorder with its per-CPU buffers, and the
# dump's format. It makes no call into the kernel and takes every fact as an
# argument, so it builds in the host toolchain too, where its tests and
# prof-fold (cli/) run.
if (toolchain_environment == "kernel") {
  source_set("sampler") {
    sources = [ "src/session.cpp" ]
    public_deps = [ ":headers" ]
    deps = [
      ":core",
      "//kernel/lib/gktl:headers",
      "//kernel/lib/heap",
      "//kernel/lib/ktl:headers",
      "//kernel/lib/unwind:headers",
      "//kernel/lib/user_copy",

      # current_pid(): a thread's process, through its user thread.
      "//kernel/object:headers",
      "//system/lib/logz4:headers",
    ]
    visibility = [ "*" ]
  }

  # The headers are a target of their own so that a dependant needing only
  # the declarations does not pull in the sources -- see
  # //build/cpp/cpp_interface.gni. Kernel-only like the session: they reach
  # //kernel/mm, which only a kernel toolchain can load, and the tests'
  # group loads this file in the default toolchain too.
  cpp_interface("headers") {
    public = [ "include/sampler/session.hpp" ]
    public_deps = [
      ":core.headers",
      ":request",
      "//kernel/mm:headers",
      "//system/lib/lockdep",
      "//system/public",
    ]
    visibility = [ "*" ]
  }
}

# The request a sampling tick leaves on a thread, alone: the thread holds it
# by value, so the task layer needs the complete type, and nothing else of
# the sampler.
cpp_interface("request") {
  public = [ "include/sampler/stack_sample_request.hpp" ]
  visibility = [ "*" ]
}

# The host-testable core. kernel_unwinder.cpp calls into the unwinder, not
# just its headers, so a consumer linking this needs //kernel/lib/unwind's
# objects on its link line too.
source_set("core") {
  sources = [
    "src/dump.cpp",
    "src/frame_pointers.cpp",
    "src/kernel_unwinder.cpp",
    "src/recorder.cpp",
  ]
  public_deps = [
    ":core.headers",
    "//kernel/lib/unwind",
  ]
  visibility = [ "*" ]
}

cpp_interface("core.headers") {
  public = [
    "include/sampler/buffer.hpp",
    "include/sampler/format.hpp",
    "include/sampler/frame_pointers.hpp",
    "include/sampler/kernel_unwinder.hpp",
    "include/sampler/record_buffer.hpp",
    "include/sampler/recorder.hpp",
    "include/sampler/sink.hpp",
    "include/sampler/stack_window.hpp",
  ]
  public_deps = [
    "//kernel/lib/unwind:headers",
    "//system/lib/ustl:headers",
    "//system/public",
  ]
  visibility = [ "*" ]
}

# Host unit tests; wired into //:default.
group("tests") {
  testonly = true
  public_deps = [
    "test:format($host_toolchain)",
    "test:recorder($host_toolchain)",
    "test:stacks($host_toolchain)",
  ]
}
