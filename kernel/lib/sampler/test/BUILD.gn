import("//build/cpp/host_test.gni")

host_test("format") {
  sources = [ "format_test.cpp" ]
  deps = [
    "//kernel/lib/sampler:core.headers",
    "//vendor/googletest:gtest",
    "//vendor/googletest:gtest_main",
  ]
  visibility = [ "*" ]
}

# Exercises sampler::Recorder's own logic (buffer selection, dump encoding)
# with no kernel underneath: every input comes in through SampleContext and
# addresses, and every dump line leaves through a LineWriter. Depends on
# :core, not just its headers, since it links the Recorder's method bodies.
host_test("recorder") {
  sources = [ "recorder_test.cpp" ]
  deps = [
    "//kernel/lib/sampler:core",
    "//vendor/googletest:gtest",
    "//vendor/googletest:gtest_main",
  ]
  visibility = [ "*" ]
}

# How a stack becomes addresses: the KernelUnwinder's verdict on where a
# kernel stack ends, the StackWindow that bounds its reads, and the
# frame-pointer walk over a fake reader.
host_test("stacks") {
  sources = [ "stacks_test.cpp" ]
  deps = [
    "//kernel/lib/sampler:core",
    "//kernel/lib/unwind/test:eh_frame_builder",
    "//vendor/googletest:gtest",
    "//vendor/googletest:gtest_main",
  ]
  visibility = [ "*" ]
}
