# Exercises sampler::Recorder's own logic (state machine, buffer selection,
# dump encoding) with no kernel underneath: every input comes in through
# SampleContext and every dump line leaves through a LineWriter. Depends on
# :core, not just its headers, since it links the Recorder's method bodies.
executable("recorder") {
  testonly = true
  sources = [ "recorder_test.cpp" ]
  deps = [
    "//kernel/lib/sampler:core",
    "//vendor/googletest:gtest",
    "//vendor/googletest:gtest_main",
  ]
  visibility = [ "*" ]
}
