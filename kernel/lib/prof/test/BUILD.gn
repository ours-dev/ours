# Exercises prof::Sampler's own logic (state machine, buffer selection,
# dump encoding) with no kernel underneath: every input comes in through
# SampleContext and every dump line leaves through a LineWriter. Depends on
# the full //kernel/lib/prof target, not just :headers, since it links
# Sampler's actual method bodies.
executable("sampler") {
  testonly = true
  sources = [ "sampler_test.cpp" ]
  deps = [
    "//kernel/lib/prof",
    "//vendor/googletest:gtest",
    "//vendor/googletest:gtest_main",
  ]
  visibility = [ "*" ]
}
