import("//build/cpp/cpp_interface.gni")

# What a sampler and a tracer have in common: per-CPU record buffers over
# storage the caller supplies (record_buffer.hpp), a sink over them with
# hex-line export (sink.hpp), and the trace sites a tracer will drive
# (trace.hpp). Header-only. The sampler itself -- its recorder, its dump and
# prof-fold -- is //kernel/lib/thread_sampler's.
cpp_interface("headers") {
  public = [
    "include/prof/record_buffer.hpp",
    "include/prof/sink.hpp",
    "include/prof/trace.hpp",
  ]
  public_deps = [
    "//system/lib/ustl:headers",
    "//system/public",
  ]
  visibility = [ "*" ]
}

