# Host unit tests for the kernel heap.
#
# Same convention as //kernel/mm/tests: built with the host toolchain and run
# on the build machine, no kernel boot. Only the parts that touch no kernel
# global can be tested this way, which is exactly why the vmalloc window's
# address bookkeeping is a class of its own.
executable("vmalloc-arena-smoke") {
  testonly = true
  sources = [
    "vmalloc_arena_smoke.cpp",
    "//kernel/lib/heap/vmalloc_arena.cpp",
  ]
  # The mm headers ride in through the generated include-path config rather
  # than //kernel/mm:headers, whose //kernel/phys:handoff dep does not
  # evaluate under the host toolchain these tests build in.
  configs += [ "//kernel/mm:headers.config" ]
  include_dirs = [ "//kernel/lib/heap/include" ]
  deps = [
    "//kernel/arch/x86:headers",
    "//kernel/lib/arch:headers",
    "//kernel/lib/gktl:headers",
    "//kernel/lib/ktl:headers",
    "//system/lib/ustl:headers",
    "//system/public",
  ]
  visibility = [ "*" ]
}

group("tests") {
  testonly = true
  public_deps = [ ":vmalloc-arena-smoke" ]
}
