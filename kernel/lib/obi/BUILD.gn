import("//build/cpp/cpp_interface.gni")

source_set("obi") {
  public_deps = [ ":headers" ]
  visibility = [ "*" ]
}

group("obit") {
  public_deps = [ "cli:obit" ]
  visibility = [ "*" ]
}

cpp_interface("headers") {
  public = [
    "include/obi/checksum.hpp",
    "include/obi/command_line_view.hpp",
    "include/obi/compression.hpp",
    "include/obi/container_view.hpp",
    "include/obi/item_view.hpp",
    "include/obi/memory_config_view.hpp",
    "include/obi/package_builder.hpp",
    "include/obi/package_format.hpp",
  ]
  public_deps = [
    "//kernel/lib/bootfs:headers",
    "//system/lib/ustl:headers",
    "//system/public",
  ]
  visibility = [ "*" ]
}

group("tests") {
  testonly = true
  public_deps = [
    # Plain hosted programs — they must build in the host toolchain; the
    # default toolchain carries target identity (freestanding kernel) and
    # has no hosted libc wiring for them.
    "//kernel/lib/obi/test:boot-options-smoke($host_toolchain)",
    "//kernel/lib/obi/test:cli-smoke($host_toolchain)",
    "//kernel/lib/obi/test:container-view-test($host_toolchain)",
    "//kernel/lib/obi/test:differential-smoke($host_toolchain)",
    "//kernel/lib/obi/test:lz4-wrapper-smoke($host_toolchain)",
    "//kernel/lib/obi/test:memory-config-smoke($host_toolchain)",
    "//kernel/lib/obi/test:obi-smoke($host_toolchain)",
    "//kernel/lib/obi/test:pack-smoke($host_toolchain)",
    "//kernel/lib/obi/test:package-builder-test($host_toolchain)",
    "//kernel/lib/obi/test:parser-fuzz-smoke($host_toolchain)",
  ]

  # The nested-package smoke/view tests were removed with the reverted
  # obi::KernelPackageView/BootPackageView design; the flat StorageKernel
  # BootFS model is covered by phys::KernelPackage / phys::BootObi
  # (//kernel/phys) and phys::KernelPackageLoader.
}

foreach(test_target,
        [
          "kernel-tests",
          "phys-tests",
          "boot_tests",
        ]) {
  group(test_target) {
    testonly = true
  }
}
