import("//build/cpp/host_test.gni")

# The nested obi::KernelPackageView/BootPackageView/PackageView design was
# replaced by the flat StorageKernel BootFS model: obi::KernelPackage,
# obi::BootObi, and phys::KernelPackageLoader.  The old
# kernel-package-smoke/kernel-package-view-test sources for that design were
# removed.

host_test("obi-smoke") {
  sources = [ "smoke.cpp" ]
  deps = [ "//kernel/lib/obi:obi" ]
  visibility = [ "*" ]
}

host_test("memory-config-smoke") {
  sources = [ "memory_config_smoke.cpp" ]
  deps = [ "//kernel/lib/obi:obi" ]
  visibility = [ "*" ]
}

host_test("parser-fuzz-smoke") {
  sources = [ "parser_fuzz_smoke.cpp" ]
  deps = [ "//kernel/lib/obi:obi" ]
  visibility = [ "*" ]
}

host_test("lz4-wrapper-smoke") {
  sources = [ "lz4_wrapper_smoke.cpp" ]
  deps = [ "//kernel/lib/lz4:lz4" ]
  visibility = [ "*" ]
}

host_test("boot-options-smoke") {
  sources = [
    "//kernel/phys/boot_options.cpp",
    "boot_options_smoke.cpp",
  ]
  include_dirs = [ "//kernel/phys/include" ]
  deps = [
    "//kernel/lib/obi:obi",
    "//system/lib/logz4:headers",
  ]
  visibility = [ "*" ]
}

host_test("cli-smoke") {
  sources = [ "cli_smoke.cpp" ]
  deps = [ "//kernel/lib/obi:obi" ]
  visibility = [ "*" ]

  # cli-smoke.cpp textually includes ../cli/main.cpp behind `#define main
  # obit_main` so it can drive the CLI in-process.  Depending on
  # //kernel/lib/obi/cli:obit instead would link a second main(), so the
  # include deliberately has no matching dependency for `gn check` to find.
  check_includes = false
}

host_test("container-view-test") {
  sources = [ "container_view_test.cpp" ]
  deps = [
    "//kernel/lib/obi:obi",
    "//vendor/googletest:gtest",
    "//vendor/googletest:gtest_main",
  ]
  visibility = [ "*" ]
}

host_test("package-builder-test") {
  sources = [ "package_builder_test.cpp" ]
  deps = [
    "//kernel/lib/obi:obi",
    "//vendor/googletest:gtest",
    "//vendor/googletest:gtest_main",
  ]
  visibility = [ "*" ]
}

action("pack-smoke") {
  testonly = true
  deps = [ "//kernel/lib/obi/cli:obit" ]
  script = "pack-smoke.py"
  sources = [
    "pack-smoke.py",
    "//build/obi/pack_action.py",
  ]
  outputs = [ "$target_gen_dir/pack-smoke.stamp" ]
  args = [
    "--stamp",
    rebase_path(outputs[0], root_build_dir),
    "--obit",
    rebase_path(get_label_info("//kernel/lib/obi/cli:obit", "target_out_dir") +
                    "/" +
                    get_label_info("//kernel/lib/obi/cli:obit", "name"),
                root_build_dir),
  ]
  visibility = [ "*" ]
}

action("differential-smoke") {
  testonly = true
  deps = [ "//kernel/lib/obi/cli:obit" ]
  script = "differential-smoke.py"
  sources = [
    "differential-smoke.py",
    "//build/obi/pack_action.py",
  ]
  outputs = [ "$target_gen_dir/differential-smoke.stamp" ]
  args = [
    "--stamp",
    rebase_path(outputs[0], root_build_dir),
    "--obit",
    rebase_path(get_label_info("//kernel/lib/obi/cli:obit", "target_out_dir") +
                    "/" +
                    get_label_info("//kernel/lib/obi/cli:obit", "name"),
                root_build_dir),
  ]
  visibility = [ "*" ]
}
