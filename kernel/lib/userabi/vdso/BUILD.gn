import("//build/toolchain/c_utils.gni")
import("//build/toolchain/toolchain_environment.gni")
import("//kernel/phys/kernel_elf_binary.gni")

assert(
    toolchain_environment == "user",
    "the vDSO runs in ring 3 and must be built in a //build/toolchain/ours:user-* toolchain")

# The vDSO: a shared object whose .dynsym is the kernel's ABI surface.
#
# It was a static PIE, on the grounds that nothing resolved anything against it
# -- the program was handed an export table at e_entry and did its own offset
# arithmetic. A program now *calls* ours_debug_write() and the loader binds it,
# the way a physload_module() binds against physload
# (//kernel/phys/physload_module.gni).
# So this is a shared object, and its symbol table is the export table.
#
# `-shared` and `-static`/`--pie` are mutually exclusive in ld.lld, which is
# why //system:user.config no longer carries the static-PIE link policy; it
# moved to //system:user.executable, which the toolchain applies to
# executables only.
kernel_elf_binary("vdso") {
  # Public, because this is the system ABI: every user_executable() links
  # against the `.binary` subtarget's output to have its imports checked
  # (//system/user_executable.gni), and //kernel/products/image packages the
  # stripped copy. Narrowing it to the two of them would mean naming every
  # future user program's directory here.
  visibility = [ "*" ]

  # Not an executable: no startup files, no link-time closure over its
  # symbols, and -shared from the toolchain's solink_module tool.
  target_type = "loadable_module"

  # Swap the executable link policy for the shared-object one. The subtraction
  # is possible because the toolchain puts the label in
  # default_executable_configs directly, which kernel_elf_binary()'s
  # set_defaults() forwards here.
  configs -= [ "//system:user.executable" ]
  configs += [ "//system:user.shared" ]

  # No .code-patches section: that is a kernel-side facility, and asking for
  # one would only add an empty file to the package. With patches off the ELF
  # is installed as a bare `vdso` file rather than a `vdso/` subtree.
  has_patches = false

  # It goes into both BootFS items of an image. In the kernel package the
  # kernel lays out the one vDSO VMO from it (lay_out_vdso()), which every
  # process maps. In the user BootFS (//kernel/user_bootfs.gni) a user-space
  # loader reads its .dynsym to bind a program's imports: there it is data.

  sources = [ "vdso.S" ]

  # The stubs are generated from //system/public/ours/syscalls.gni; vdso.S
  # holds only the macro they instantiate.
  deps = [ "//system/public:syscalls.private" ]

  # A dependency of the packaged image, not a validation. A validation fails
  # the build but does not hold anything up: ninja may package a mismatched
  # vDSO in parallel and report the failure afterwards, leaving the image on
  # disk. As a data_dep of the image target, everything that packages the
  # vDSO waits for the check to pass. The check reads the linker's output
  # (:vdso.binary), not the image target, so there is no cycle.
  data_deps = [ ":vdso.abi_check" ]

  # No -Wl,-e: nothing jumps to a vDSO, and nothing needs to find anything at
  # its entry point any more. It used to point at the export table, which was
  # how a program with no dynamic linker reached the stubs; the stubs are in
  # .dynsym now and the loader binds against them there.
  ldflags = [
    # Without a SONAME, a linker handed this file on the command line records
    # its build-directory path in the importer's DT_NEEDED. Nothing reads
    # DT_NEEDED here -- every process maps the one vDSO VMO the kernel laid
    # out -- but a path from someone's out/ directory baked into every program
    # is a fact that would be wrong the moment anyone looked at it.
    "-Wl,-soname,libours.so",

    # .dynamic in the read-only segment rather than a writable one of its
    # own, so the vDSO has two loadable segments, read-only and code, and no
    # writable one. Nothing writes a vDSO's .dynamic: it has no dynamic
    # linker and no relocations, and every process maps the same pages. With
    # it writable the ELF claimed a segment the kernel never maps writable.
    "-Wl,-z,rodynamic",
  ]
}

# The exports the linked vDSO actually has, as llvm-ifs reads them out of the
# linker's output -- the copy with section headers, which is what a linker, and
# so a program, would see.
_vdso_file = "$target_out_dir/vdso"
_vdso_ifs = "$target_gen_dir/vdso.actual.ifs"

toolchain_utils_action("vdso.ifs") {
  visibility = [ ":*" ]
  utils = [ "llvm-ifs" ]

  # The template's standard driver: without a script it would hand the
  # llvm-ifs binary itself to python3, which .gn sets as every action's
  # interpreter.
  script = true
  deps = [ ":vdso.binary" ]
  sources = [ _vdso_file ]
  outputs = [ _vdso_ifs ]
  args = [
    "--input-format=ELF",
    "--strip-ifs-target",
    "--output-ifs=" + rebase_path(_vdso_ifs, root_build_dir),
    rebase_path(_vdso_file, root_build_dir),
  ]
}

# Those exports against libours.ifs, which is generated from the description:
# the same SONAME, the same symbols, nothing missing and nothing extra.
action("vdso.abi_check") {
  visibility = [ ":*" ]
  script = "//build/abi/verify_vdso_abi.py"
  _libours = "//system/public:libours($default_toolchain)"
  _expected = get_label_info(_libours, "target_gen_dir") + "/libours.ifs"
  sources = [
    _expected,
    _vdso_ifs,
  ]
  outputs = [ "$target_out_dir/$target_name.ok" ]
  args = rebase_path(sources + outputs, root_build_dir)
  deps = [
    ":vdso.ifs",
    _libours,
  ]
}
