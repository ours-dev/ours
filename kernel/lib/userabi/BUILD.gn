import("//build/cpp/cpp_interface.gni")

# The user-space ABI bring-up library: constructs the first user process
# (userboot) from the kernel side. Everything past ProcessDispatcher::create
# is forward development -- see userboot.cpp.
cpp_interface("headers") {
  public = [ "include/userabi/userboot.hpp" ]
  public_deps = [ "//kernel/object:headers" ]
  visibility = [ "*" ]
}

source_set("userabi") {
  sources = [
    "src/resource.cpp",
    "src/userboot.cpp",
  ]
  public_deps = [ ":headers" ]

  # //kernel/object is the layer this library is supposed to be built out of:
  # kernel/object holds the kernel objects that serve users, and userboot is
  # the first user program, so the path that constructs it should be the path a
  # system call would take on userspace's behalf.
  #
  # //kernel/mm is still here for two things that have no object-layer face
  # yet: get_frames_n(), for the frames the decompressed package and the loaded
  # image live in, and PhysMap, to turn those into the physical address map_phys
  # wants. A VmoDispatcher is what retires both. //kernel/phys:handoff is where
  # the kernel package itself comes from.
  #
  # //kernel/lib/elfload is where loading an ELF lives: this library picks the
  # program and builds the process around it, and hands the ELF itself to a
  # component whose only job that is.
  deps = [
    "//kernel/lib/elfload",
    "//kernel/lib/logz4",
    "//kernel/mm",
    "//kernel/object",
    "//kernel/phys:handoff",
  ]

  visibility = [ "*" ]
}
