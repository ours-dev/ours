import("//build/cpp/cpp_interface.gni")

# The user-space ABI bring-up library: constructs the first user process
# (userboot) from the kernel side. Everything past ProcessDispatcher::create
# is forward development -- see userboot.cpp.
cpp_interface("headers") {
  public = [ "include/userabi/userboot.hpp" ]
  public_deps = [ "//kernel/object:headers" ]
  visibility = [ "*" ]
}

source_set("userabi") {
  sources = [
    "resource.cpp",
    "userboot.cpp",
  ]
  public_deps = [ ":headers" ]

  # userboot.cpp reads the kernel package out of the handoff (//kernel/phys
  # :handoff for ours/boot/handoff.hpp and the KernelPackage/BootFS views it
  # returns) and allocates whole frames for the decompressed copy (//kernel/mm
  # for get_frames_n).
  deps = [
    "//kernel/lib/logz4",
    "//kernel/mm",
    "//kernel/phys:handoff",
  ]

  visibility = [ "*" ]
}
