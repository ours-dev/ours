import("//build/toolchain/toolchain_environment.gni")
import("//kernel/phys/kernel_elf_binary.gni")

# The kernel toolchain would compile this file happily and produce something
# that cannot run in ring 3 (-mcmodel=kernel puts every symbol reference in
# the top 2 GiB of the address space).  Say so at gen time rather than
# leaving it to be discovered as a #GP.
assert(toolchain_environment == "user",
       "userboot must be built in a //build/toolchain/ours:user-* toolchain")

# The same packaging template the kernel image itself uses, so userboot lands
# in the kernel package's BootFS beside vmours/image.elf and the kernel can
# find it there through ours::boot::kernel_package().  Zircon does exactly
# this: userboot is a file in the STORAGE_KERNEL BootFS, not an OBI item of
# its own.
kernel_elf_binary("userboot") {
  visibility = [ "//kernel/products/image/*" ]

  # Code patching rewrites kernel text out of physboot before the kernel
  # runs; a user program has no such section, and asking for one would only
  # add an empty `userboot/code-patches` file to the package.  With patches
  # off, kernel_elf_image() installs the ELF as a bare `userboot` file rather
  # than a `userboot/` subtree.
  has_patches = false

  sources = [ "userboot.cpp" ]
}
