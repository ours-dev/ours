import("//build/toolchain/toolchain_environment.gni")
import("//system/user_executable.gni")

# The kernel toolchain would compile this file happily and produce something
# that cannot run in ring 3 (-mcmodel=kernel puts every symbol reference in
# the top 2 GiB of the address space).  Say so at gen time rather than
# leaving it to be discovered as a #GP.
assert(toolchain_environment == "user",
       "userboot must be built in a //build/toolchain/ours:user-* toolchain")

# A program bound to the vDSO at load time, like every other user program
# (//system/user_executable.gni).  It lands in the kernel package's BootFS
# beside vmours/image.elf, which is where the kernel looks for it by name --
# Zircon does exactly this: userboot is a file in the STORAGE_KERNEL BootFS,
# not an OBI item of its own.
#
# The kernel always starts it first (kernel.select.userboot names another
# build of it, and defaults to this one).  It starts the program the image's
# userboot.next option names, with the user-space launcher out of the BootFS
# (//system/lib/launch), handing on the root job and the BootFS; with
# no userboot.next it only proves the path works -- reach ring 3, read its
# processargs, say so.  It runs on the runtime, as init does, because the
# processargs message is how it learns both what to start and what to start
# it with.
user_executable("userboot") {
  visibility = [ "//kernel/products/image/*" ]

  sources = [ "userboot.cpp" ]
  deps = [
    "//system/lib/launch",
    "//system/lib/ort",
  ]
}
