import("//build/cpp/cpp_interface.gni")
import("//build/ours/cpu.gni")

# The lockup detector: when the machine has stopped, every CPU's registers
# and backtrace, printed once by one CPU through an NMI, then a panic.
#
# Kernel-only. It reads the running thread, the Online mask and the per-CPU
# spin-lock count, and sends NMIs through the architecture, so nothing of it
# builds on the host yet; the tick checker of a later step is the part with a
# pure function to test there.
if (toolchain_environment == "kernel") {
  source_set("lockup_detector") {
    sources = [ "src/report.cpp" ]
    public_deps = [ ":headers" ]
    deps = [
      # ours/task/thread.hpp holds a sampler::StackSampleRequest.
      "//kernel/lib/sampler:request",

      # walk_frame_pointers() and StackWindow, the bounded stack walk.
      "//kernel/lib/sampler:core",
      "//kernel/arch/$ours_cpu:headers",
      "//kernel/lib/gktl:headers",
      "//kernel/mm:headers",
      "//system/lib/logz4:headers",
    ]
    visibility = [ "*" ]
  }
}

# The headers are a target of their own so that a dependant needing only the
# declarations does not pull in the sources -- see
# //build/cpp/cpp_interface.gni.
cpp_interface("headers") {
  public = [ "include/lockup_detector/lockup_detector.hpp" ]
  public_deps = [ "//kernel/lib/arch:headers" ]
  visibility = [ "*" ]
}
