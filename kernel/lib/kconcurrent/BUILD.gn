import("//build/cpp/cpp_interface.gni")

# The kernel specialization of //system/lib/concurrent.
#
# The framework half is environment-free on purpose -- it builds and is tested
# on the host -- so everything that needs a per-CPU slot, an interrupt state or
# a spin hint lives here instead.
source_set("kconcurrent") {
  sources = [ "src/chain_lock_transaction.cpp" ]
  public_deps = [ ":headers" ]
}

cpp_interface("headers") {
  public = [ "include/kconcurrent/chain_lock_transaction.hpp" ]
  public_deps = [ "//system/lib/concurrent:headers" ]
}
