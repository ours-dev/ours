source_set("syscall") {
  # table.cpp owns the dispatch table syscall.S indexes; task.cpp / vmo.cpp
  # are the typed syscall layer's stubs, all Unimplemented until the layer
  # that unpacks the register frame into typed arguments exists.
  sources = [
    "table.cpp",
    "task.cpp",
    "vmo.cpp",
  ]
  public_deps = [ "//kernel/object:headers" ]
  visibility = [ "*" ]
}
