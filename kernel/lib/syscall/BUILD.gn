import("//build/cpp/cpp_interface.gni")

# The typed system-call entry points. table.cpp's shims unpack the register
# frame into these signatures, which is the seam that keeps the handlers
# themselves free of any arch detail.
cpp_interface("headers") {
  public = [ "include/syscall/handlers.hpp" ]
  visibility = [ "*" ]
}

source_set("syscall") {
  # table.cpp owns the dispatch table syscall.S indexes and the shims that
  # unpack its frame; debug.cpp is the first typed handler with a body.
  # task.cpp / vmo.cpp are still Unimplemented stubs, waiting on the handle
  # table their signatures are written against.
  sources = [
    "src/command.cpp",
    "src/debug.cpp",
    "src/table.cpp",
    "src/task.cpp",
    "src/vmo.cpp",
  ]
  public_deps = [
    ":headers",
    "//kernel/object:headers",
  ]
  deps = [
    # command.cpp walks the GKTL_COMMAND registry the linker collects; it reads
    # the records and copies text out, and deliberately does not call
    # gktl::run_command() -- running kernel code on argv that came from ring 3
    # is a much larger question than listing names.
    "//kernel/lib/gktl",
    "//kernel/lib/logz4",
    "//kernel/mm",
  ]
  visibility = [ "*" ]
}
