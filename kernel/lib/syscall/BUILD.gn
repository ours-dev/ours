import("//build/cpp/cpp_interface.gni")

# The typed system-call entry points. The generated shims unpack the register
# frame into these signatures, which is the seam that keeps the handlers
# themselves free of any arch detail. The declarations are generated too, from
# //system/public/ours/syscalls.gni, hence the dependency on its output.
cpp_interface("headers") {
  public = [ "include/syscall/handlers.hpp" ]
  public_deps = [
    "//kernel/lib/user_copy:headers",
    "//system/public:syscalls.private",
  ]

  # This library's own sources only. handlers.hpp includes the generated
  # declarations, so this target carries the include path to the private
  # call-number headers (//system/public:syscalls.private); open to everyone,
  # it re-exported what that target's visibility exists to keep private. The
  # handlers are reached through the dispatch table, never called by name
  # from outside.
  visibility = [ ":*" ]
}

source_set("syscall") {
  # table.cpp owns syscall_dispatch(), which syscall.S calls, the dispatch
  # table it indexes and the shims that unpack the frame. argument.hpp is the
  # shims' register conversion, and every other file holds the handlers of one
  # family. task.cpp has thread_create beside three Unimplemented stubs
  # (thread_start, thread_suspend, thread_exit) that no entry in syscalls.gni
  # reaches.
  sources = [
    "src/argument.hpp",
    "src/channel.cpp",
    "src/command.cpp",
    "src/debug.cpp",
    "src/exception.cpp",
    "src/handle.cpp",
    "src/interrupt.cpp",
    "src/object.cpp",
    "src/port.cpp",
    "src/process.cpp",
    "src/sampler.cpp",
    "src/table.cpp",
    "src/task.cpp",
    "src/vma.cpp",
    "src/vmo.cpp",
  ]
  public_deps = [
    "//kernel/lib/user_copy",
    "//kernel/object:headers",
  ]
  deps = [
    # Not public: whoever links this library reaches it through the dispatch
    # table and has no business with the handler declarations or the private
    # headers behind them.
    ":headers",

    # command.cpp walks the GKTL_COMMAND registry the linker collects; it reads
    # the records and copies text out, and deliberately does not call
    # gktl::run_command() -- running kernel code on argv that came from ring 3
    # is a much larger question than listing names.
    "//kernel/lib/gktl",
    "//kernel/lib/logz4",
    "//kernel/mm",
    "//kernel/platform:headers",

    # The call numbers, generated from //system/public/ours/syscalls.gni.
    "//system/public:syscalls.private",
  ]
  visibility = [ "*" ]
}
