import("//build/cpp/cpp_interface.gni")
import("//build/ours/cpu.gni")

# Compatibility alias: existing :headers deps pick up the system core
# include path instead of the deleted kernel-side copies.
group("headers") {
  public_deps = [ "//system/lib/logz4:headers" ]
}

# Kernel-only glue: serial sink, emergency_write, clock/cpu. phys images
# link //system/lib/logz4 directly and must not pull this target in — it
# needs CpuLocal and gktl. The `log` console command that used to live here
# moved to //kernel/commands with the rest of the kshell front end.
source_set("logz4") {
  sources = [ "kernel.cpp" ]
  public_deps = [ "//system/lib/logz4" ]
  deps = [
    # ours/task/thread.hpp holds a sampler::StackSampleRequest.
    "//kernel/lib/sampler:request",
    "//kernel/arch/$ours_cpu:headers",
    "//kernel/lib/arch:headers",
    "//kernel/lib/gktl:headers",
    "//kernel/mm:headers",

    # The console's two platform calls: debug_console_write() and
    # arch_tick_hz().
    "//kernel/platform:headers",
  ]
  visibility = [ "*" ]
}
