import("//build/cpp/cpp_interface.gni")
import("//build/ours/cpu.gni")

# Compatibility alias: existing :headers deps pick up the system core
# include path instead of the deleted kernel-side copies.
group("headers") {
  public_deps = [ "//system/lib/logz4:headers" ]
}

# Kernel-only glue: serial sink, emergency_write, clock/cpu, and
# the kshell `log` command. phys images link //system/lib/logz4 directly
# and must not pull this target in — it needs CpuLocal and gktl.
source_set("logz4") {
  sources = [
    "command.cpp",
    "kernel.cpp",
  ]
  public_deps = [ "//system/lib/logz4" ]
  deps = [
    "//kernel/arch/$ours_cpu:headers",
    "//kernel/lib/arch:headers",
    "//kernel/lib/gktl:headers",
    "//kernel/mm:headers",
  ]
  visibility = [ "*" ]
}
