import("//build/cpp/cpp_interface.gni")

# The implementation. Only ":headers" existed before, so every user got the
# declarations and nothing ever compiled init.cpp/log.cpp/filter.cpp -- which
# is why get_global_logger() and logz4::vlog<> had no definition anywhere in
# the build.
source_set("logz4") {
  sources = [
    "filter.cpp",
    "init.cpp",
    "log.cpp",
  ]
  public_deps = [ ":headers" ]
}

cpp_interface("headers") {
  public_deps = [ "//system/lib/ustl:headers" ]
  public = [
    "include/logz4/level.hpp",
    "include/logz4/log.hpp",
    "include/logz4/logger.hpp",
    "include/logz4/record.hpp",
    "include/logz4/ring_buffer.hpp",
    "include/logz4/types.hpp",
  ]
}
