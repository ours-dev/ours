# The kernel's C and C++ runtime glue, built on the C library the kernel
# shares with user programs (//system/lib/libc: the mem* and strlen
# definitions, and the headers.after config that puts its C headers on the
# search path).
source_set("libc") {
  sources = [
    "cpp_dependencies.cpp",
    "libcxx.cpp",
  ]

  # <ours/panic.hpp>, which the C++ runtime stubs call where libc++ would
  # throw, is one of the headers of //system/public.
  deps = [
    "//system/lib/libc",
    "//system/public",
  ]
  visibility = [ "*" ]
}

# The <format> string-instantiation glue alone, for images that already get
# their __cxa_* / verbose-abort hooks from kernel/lib/ccrt (the phys images).
source_set("format-glue") {
  sources = [ "libcxx_format_glue.cpp" ]

  # <ours/panic.hpp> again: the floating-point formatting stubs call it, and
  # panic if ever reached.
  deps = [
    "//system/lib/libc",
    "//system/public",
  ]
  visibility = [ "*" ]
}
