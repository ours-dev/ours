import("//build/cpp/cpp_interface.gni")

source_set("kshell") {
  sources = [ "kshell/shell.cpp" ]

  # Mirrors //kernel/kernel/task's include surface: Thread::spawn's header
  # chain reaches ours/mm/init.hpp -> ours/phys/handoff.hpp, whose include
  # dirs ride in on the mm/object headers targets.
  public_deps = [
    "//kernel/lib/gktl:headers",
    "//kernel/mm:headers",
    "//kernel/object:headers",
    "//system/lib/lockdep",
    "//system/lib/ustl:headers",
    "//system/public",
  ]

  # <ours/boot/options.hpp>, for `kernel.shell`: the header takes an
  # obi::CommandLineView, and //kernel/phys:handoff is the target that carries
  # obi's include dirs to kernel code (//kernel/lib/userabi reaches the boot
  # package the same way). boot::options() itself is defined in //kernel/top,
  # which depends on this library and so cannot be named here; it resolves at
  # link time like userabi's boot::boot_package().
  #
  # <logz4/domain.hpp> and <logz4/log.hpp>: the shell logs under a domain of
  # its own.
  deps = [
    "//kernel/phys:handoff",
    "//system/lib/logz4:headers",
  ]
  visibility = [ "*" ]
}

group("tests") {
}
group("kernel-tests") {
}
group("phys-tests") {
}
group("boot_tests") {
