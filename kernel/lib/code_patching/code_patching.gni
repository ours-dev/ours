# Extracts the `.code-patches` section from one linked kernel ELF.
import("//build/config/compiler/clang.gni")
template("code_patches") {
  assert(defined(invoker.deps), "code_patches($target_name) requires deps")
  assert(defined(invoker.elf), "code_patches($target_name) requires elf")

  if (defined(invoker.output)) {
    _output = invoker.output
  } else {
    _output = "$target_out_dir/$target_name.bin"
  }
  _depfile = "$_output.d"

  action(target_name) {
    forward_variables_from(invoker,
                           [
                             "deps",
                             "testonly",
                             "visibility",
                           ])
    script = "//kernel/lib/code_patching/extract_code_patches.py"
    sources = [ invoker.elf ]
    outputs = [ _output ]
    depfile = _depfile
    args = [
      # llvm-objcopy, not a bare `objcopy`: the host binutils cannot read a
      # target image when the build host is a different architecture.
      rebase_path("$clang_tool_dir/llvm-objcopy", root_build_dir),
      rebase_path(invoker.elf, root_build_dir),
      rebase_path(_output, root_build_dir),
      rebase_path(_depfile, root_build_dir),
    ]

    metadata = {
      images = []
      images_barrier = []

      if (defined(invoker.metadata)) {
        forward_variables_from(invoker.metadata, "*")
      }

      images += [
        {
          type = "code-patches"
          elf = rebase_path(invoker.elf, root_build_dir)
          label = get_label_info(":$target_name", "label_with_toolchain")
          path = rebase_path(_output, root_build_dir)
        },
      ]
    }
  }
}

# Defines a closed, position-independent code-patching alternative and emits
# its raw loadable bytes as "$target_out_dir/$entrypoint.bin".  The linker
# script enforces that the entrypoint is first, that all references resolve
# within the blob, and that writable data is absent.
template("code_patching_hermetic_alternative") {
  assert(defined(invoker.sources),
         "code_patching_hermetic_alternative($target_name) requires sources")

  _main_target = target_name
  _executable_target = "_code_patching_hermetic.$target_name.elf"
  if (defined(invoker.entrypoint)) {
    _entrypoint = invoker.entrypoint
  } else {
    _entrypoint = target_name
  }
  if (defined(invoker.output_name)) {
    _output_name = invoker.output_name
  } else {
    _output_name = _entrypoint
  }
  _elf = "$target_out_dir/$_executable_target"
  _link_input = "$_elf${ours_toolchain.link_output_suffix}"
  _blob = "$target_out_dir/$_output_name.bin"

  if (defined(invoker.case_id)) {
    _case_id = invoker.case_id
  } else {
    _case_id = _entrypoint
  }

  _public_deps = []
  if (defined(invoker.public) || defined(invoker.public_configs) ||
      defined(invoker.public_deps)) {
    _public_target = "$target_name.public"
    _public_deps = [ ":$_public_target" ]

    source_set(_public_target) {
      forward_variables_from(invoker,
                             [
                               "public",
                               "public_configs",
                               "public_deps",
                               "testonly",
                               "visibility",
                             ])
      if (defined(visibility)) {
        visibility += [ ":*" ]
      }
    }
  }

  executable(_executable_target) {
    visibility = [ ":$_main_target" ]
    forward_variables_from(invoker,
                           "*",
                           [
                             "add_configs",
                             "allow_rodata",
                             "configs",
                             "entrypoint",
                             "metadata",
                             "output_name",
                             "public",
                             "public_configs",
                             "public_deps",
                             "testonly",
                             "visibility",
                           ])
    forward_variables_from(invoker, [ "testonly" ])
    if (!defined(deps)) {
      deps = []
    }
    deps += _public_deps

    # Keep the normal compilation policy, but remove link-time transforms that
    # conflict with the hermetic linker script's explicit section checks.
    configs = []
    configs = default_executable_configs - [
                "//build/config:build_id",
                "//build/config:default_linker_gc",
                "//build/config:executable_config",
                "//build/config:icf",
              ] + [ "//build/config:hermetic_code_blob" ]
    if (defined(invoker.add_configs)) {
      configs += invoker.add_configs
    }
    ldflags = [ "-Wl,-defsym,HERMETIC_ENTRY=$_entrypoint" ]
    if (defined(invoker.allow_rodata) && invoker.allow_rodata) {
      ldflags += [ "-Wl,-defsym,HERMETIC_RODATA_OK=1" ]
    }
  }

  action(_main_target) {
    forward_variables_from(invoker,
                           [
                             "testonly",
                             "visibility",
                           ])
    deps = [ ":$_executable_target" ]
    sources = [ _link_input ]
    outputs = [ _blob ]
    script = "//kernel/lib/code_patching/extract_hermetic_blob.py"
    args = [
      # llvm-objcopy, not a bare `objcopy`: the host binutils cannot read a
      # target image when the build host is a different architecture.
      rebase_path("$clang_tool_dir/llvm-objcopy", root_build_dir),
      rebase_path(_link_input, root_build_dir),
      rebase_path(_blob, root_build_dir),
    ]
    metadata = {
      code_patching_hermetic_alternative_barrier = []
      code_patching_hermetic_alternatives = []

      if (defined(invoker.metadata)) {
        forward_variables_from(invoker.metadata, "*")
      }

      code_patching_hermetic_alternatives += [
        {
          label = get_label_info(":$_main_target", "label_with_toolchain")
          name = _entrypoint
          path = rebase_path(_blob, root_build_dir)
          case_id = _case_id
        },
      ]
    }
  }
}

# Generates and compiles a single patchable function stub.  Its byte size is
# the maximum size of the hermetic alternatives reached through `deps`.
template("code_patching_hermetic_stub") {
  assert(defined(invoker.deps),
         "code_patching_hermetic_stub($target_name) requires deps")
  assert(defined(invoker.case_suffix),
         "code_patching_hermetic_stub($target_name) requires case_suffix")
  assert(defined(invoker.case_id_header),
         "code_patching_hermetic_stub($target_name) requires case_id_header " +
             "until Ours defines its architecture case-ID interface")

  _main_target = target_name
  _metadata_target = "_code_patching_hermetic_stub.$target_name.metadata"
  _generate_target = "_code_patching_hermetic_stub.$target_name.generate"
  _metadata_file = "$target_gen_dir/$target_name.alternatives.json"
  _source_file = "$target_gen_dir/$target_name.S"

  generated_file(_metadata_target) {
    visibility = [ ":$_generate_target" ]
    deps = invoker.deps
    outputs = [ _metadata_file ]
    data_keys = [ "code_patching_hermetic_alternatives" ]
    walk_keys = [ "code_patching_hermetic_alternative_barrier" ]
    output_conversion = "json"
    forward_variables_from(invoker, [ "testonly" ])
  }

  action(_generate_target) {
    visibility = [ ":$_main_target" ]
    script = "//kernel/lib/code_patching/hermetic_stub.py"
    deps = [ ":$_metadata_target" ]
    sources = [ _metadata_file ]
    outputs = [ _source_file ]
    depfile = "$_source_file.d"
    if (defined(invoker.output_name)) {
      _function_name = invoker.output_name
    } else {
      _function_name = _main_target
    }
    args = [
      "--name",
      _function_name,
      "--case-suffix",
      invoker.case_suffix,
      "--header",
      invoker.case_id_header,
      "--metadata-file",
      rebase_path(_metadata_file, root_build_dir),
      "--depfile",
      rebase_path(depfile, root_build_dir),
      "--outfile",
      rebase_path(_source_file, root_build_dir),
    ]
    if (defined(invoker.aliases)) {
      foreach(_alias, invoker.aliases) {
        args += [
          "--aliases",
          _alias,
        ]
      }
    }
  }

  source_set(_main_target) {
    forward_variables_from(invoker,
                           "*",
                           [
                             "aliases",
                             "case_id_header",
                             "case_suffix",
                             "deps",
                             "output_name",
                             "sources",
                           ])
    sources = [ _source_file ]
    deps = [ ":$_generate_target" ]
  }
}

# Collects all hermetic alternatives, groups by case_id, computes the
# maximum blob size per case, and emits a GAS `.set` include file.
#
# Dependents should add `include_dirs = [ target_gen_dir ]` so assembly
# sources can `#include "case_sizes.inc"`.
#
# Parameters:
#   deps (required)
#     Targets whose metadata contributes code_patching_hermetic_alternatives.
#   output_name (optional)
#     Basename of the generated file.  Defaults to "case_sizes.inc".
template("code_patching_case_sizes") {
  assert(defined(invoker.deps),
         "code_patching_case_sizes($target_name) requires deps")

  _main_target = target_name
  _metadata_target = "_code_patching_case_sizes.$target_name.metadata"
  _generate_target = "_code_patching_case_sizes.$target_name.generate"

  if (defined(invoker.output_name)) {
    _output_name = invoker.output_name
  } else {
    _output_name = "case_sizes.inc"
  }

  _metadata_file = "$target_gen_dir/$target_name.alternatives.json"
  _output_file = "$target_gen_dir/$_output_name"

  generated_file(_metadata_target) {
    visibility = [ ":$_generate_target" ]
    deps = invoker.deps
    outputs = [ _metadata_file ]
    data_keys = [ "code_patching_hermetic_alternatives" ]
    walk_keys = [ "code_patching_hermetic_alternative_barrier" ]
    output_conversion = "json"
    forward_variables_from(invoker, [ "testonly" ])
  }

  action(_generate_target) {
    visibility = [ ":$_main_target" ]
    script = "//kernel/lib/code_patching/generate_case_sizes.py"
    deps = [ ":$_metadata_target" ]
    sources = [ _metadata_file ]
    outputs = [ _output_file ]
    depfile = "$_output_file.d"
    args = [
      "--metadata-file",
      rebase_path(_metadata_file, root_build_dir),
      "--depfile",
      rebase_path(depfile, root_build_dir),
      "--outfile",
      rebase_path(_output_file, root_build_dir),
    ]
    forward_variables_from(invoker, [ "testonly" ])
  }

  config("$_main_target.config") {
    include_dirs = [ target_gen_dir ]
  }

  group(_main_target) {
    forward_variables_from(invoker,
                           [
                             "testonly",
                             "visibility",
                           ])
    deps = [ ":$_generate_target" ]
    public_configs = [ ":$_main_target.config" ]
  }
}
