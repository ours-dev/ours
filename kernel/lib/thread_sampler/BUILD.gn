import("//build/cpp/cpp_interface.gni")

# The sampling profiler, in two halves.
#
# :thread_sampler is the session a Sampler object stands for, its per-CPU
# timers and what it records into. It is built on the kernel's timers, IPIs
# and locks, so it is kernel-only and has no host tests.
#
# :core is what a sample contains and where it is stored: the Recorder, its
# per-CPU buffers, the frame-pointer walk and the dump's format. It makes no
# call into the kernel and takes every fact as an argument, so it builds in
# the host toolchain too, where its tests and prof-fold (cli/) run.
if (toolchain_environment == "kernel") {
  source_set("thread_sampler") {
    sources = [ "src/thread_sampler.cpp" ]
    public_deps = [ ":headers" ]
    deps = [
      ":core",
      "//kernel/lib/gktl:headers",
      "//kernel/lib/heap",
      "//kernel/lib/ktl:headers",
      "//kernel/lib/unwind:headers",
      "//kernel/lib/user_copy",

      # current_pid(): a thread's process, through its user thread.
      "//kernel/object:headers",
      "//system/lib/logz4:headers",
    ]
    visibility = [ "*" ]
  }

  # The headers are a target of their own so that a dependant needing only
  # the declarations does not pull in the sources -- see
  # //build/cpp/cpp_interface.gni. Kernel-only like the session: they reach
  # //kernel/mm, which only a kernel toolchain can load, and the tests'
  # group loads this file in the default toolchain too.
  cpp_interface("headers") {
    public = [ "include/thread_sampler/thread_sampler.hpp" ]
    public_deps = [
      ":core.headers",
      ":request",
      "//kernel/mm:headers",
      "//system/lib/lockdep",
      "//system/public",
    ]
    visibility = [ "*" ]
  }
}

# The request a sampling tick leaves on a thread, alone: the thread holds it
# by value, so the task layer needs the complete type, and nothing else of
# the sampler.
cpp_interface("request") {
  public = [ "include/thread_sampler/stack_sample_request.hpp" ]
  visibility = [ "*" ]
}

# The host-testable core. recorder.cpp calls into the unwinder, not just its
# headers, so a consumer linking this needs //kernel/lib/unwind's objects on
# its link line too.
source_set("core") {
  sources = [
    "src/dump.cpp",
    "src/recorder.cpp",
  ]
  public_deps = [
    ":core.headers",
    "//kernel/lib/unwind",
  ]
  visibility = [ "*" ]
}

cpp_interface("core.headers") {
  public = [
    "include/thread_sampler/buffer.hpp",
    "include/thread_sampler/format.hpp",
    "include/thread_sampler/recorder.hpp",
    "include/thread_sampler/stack_window.hpp",
  ]

  # <prof/record_buffer.hpp> and <prof/sink.hpp>: the buffers the recorder
  # stores into, which it shares with the tracer.
  public_deps = [
    "//kernel/lib/prof:headers",
    "//kernel/lib/unwind:headers",
    "//system/lib/ustl:headers",
    "//system/public",
  ]
  visibility = [ "*" ]
}

# Host unit tests; wired into //:default.
group("tests") {
  testonly = true
  public_deps = [
    "test:format($host_toolchain)",
    "test:recorder($host_toolchain)",
  ]
}
