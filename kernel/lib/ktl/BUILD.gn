}

source_set("ktl") {
  sources = [ "memory_resource.cpp" ]
  deps = [
    "//kernel/lib/heap:headers",
    "//kernel/mm:headers",
  ]
  public_deps = [ ":headers" ]
  visibility = [ "*" ]
}
