import("//build/cpp/cpp_interface.gni")
import("//build/cpp/host_test.gni")

source_set("gktl") {
  sources = [
    "src/command.cpp",
    "src/init_hook.cpp",
  ]
  deps = [ "//kernel/lib/ktl" ]
  public_deps = [ ":headers" ]
}

cpp_interface("headers") {
  public = [
    "include/gktl/chain_buffer.hpp",
    "include/gktl/command.hpp",
    "include/gktl/counter.hpp",
    "include/gktl/defer.hpp",
    "include/gktl/dyn.hpp",
    "include/gktl/experiment.hpp",
    "include/gktl/init_hook.hpp",
    "include/gktl/init_hook.hpp",
    "include/gktl/radix_tree.hpp",
    "include/gktl/types.hpp",
    "include/gktl/vtable_packer.hpp",
  ]
  public_deps = [ "//system/lib/ustl:headers" ]
}

# Host-side test. gktl is a kernel library, but <gktl/defer.hpp> includes
# nothing, so its run-at-most-once contract can be checked by a plain hosted
# main() like //system/lib/concurrent's chain-lock-test.
host_test("defer-test") {
  sources = [ "test/defer_test.cpp" ]
  deps = [ ":headers" ]
}

group("tests") {
  testonly = true
  deps = [ ":defer-test" ]
}
