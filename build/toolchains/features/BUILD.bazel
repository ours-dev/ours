load("@rules_cc//cc/toolchains:feature.bzl", "cc_feature")

cc_feature(
    name = "static-pie-compile",
    feature_name = "static-pie-compile",
    args = ["//build/toolchain/options:pie-compile"]
)

cc_feature(
    name = "static-pie-link",
    feature_name = "static-pie-link",
    args = [
        "//build/toolchain/options:pie-link", 
        "//build/toolchain/options:no-dyn-link", 
    ],
)

cc_feature(
    name = "static-pie",
    feature_name = "static-pie",
    implies = [":static-pie-compile", ":static-pie-link"]
)

cc_feature(
    name = "static-pic-compile",
    feature_name = "static-pic-compile",
    args = ["//build/toolchain/options:pic-compile"],
)

cc_feature(
    name = "static-pic-link",
    feature_name = "static-pic-link",
    args = [
        "//build/toolchain/options:pic-link", 
        "//build/toolchain/options:no-dyn-link", 
    ],
)

cc_feature(
    name = "static-pic",
    feature_name = "static-pic",
    implies = [":static-pic-compile", ":static-pic-link"]
)