# Whole-program LLVM optimization.
config("lto") {
  cflags = [ "-flto" ]
  ldflags = cflags
}

# Incremental whole-program LLVM optimization.
config("thinlto") {
  cflags = [ "-flto=thin" ]
  ldflags = cflags
}

# Source-based code coverage: counters on source regions, and a coverage map
# in the binary that says which source range each counter belongs to. The link
# needs -fprofile-instr-generate as well: through the clang driver it makes the
# driver add the profile runtime, which writes the raw profile when the program
# exits (scripts/fetch_llvm_coverage.py puts that runtime next to the
# compiler). Host only: the kernel links with ld.lld directly, which takes no
# driver flag, and has no runtime to write the profile.
config("coverage") {
  cflags = [
    "-fprofile-instr-generate",
    "-fcoverage-mapping",
  ]
  ldflags = [ "-fprofile-instr-generate" ]
}

# Source-based code coverage for the kernel. The same counters and coverage map
# as `coverage`, with two differences that come from there being no compiler
# runtime and no driver in the link. No linker flag: the kernel links with
# ld.lld directly, which takes none. And binary correlation, which leaves the
# function records and names in the file, so that of everything the compiler
# emits only the counters are loaded into the kernel's memory; the profile is
# then a header, a build ID and the counters, and llvm-profdata finds the rest
# in the unstripped binary by build ID (//system/lib/profdata).
config("coverage-kernel") {
  cflags = [
    "-fprofile-instr-generate",
    "-fcoverage-mapping",
    "-mllvm",
    "-profile-correlate=binary",
  ]
}

# Undefined-behavior instrumentation that traps in place and requires no
# freestanding sanitizer runtime.
config("ubsan-trap") {
  cflags = [
    "-fsanitize=undefined",
    "-fsanitize-trap=undefined",
    "-fno-sanitize-recover=all",
  ]
  ldflags = cflags
}
