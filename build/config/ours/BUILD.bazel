load("@rules_cc//cc/toolchains:feature.bzl", "cc_feature")
load("@rules_cc//cc/toolchains:args.bzl", "cc_args")

cc_args(
    name = "headers",
    actions = ["@rules_cc//cc/toolchains/actions:compile_actions"],
    args = [
        "-Ikernel/include",
        "-Isystem/public"
    ],
    visibility = ["//visibility:private"]
)

cc_args(
    name = "scheduler",
    actions = ["@rules_cc//cc/toolchains/actions:compile_actions"],
    args = [],
    visibility = ["//visibility:private"]
)

cc_args(
    name = "lockdep",
    actions = ["@rules_cc//cc/toolchains/actions:compile_actions"],
    args = [],
    visibility = ["//visibility:private"]
)

# //build/config/kernel:config
cc_feature(
    name = "ours.kernel",
    feature_name = "ours.kernel",
    args = [
        ":headers",
        ":scheduler",
        ":lockdep",
        "//build/config/cpp:data_sections",
    ] + select({
        "@platforms//cpu:x86_64": [
            "//build/config/arch/x86:abi",
            "//build/config/arch/x86:kernel",
        ],
        "@platforms//cpu:riscv64": [
            "//build/config/arch/riscv:abi",
            "//build/config/arch/riscv:kernel",
        ],
        "//conditions:default": []
    }),

    implies = ["standalone"],
)

cc_feature(
    name = "standalone",
    feature_name = "standalone",
    args = [
        ":freestanding",
        ":static-pie-compile",
        ":static-pie-link",
    ],
)