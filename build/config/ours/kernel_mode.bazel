load("//build/config/ours:target_triple.bazel", "target_triple")
load("@rules_cc+//cc/toolchains:feature.bzl", "cc_feature")

cc_feature(
    name = "kernel_mode",
    feature_name = "kernel_mode",
    args = [
        "//build/cpp:freestanding",
        "//build/cpp:standalone",

        "//build/cpp:no_exceptions",
        "//build/cpp:no_rtti",
        "//build/cpp:no_builtin",
        "//build/cpp:no_stack_protector",
        "//build/cpp:no_sanitize_address",
        "//build/cpp:no_sanitize_link_runtime",
        "//build/cpp:no_libc",
        "//build/cpp:no_startfiles",

        "//build/cpp:emit-relocs",
        "//build/cpp:pic",
    ]
)