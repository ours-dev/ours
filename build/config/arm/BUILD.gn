# AArch64 architecture configuration for the Ours `arm` identifier.
# Kernel targets keep the plain ARMv8-A baseline, the minimum every
# ARMv8-A core implements; userspace extension profiles (+simd+crc+crypto)
# arrive with userspace toolchains.

import("//build/config/compiler_config.gni")

# ISA baseline: minimum hardware requirements for Ours on AArch64.
compiler_config("arm") {
  c_family_flags = [ "-march=armv8-a" ]
}
