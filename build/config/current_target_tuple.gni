# The `current_target_tuple` is the compiler triple matching the binaries
# generated by the current toolchain (used e.g. by c_utils() when invoking
# the compiler with an explicit --target).
#
# Local derivation:
#   * Ours kernel toolchains expose their exact LLVM triple through the
#     ours_toolchain scope (set via toolchain_args);
#   * the host/default toolchain compiles native host code, so the triple
#     is empty (no explicit --target; the compiler uses its native tuple).
#
# PROVENANCE: adapted from Fuchsia //build/config/current_target_tuple.gni
# (Copyright 2021 The Fuchsia Authors, BSD-style license) to the Ours
# toolchain identity model.
if (ours_toolchain != false && defined(ours_toolchain.target_triple)) {
  current_target_tuple = ours_toolchain.target_triple
} else {
  current_target_tuple = ""
}
