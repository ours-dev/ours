# Clang/LLVM toolchain configuration for the Ours build.
#
# clang_tool_dir is the single switch that selects where the Clang/LLVM
# binaries live.  The default resolves to the project prebuilt, which is
# the supported configuration: kernel builds also consume its libc++
# headers (include/c++/v1) and LLVM binutils (llvm-ar, llvm-strip,
# llvm-ifs, llvm-readelf, ...) next to the compiler itself.
#
# PROVENANCE: adapted from Fuchsia
#   //build/toolchain/zircon/clang.gni
#   //build/config/clang/clang_prefix.gni
# (Copyright 2020 The Fuchsia Authors, BSD-style license).  Fuchsia keys
# rebuilds on the CIPD instance ID of its prebuilt; Ours reads the
# equivalent .versions stamp maintained next to the prebuilt.

declare_args() {
  # Directory containing the Clang/LLVM toolchain binaries (clang, clang++,
  # llvm-ar, llvm-strip, llvm-ifs, ...).  The default is the project
  # prebuilt; override to point at another LLVM installation.
  clang_tool_dir = ""
}

# The prebuilt location is fixed so its version stamp can always be read,
# even when clang_tool_dir is overridden to a custom installation.
#
# llvm-22's bin/ is a set of symlinks into the dev container's own
# /usr/lib/llvm-22 install (see docker/dev.dockerfile) and only resolves
# there; llvm-23 is a real, vendored macOS-arm64 build (LLVM 23.1.0-rc3)
# used when generating directly on a macOS host, where llvm-22 is broken
# symlinks. Same clang_tool_dir mechanism handles the container's actual
# Linux build the same as any other override.
if (host_os == "mac") {
  _prebuilt_clang_root = "//prebuilt/clang/llvm-23"
  _prebuilt_clang_major = "23"
} else {
  _prebuilt_clang_root = "//prebuilt/clang/llvm-22"
  _prebuilt_clang_major = "22"
}

# Where the compiler runtime archives live, one directory per target triple.
#
# The kernel links with ld.lld directly rather than through the clang driver, so
# -rtlib=compiler-rt never gets a chance to resolve; the archive has to be named
# as an ordinary linker input instead. See //kernel/products:static-pic-link.
clang_runtime_lib_dir =
    "$_prebuilt_clang_root/lib/clang/$_prebuilt_clang_major/lib"
_prebuilt_clang_version =
    read_file("$_prebuilt_clang_root/.versions/clang.cipd_version", "json")

if (clang_tool_dir == "") {
  clang_tool_dir = "$_prebuilt_clang_root/bin"
  clang_version_string = _prebuilt_clang_version.instance_id
} else {
  # An overridden toolchain has no version stamp; its directory path is
  # unique enough to key toolchain-version rebuild triggers on.
  clang_version_string = clang_tool_dir
}

# The macOS SDK path for host-toolchain compiles (see the host branch in
# ours_toolchain.gni). llvm-22's Linux symlinks never need this: apt's
# clang has the container's system root baked in. The vendored llvm-23
# release doesn't know where any SDK is, so host compiles need an explicit
# -isysroot or libc++ headers like <cstdio> can't find the platform's
# <wchar.h> (mbstate_t and friends resolve through clang's
# using_if_exists, which silently drops symbols it can't find).
if (host_os == "mac") {
  mac_sdk_path =
      exec_script("//build/toolchain/get_macos_sdk_path.py", [], "trim string")
} else {
  mac_sdk_path = ""
}
