import("//build/obi/obi_input.gni")

# obi() — top-level OBI container.
#
# Collects obi_input_args from deps, generates a .obi.rsp response file,
# and invokes `obit pack @rsp --output <output>.obi` (via pack_action.py).
#
# This is the local counterpart of Fuchsia's zbi() template
# (//build/zbi/zbi.gni); the local adaptations are noted below.
#
# Parameters:
#   deps (required)     — obi_input / kernel_package / kernel_cmdline targets,
#                         or other obi() targets (they self-register as
#                         --type=container inputs via metadata).
#   output_name          — basename of the output .obi (default: target_name).
#   output_dir           — output directory (default: target_out_dir).
#   bootable             — CPU architecture that the image must be bootable on,
#                         or "" for non-bootable.  (Fuchsia calls this `cpu`.)
#   compressed           — global compression applied last.  Accepts a bool or
#                         a string:
#                           true   → "lz4" (obit's only implemented algorithm;
#                                    Fuchsia defaults to zstd — see NOTE below)
#                           false  → leave uncompressed (no --compressed flag)
#                           "lz4" / other string → --compressed=<value>
#                         Default: undefined (no global compression flag).
#   assert_no_deps       — optional, see `gn help assert_no_deps`; forwarded to
#                         the pack action.
#   metadata, testonly, visibility (optional).
#
# NOTE(ours) vs Fuchsia zbi():
#   * Fuchsia always writes a .json content listing next to the .zbi and uses
#     a tool-generated depfile.  obit has neither capability yet (that would
#     be a C++ change, out of scope), so obi() produces only the .obi.
#   * Fuchsia's zbi() self-registers as an input to another zbi() via
#     zbi_input_args metadata; obi() does the same with obi_input_args so an
#     obi() can be a direct dep of another obi() (nested containers without
#     an explicit obi_input(container=...)).
#   * obit implements only lz4 BootFS compression, so `compressed = true`
#     maps to "lz4" rather than Fuchsia's default "zstd".
template("obi") {
  assert(defined(invoker.deps), "obi($target_name) requires `deps`")

  _main_target = target_name
  if (defined(invoker.output_name)) {
    _output_name = invoker.output_name
  } else {
    _output_name = target_name
  }
  if (defined(invoker.output_dir)) {
    _output_dir = invoker.output_dir
  } else {
    _output_dir = target_out_dir
  }
  _rsp = "$target_gen_dir/$target_name.obi.rsp"
  _obi = "$_output_dir/$_output_name.obi"
  _rsp_target = "_obi.$target_name.rsp"
  _pack_target = "_obi.$target_name.pack"

  # obit runs on the build host; build it in the host toolchain regardless
  # of which context this obi() is evaluated in (the default toolchain
  # carries target identity).
  _obit_label = "//kernel/lib/obi/cli:obit($host_toolchain)"
  _obit = get_label_info(_obit_label, "target_out_dir") + "/" +
          get_label_info(_obit_label, "name")

  # Normalize the compression parameter: bool/string -> flag string or ""
  # (empty means "no global --compressed flag").  This is evaluated in the
  # template scope before the action, so the action below only appends the
  # final flag.
  _compressed_flag = ""
  if (defined(invoker.compressed)) {
    if (invoker.compressed == true) {
      # obit implements only lz4 BootFS compression today (see pack.cpp);
      # Fuchsia would use "zstd" here.
      _compressed_flag = "lz4"
    } else if (invoker.compressed == false) {
      _compressed_flag = ""
    } else {
      _compressed_flag = invoker.compressed
    }
  }

  generated_file(_rsp_target) {
    visibility = [ ":$_pack_target" ]
    forward_variables_from(invoker, [ "testonly" ])
    deps = invoker.deps
    outputs = [ _rsp ]
    data_keys = [ "obi_input_args" ]
    walk_keys = [ "obi_input_args_barrier" ]
    output_conversion = "list lines"
  }

  action(_pack_target) {
    visibility = [ ":$_main_target" ]
    forward_variables_from(invoker,
                           [
                             "assert_no_deps",
                             "testonly",
                           ])
    deps = [
      ":$_rsp_target",
      _obit_label,
    ]
    sources = [ _rsp ]
    outputs = [ _obi ]
    script = "//build/obi/pack_action.py"
    args = [
      "--obit",
      rebase_path(_obit, root_build_dir),
      "@" + rebase_path(_rsp, root_build_dir),
      "--output",
      rebase_path(_obi, root_build_dir),
    ]
    if (defined(invoker.bootable) && invoker.bootable != "") {
      args += [ "--bootable=" + invoker.bootable ]
    }
    if (_compressed_flag != "") {
      args += [ "--compressed=$_compressed_flag" ]
    }

    metadata = {
      # Self-register as an input to a containing obi(): walking a parent
      # obi()'s obi_input_args from a dep on this target collects a
      # --type=container entry pointing at this .obi (mirrors Fuchsia's
      # zbi_input_args self-embedding in zbi()).
      obi_input_args = []
      obi_input_args_barrier = []
      obi_input_args += [
        "--type=container",
        rebase_path(_obi, root_build_dir),
      ]
    }
  }

  group(_main_target) {
    forward_variables_from(invoker,
                           [
                             "testonly",
                             "visibility",
                           ])
    public_deps = [ ":$_pack_target" ]

    # The caller's metadata goes here, on the one public target, and nowhere
    # else. It used to be forwarded into both the rsp generated_file and the
    # pack action above, which meant every key a caller declared was collected
    # TWICE by any walk that reached this image -- both of those targets are on
    # the path from a dependent down to the deps. Nothing noticed while the
    # only callers declared keys nobody walked; the first one that did got
    # every row doubled.
    #
    # obi's own obi_input_args self-registration stays on the pack action,
    # because that is the target whose output the entry names.
    metadata = {
      if (defined(invoker.metadata)) {
        forward_variables_from(invoker.metadata, "*")
      }
    }
  }
}
