"""C++ build utilities and macros."""

load("@rules_cc//cc/toolchains:args.bzl", "cc_args")
load("@rules_cc//cc/toolchains:args_list.bzl", "cc_args_list")

cc_args(
    name = "no_stack_protector",
    actions = ["@rules_cc//cc/toolchains/actions:compile_actions"],
    args = ["-fno-stack-protector"],
)

cc_args(
    name = "pic",
    actions = ["@rules_cc//cc/toolchains/actions:compile_actions"],
    args = ["-fPIC"],
)

cc_args(
    name = "no_sanitize_link_runtime",
    actions = ["@rules_cc//cc/toolchains/actions:compile_actions"],
    args = ["-fno-sanitize-link-runtime"],
)

cc_args(
    name = "no_profilelib",
    actions = ["@rules_cc//cc/toolchains/actions:compile_actions"],
    args = ["-noprofilelib"],
)

cc_args(
    name = "emit-relocs",
    actions = ["@rules_cc//cc/toolchains/actions:link_actions"],
    args = ["-Wl,--emit-relocs"],
)

cc_args(
    name = "no_unwind",
    actions = ["@rules_cc//cc/toolchains/actions:compile_actions"],
    args = ["-unwindlib=none"],
)

cc_args(
    name = "freestanding",
    actions = [
        "@rules_cc//cc/toolchains/actions:compile_actions",
        "@rules_cc//cc/toolchains/actions:link_actions",
    ],
    args = ["-ffreestanding"],
)

cc_args(
    name = "no_exceptions",
    actions = [
        "@rules_cc//cc/toolchains/actions:compile_actions",
        "@rules_cc//cc/toolchains/actions:link_actions",
    ],
    args = ["-fno-exceptions"],
)

cc_args(
    name = "no_rtti",
    actions = [
        "@rules_cc//cc/toolchains/actions:compile_actions",
        "@rules_cc//cc/toolchains/actions:link_actions",
    ],
    args = ["-fno-rtti"] + select({
        "@bazel_tools//tools/cpp:clang": [
            "-Xclang",
            "-fexperimental-omit-vtable-rtti",
        ],
        "//conditions:default": [],
    }),
)

cc_args(
    name = "no_builtin",
    actions = ["@rules_cc//cc/toolchains/actions:compile_actions"],
    args = ["-fno-builtin"],
)

cc_args(
    name = "standalone",
    actions = [
        "@rules_cc//cc/toolchains/actions:compile_actions",
        "@rules_cc//cc/toolchains/actions:link_actions",
    ],
    args = [
        ":no_profilelib",
        ":no_unwind",
        ":no_sanitize_link_runtime",
    ],
)

cc_args(
    name = "no_libc",
    actions = ["@rules_cc//cc/toolchains/actions:link_actions"],
    args = ["-nolibc"],
)

cc_args(
    name = "no_startfiles",
    actions = ["@rules_cc//cc/toolchains/actions:link_actions"],
    args = ["-nostartfiles"],
)

cc_args(
    name = "no_sanitize_address",
    actions = ["@rules_cc//cc/toolchains/actions:compile_actions"],
    args = ["-fno-sanitize-address"],
)

cc_args(
    name = "no_sanitize_thread",
    actions = ["@rules_cc//cc/toolchains/actions:compile_actions"],
    args = ["-fno-sanitize-thread"],
)

cc_args(
    name = "no_sanitize_undefined",
    actions = ["@rules_cc//cc/toolchains/actions:compile_actions"],
    args = ["-fno-sanitize-undefined"],
)

cc_args(
    name = "no_sanitize_memory",
    actions = ["@rules_cc//cc/toolchains/actions:compile_actions"],
    args = ["-fno-sanitize-memory"],
)

cc_args(
    name = "no_sanitize_leak",
    actions = ["@rules_cc//cc/toolchains/actions:compile_actions"],
    args = ["-fno-sanitize-leak"],
)

cc_args(
    name = "no_sanitize_float_divide_by_zero",
    actions = ["@rules_cc//cc/toolchains/actions:compile_actions"],
    args = ["-fno-sanitize-float-divide-by-zero"],
)

cc_args(
    name = "no_frame_pointers",
    actions = [
        "@rules_cc//cc/toolchains/actions:compile_actions",
        "@rules_cc//cc/toolchains/actions:link_actions",
    ],
    args = ["-fomit-frame-pointer"],
)