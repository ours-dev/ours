# rust_cdylib() -- a C-compatible Rust dynamic library (crate-type
# cdylib) exporting a plain C ABI.
#
# See rust_artifact() for the shared parameters.
#
# PROVENANCE: adapted from Fuchsia //build/rust/rust_cdylib.gni
# (Copyright 2021 The Fuchsia Authors, BSD-style license).

import("rust_artifact.gni")

template("rust_cdylib") {
  rust_artifact(target_name) {
    output_type = "shared_library"
    forward_variables_from(invoker, "*", [ "output_type" ])
  }
}
