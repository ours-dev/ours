# rust_library() -- a Rust library (crate-type rlib).
#
# See rust_artifact() for the shared parameters.
#
# PROVENANCE: adapted from Fuchsia //build/rust/rust_library.gni
# (Copyright 2021 The Fuchsia Authors, BSD-style license).

import("rust_artifact.gni")

template("rust_library") {
  rust_artifact(target_name) {
    output_type = "rust_library"
    forward_variables_from(invoker, "*", [ "output_type" ])
  }
}
