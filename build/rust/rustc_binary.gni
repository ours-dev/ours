# rustc_binary() -- a Rust executable (crate-type bin).
#
# See rustc_artifact() for the shared parameters.
#
# PROVENANCE: adapted from Fuchsia //build/rust/rustc_binary.gni
# (Copyright 2021 The Fuchsia Authors, BSD-style license).

import("rustc_artifact.gni")

template("rustc_binary") {
  rustc_artifact(target_name) {
    output_type = "executable"
    forward_variables_from(invoker, "*", [ "output_type" ])
  }
}
