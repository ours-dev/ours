# rust_test() -- a Rust unit-test executable (crate-type bin with
# --test): rustc compiles the crate's #[test] functions with the
# libtest harness and a main() generated by the compiler.
#
# See rust_artifact() for the shared parameters.
#
# PROVENANCE: adapted from Fuchsia //build/rust/rust_test.gni
# (Copyright 2021 The Fuchsia Authors, BSD-style license).

import("rust_artifact.gni")

template("rust_test") {
  rust_artifact(target_name) {
    output_type = "executable"
    rustflags = [ "--test" ]
    if (defined(invoker.rustflags)) {
      rustflags += invoker.rustflags
    }
    forward_variables_from(invoker,
                           "*",
                           [
                             "output_type",
                             "rustflags",
                           ])
  }
}
