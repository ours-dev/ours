# rust_macro() -- a Rust procedural macro crate (crate-type proc-macro).
# Procedural macros execute at compile time on the build host; GN's
# rust_proc_macro type builds them through a host-rustcapable toolchain.
#
# See rust_artifact() for the shared parameters.
#
# PROVENANCE: adapted from Fuchsia //build/rust/rust_macro.gni
# (Copyright 2021 The Fuchsia Authors, BSD-style license).

import("rust_artifact.gni")

template("rust_macro") {
  rust_artifact(target_name) {
    output_type = "rust_proc_macro"
    forward_variables_from(invoker, "*", [ "output_type" ])
  }
}
