import("//build/obi/kernel_cmdline.gni")
import("//build/obi/obi_input.gni")
import("//kernel/kernel_image.gni")
import("//kernel/kernel_package.gni")

# product() — 声明式产品装配引擎。
#
# 产品 = 命名的、可选择的构建配置。一个 product()
# 定义一次性产出该产品所需的 全部内容 ——
# 内核镜像(.obi)、注入的内核 cmdline 与 BOOTFS 资源、以及描述
# 产物的 product_info.json
# 清单；不需要任何额外的手工拼装步骤。
#
# 与内核侧职责的划分：
#   * kernel/products/          — 内核怎么编译（configs）
#   * kernel/products/bin       — 内核可执行文件（vmours / vmours.with-tests）
#   * kernel/products/image     — 共享镜像配方（common_package_items 等）
#   * build/switch/set/         — 内核编译策略 switchset（dbg.0..2）
#   * products/<name>.gni       — 产品定义（选哪些镜像 + 什么策略）【本模板的输入】
#   * product()                 — 把产品定义装配成构建目标【本模板】
#
# 选择机制：
#   tools/set.py <product>.<arch>   或  args.gn: ours_product = "<name>"
#   根 //:default 按 ours_product 动态依赖 //products/<name>:<name>。
#
# 参数（即产品 scope，来自 products/<name>.gni）：
#   kernel_images (required)
#     list：产品包含的内核镜像。每条目二选一：
#       * { image = <label> }  预定义镜像：
#         指向 //kernel/products/image/$name 的 kernel_image() 目标；镜像的
#         cmdline/switchset/physboot 在其定义处决定，产品只按 label 选择。
#       * { output_name (required), package (required), extra_deps (optional),
#           cmdline (optional), bootable (optional) }  内联镜像：字段在此展开
#         （product-smoke 用）；产品级 kernel_cmdline/bootfs 注入仅作用于这类条目。
#         package — 内核可执行文件 label（如 "//kernel/products/bin:vmours"），
#         extra_deps — 附加到该镜像的 deps（如 "//kernel/phys:physboot"，仅保证
#         一起构建，不嵌入 .obi），
#         bootable — 默认 true；false 表示产物是纯容器（"内核"是存储载荷而非
#         ELF，不做启动拓扑校验，见 kernel_image() 的同名参数）。
#   kernel_cmdline (optional, default [])
#     产品级内核 cmdline，注入到每个镜像（bringup 为空，维持 phys 侧默认启动行为）。
#   bootfs (optional, default [])
#     产品级 BOOTFS 资源（resource() 目标 label 列表），注入到每个镜像的
#     BootFS 根。
#   switchset (optional, default "dbg.0")
#     内核编译策略，即 //build/switch/set/<name> 下的 switchset 名；内联镜像的
#     内核可执行文件在该 switchset 的工具链（kernel_<cpu>.<name>）下编译；
#     预定义镜像的 switchset 在其定义处（kernel/products/image/$name/）决定。
#   output_dir (optional, default "")
#     产品输出子目录（$root_out_dir/<output_dir>/）；默认空 = 直接落在
#     $root_out_dir。
#   compressed (optional, default "lz4")
#     全局压缩策略，透传给 kernel_image()。
#   boards (optional, default [])
#     兼容板卡/架构列表（声明性；空 = 任意，可启动性校验交给镜像本身）。
#   debug_level / unit_tests_enabled (optional)
#     声明性策略字段，写入 product_info；实际编译策略由 switchset 决定。
#   testonly / visibility (optional)。
#
# 结果：
#   * group("<name>") 聚合目标 —— 构建它即产出全部镜像 + product_info.json；
#   * 每个镜像：  $root_out_dir/<output_name>.obi（默认在 out 根；设置
#     output_dir 时位于 $root_out_dir/<output_dir>/ 下）；
#   * $root_out_dir/product_info.json —— 产物清单（JSON），
#     供脚本/工具消费；
#   * 产品信息 metadata（product_info），供文档/工具读取。
#
# PROVENANCE: 本地模板；镜像聚合逻辑源自已移除的
# //build/obi/kernel_product.gni。
template("product") {
  assert(defined(invoker.kernel_images),
         "product($target_name) requires `kernel_images`")

  # The scope `name` field must agree with the target name (consumed here so
  # it is not flagged as an unused assignment in the .gni).
  if (defined(invoker.name)) {
    assert(invoker.name == target_name,
           "product($target_name): `name` must match the target name")
  }

  # Capture the product's own target name: inside nested target invocations
  # below, `$target_name` would expand to *their* names.
  _product_name = target_name

  _testonly = false
  if (defined(invoker.testonly)) {
    _testonly = invoker.testonly
  }

  # Product outputs land at the build root by default, with no
  # product-named subdirectory.  `output_dir` can still relocate them into a
  # subdirectory.
  _product_dir = ""
  if (defined(invoker.output_dir) && invoker.output_dir != "") {
    _product_dir = invoker.output_dir
  }
  if (_product_dir != "") {
    _product_output_dir = "$root_out_dir/$_product_dir"
  } else {
    _product_output_dir = root_out_dir
  }

  # ---- 产品策略（带默认值） ----
  _switchset = "dbg.0"
  if (defined(invoker.switchset)) {
    _switchset = invoker.switchset
  }
  _kernel_cmdline = []
  if (defined(invoker.kernel_cmdline)) {
    _kernel_cmdline = invoker.kernel_cmdline
  }
  _bootfs = []
  if (defined(invoker.bootfs)) {
    _bootfs = invoker.bootfs
  }

  # ---- 装配每个内核镜像 ----
  _image_targets = []
  _image_info = []
  foreach(_entry, invoker.kernel_images) {
    if (defined(_entry.image)) {
      # ---- 预定义镜像 ---- 条目为 { image = <label>
      # }：镜像本体（kernel_package + kernel_cmdline +
      # kernel_image）定义在 kernel/products/image/$name/，产品只按
      # label 选择。 镜像的 cmdline/switchset/physboot
      # 在定义处决定；产品级 cmdline/bootfs
      # 注入只作用于内联镜像条目（else 分支）。
      _label = _entry.image
      _image_targets += [ _label ]
      _image_info += [
        {
          output_name = get_label_info(_label, "name")
          package = _label
        },
      ]
    } else {
      assert(
          defined(_entry.output_name),
          "product($target_name): each kernel_images entry requires `output_name`")
      assert(
          defined(_entry.package),
          "product($target_name): each kernel_images entry requires `package` (kernel executable label)")

      _image_name = _entry.output_name
      _extra_deps = []
      if (defined(_entry.extra_deps)) {
        _extra_deps = _entry.extra_deps
      }
      _entry_cmdline = []
      if (defined(_entry.cmdline)) {
        _entry_cmdline = _entry.cmdline
      }
      _entry_bootable = true
      if (defined(_entry.bootable)) {
        _entry_bootable = _entry.bootable
      }

      _pkg_target = "_product.$target_name.pkg.$_image_name"
      _cmdline_target = "_product.$target_name.cmdline.$_image_name"
      _bootfs_target = "_product.$target_name.bootfs.$_image_name"
      _image_target = "_product.$target_name.image.$_image_name"

      # 内核存储块：共享配方（common_package_items）+ 所选
      # switchset 工具链下的 内核可执行文件，收进压缩
      # BootFS（STORAGE_KERNEL 项）。 注：switchset
      # 工具链只在内联镜像处计算；预定义镜像的 switchset
      # 在其
      # 定义处（kernel/products/image/$name/）决定。
      _switchset_toolchain =
          "//build/switch/set/$_switchset:kernel_${target_cpu}.$_switchset"
      kernel_package(_pkg_target) {
        visibility = [ ":*" ]
        testonly = _testonly
        prefix = "ours"
        deps = [
          "//kernel/products/image:common_package_items",
          "${_entry.package}($_switchset_toolchain)",
        ]
      }

      # 内核 cmdline：产品级 + 镜像级，注入到该镜像。
      kernel_cmdline(_cmdline_target) {
        visibility = [ ":*" ]
        testonly = _testonly
        args = _kernel_cmdline + _entry_cmdline
      }

      # NOTE: GN 的 foreach
      # 不隔离作用域，循环局部变量在迭代间泄漏，因此
      # 每个迭代先清空再追加（不能直接对非空列表重新赋值）。
      _image_deps = []
      _image_deps += [
        ":$_pkg_target",
        ":$_cmdline_target",
      ]
      _image_deps += _extra_deps
      if (_bootfs != []) {
        # BOOTFS 资源块：默认 files_type=bootfs、无前缀，落在
        # BootFS 根。
        obi_input(_bootfs_target) {
          visibility = [ ":*" ]
          testonly = _testonly
          deps = _bootfs
        }
        _image_deps += [ ":$_bootfs_target" ]
      }

      _image_compressed = "lz4"
      if (defined(invoker.compressed)) {
        _image_compressed = invoker.compressed
      }

      kernel_image(_image_target) {
        visibility = [ ":*" ]
        testonly = _testonly
        output_name = _image_name
        product_dir = _product_dir
        compressed = _image_compressed
        bootable = _entry_bootable
        deps = _image_deps
      }

      _image_targets += [ ":$_image_target" ]
      _image_info += [
        {
          output_name = _image_name
          package = _entry.package
        },
      ]
    }
  }

  # ---- 产品信息（metadata + product_info.json） ----
  _compressed = "lz4"
  if (defined(invoker.compressed)) {
    _compressed = invoker.compressed
  }
  _boards = []
  if (defined(invoker.boards)) {
    _boards = invoker.boards
  }
  _debug_level = 0
  if (defined(invoker.debug_level)) {
    _debug_level = invoker.debug_level
  }
  _unit_tests_enabled = false
  if (defined(invoker.unit_tests_enabled)) {
    _unit_tests_enabled = invoker.unit_tests_enabled
  }

  _product_info = {
    name = _product_name
    output_dir = _product_dir
    switchset = _switchset
    kernel_cmdline = _kernel_cmdline
    bootfs = _bootfs
    compressed = _compressed
    boards = _boards
    debug_level = _debug_level
    unit_tests_enabled = _unit_tests_enabled
    kernel_images = _image_info
  }

  # 元数据载体：product_info.json 的数据源（只挂 metadata，无
  # deps）。
  group("_product.$_product_name.info") {
    metadata = {
      product_info = [ _product_info ]
      product_info_barrier = []
    }
  }

  # 产物清单：一次构建即得到描述全部产物的 JSON。
  generated_file("_product.$_product_name.info.json") {
    deps = [ ":_product.$_product_name.info" ]
    data_keys = [ "product_info" ]
    walk_keys = [ "product_info_barrier" ]
    outputs = [ "$_product_output_dir/product_info.json" ]
    output_conversion = "json"
  }

  # ---- 产品聚合目标 ----
  group(target_name) {
    testonly = _testonly
    if (defined(invoker.visibility)) {
      visibility = invoker.visibility
    }
    deps = _image_targets + [ ":_product.$_product_name.info.json" ]

    metadata = {
      product_info = [ _product_info ]
      product_info_barrier = []
    }
  }
}
