# Ninja `restat` can lead to on-the-fly pruning of the overall action graph
# when intermediate files are unchanged as a result of re-running an action.
#
# This file exposes the launcher that makes a tool command restat-friendly:
# prepend restat_command_launcher.local (as a list) to a tool() command and
# set `restat = true` on that tool.  The launcher backs up the declared
# outputs, runs the command, and only replaces outputs whose content
# actually changed -- unchanged outputs keep their old mtime, so Ninja can
# prune downstream actions.
#
# The launcher is opt-in per tool; nothing in ours_toolchain() enables it
# by default.  Typical use (inside a tool()):
#   command = restat_command_launcher.local + [ "cc", ... ]
#   restat = true
#
# NOTE(ours): the build is local-only, so the defaults do not depend on
# remote execution and are off; the launcher invokes the script directly
# (it has a shebang) rather than through a python interpreter.
#
# PROVENANCE: adapted from Fuchsia //build/toolchain/restat.gni
# (Copyright 2021 The Fuchsia Authors, BSD-style license).

declare_args() {
  # Set to true to make C++ compiles preserve timestamps of unchanged
  # outputs (write-if-change) at the cost of wrapper overhead.
  restat_cc = false
}

restat_command_launcher = {
  # Local-only execution uses the wrapper script directly.
  local = [
    rebase_path("//build/toolchain/restat_cacher.py", root_build_dir),
    "--outputs",
    "{{output}}",
    "--",
  ]
}
