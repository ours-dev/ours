# The `toolchain_environment` variable corresponds to the runtime
# environment that the binaries generated by the current toolchain will run
# in (e.g. "kernel", "kernel.phys", "host").
#
# Derivation:
#   * Ours kernel toolchains carry their environment in the ours_toolchain
#     scope set through toolchain_args;
#   * the default (host/meta) toolchain runs host actions;
#   * any other toolchain falls back to "user".
#
# PROVENANCE: derived from Fuchsia's //build/toolchain/toolchain_environment.gni
# (Copyright 2021 The Fuchsia Authors, BSD-style license).  The
# ours_toolchain branch is local; the toolchain_base_environment derivation
# comes from that file.

if (ours_toolchain != false) {
  toolchain_environment = ours_toolchain.environment
} else if (defined(in_default_toolchain) && in_default_toolchain) {
  # GN ignores toolchain_args for the default toolchain. The default toolchain
  # is the host/meta toolchain; kernel artifacts select a secondary toolchain.
  toolchain_environment = "host"
} else {
  toolchain_environment = "user"
}

# Some environment definitions use a dotted suffix (e.g. kernel.phys);
# toolchain_base_environment returns the suffix-less value (e.g. "kernel").
# get_path_info(..., "name") strips the extension-like `.phys` suffix.
toolchain_base_environment = get_path_info(toolchain_environment, "name")
