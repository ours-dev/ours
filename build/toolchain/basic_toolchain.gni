import("//build/toolchain/default_tools.gni")

# Define a basic GN toolchain() instance that only has the "stamp" and
# "copy" tools.  Use this for toolchains that will only have action()
# targets (no compiler tools).
#
# Parameters:
#   expected_label: Optional
#     If provided, this template will assert that the full toolchain label
#     matches this value.  Useful when the definition must match a global
#     variable (e.g. a named toolchain selector).
#   toolchain_args: Optional
#     A scope of extra toolchain_args keys for this toolchain instance.
#
# NOTE(ours): no global toolchain-description scope is passed through
# toolchain_args here: the toolchain contract is the smaller toolchain_tools
# scope in BUILDCONFIG.gn.
#
# PROVENANCE: adapted from Fuchsia's //build/toolchain/basic_toolchain.gni
# (Copyright 2020 The Fuchsia Authors, BSD-style license).
template("basic_toolchain") {
  if (current_toolchain == default_toolchain) {
    # Basic toolchains should only be expanded once in the default toolchain.
    toolchain(target_name) {
      tool("stamp") {
        command = stamp_command
        description = stamp_description
      }
      tool("copy") {
        command = copy_command
        description = copy_description
      }
      toolchain_args = {
        if (defined(invoker.toolchain_args)) {
          forward_variables_from(invoker.toolchain_args, "*")
        }
        toolchain_variant = {
        }
        toolchain_variant = {
          # This is a "basic" toolchain
          is_basic = true
          base = get_label_info(":$target_name", "label_no_toolchain")
          if (defined(invoker.expected_label)) {
            assert(
                base == invoker.expected_label,
                "Invalid toolchain label $base, expected ${invoker.expected_label}")
          }
        }

        # Mark as a non-default toolchain.
        in_default_toolchain = false
      }
    }
  } else {
    not_needed("*")
    not_needed(invoker, "*")
  }
}
