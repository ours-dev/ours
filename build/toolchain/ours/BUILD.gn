# ---- User toolchains ----
# The environment for programs that run in ring 3 under vmours.  It shares
# the ISA baseline and the diagnostics policy with the kernel toolchains and
# nothing else: `toolchain_environment` is "user", so BUILDCONFIG.gn's
# is_kernel is false here and none of the kernel's freestanding link policy,
# libc++ wiring or //system/public include seam is applied.  The user-mode
# policy comes from //system:user.config instead.
#
# elf_linker for the same reason as every other non-host toolchain here: the
# Clang driver hands an ELF-target link to the host toolchain's linker, which
# on a macOS host cannot produce an ELF image at all.
ours_toolchain("user-x86") {
  cpu = "x86"
  os = target_os
  environment = "user"
  elf_linker = true
  tags = [ "user" ]
  tool_dir = clang_tool_dir
  configs = [ "//system:user.config" ]

  # The static-PIE link policy, which only an executable can carry: the vDSO
  # in this same toolchain is a shared object, and -static/--pie are refused
  # beside -shared. See //system:user.executable.
  executable_configs = [ "//system:user.executable" ]
}
# The host-toolchain smoke test lives in its own directory
# (//build/toolchain/host-smoke-test) — deliberately not here.  See that
# BUILD.gn for why a file that calls toolchain() must never also define a
# regular target referenced with an explicit toolchain suffix.
