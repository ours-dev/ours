# Toolchain instantiations for the Ours kernel.
# Each ours_toolchain() call creates a complete GN toolchain with
# its own compiler, linker, and toolchain_args.

import("//build/config/ours/variants.gni")
import("//build/toolchain/ours/ours_toolchain.gni")

if (host_cpu == "x64") {
  _host_ours_cpu = "x86"
} else if (host_cpu == "arm64") {
  _host_ours_cpu = "arm"
} else if (host_cpu == "riscv64") {
  _host_ours_cpu = "riscv"
} else {
  assert(false, "Unsupported host CPU '$host_cpu'")
}

# The host toolchain is one toolchain, not a suite, so select_variant reaches it
# only through a selector that says `host = true`, and then for the whole
# toolchain. Every host binary the build makes gets the variant, the tools that
# run during the build as well as the tests, so a variant is worth selecting
# here when that is acceptable, as it is for coverage in a build directory of
# its own.
_host_variant_configs = []
_host_variant_tags = []
foreach(selector, ours_variant_selectors) {
  if (defined(selector.host) && selector.host && selector.variant != false) {
    assert(
        selector.target_type == [] && selector.output_name == [] &&
            selector.label == [] && selector.name == [] && selector.dir == [],
        "select_variant: a host = true selector picks the variant for the whole host toolchain and cannot be limited to a target_type, output_name, label, name or dir: $selector")
    foreach(variant, ours_known_variants) {
      if (variant.name == selector.variant) {
        # Subtracting what is there already makes a variant selected twice
        # count once, which GN requires of a config list.
        _host_variant_configs += variant.configs - _host_variant_configs
        _host_variant_tags += variant.tags - _host_variant_tags
      }
    }
  }
}

# Host toolchain.  It builds native host tools/tests and runs host actions;
# kernel artifacts are selected through kernel switchset toolchains.
# The host toolchain is a secondary toolchain (the default carries target
# identity), so its toolchain_args DO apply: runtime_environment = "host"
# and toolchain_variant.base = this label.  The host C++ prelude include
# keys off that identity in BUILDCONFIG.gn (//kernel/products:host-prelude).
ours_toolchain("host") {
  cpu = _host_ours_cpu
  os = host_os
  environment = "host"
  host = true
  tool_dir = clang_tool_dir
  configs = _host_variant_configs
  tags = _host_variant_tags
}

# ---- Kernel toolchains ----
# These are ELF-targeting, freestanding toolchains for kernel code.

ours_toolchain("kernel-x86") {
  cpu = "x86"
  os = target_os
  environment = "kernel"

  # Link with lld directly.  Left to itself the Clang driver hands an
  # ELF-target link to the host `gcc`, which cannot build an image for
  # another architecture (ours_toolchain.gni, elf_linker).
  elf_linker = true
  tags = [ "kernel" ]
  tool_dir = clang_tool_dir
  strip = ours_strip_kernel_binaries
  prefix_configs = [
    "//system/lib/ustl:headers.config",
    "//kernel/lib/arch:headers.config",
    "//kernel/mm:headers.config",
    "//kernel/platform:headers.config",
    "//kernel/arch/x86:headers.config",
    "//kernel/arch/x86/kernel:headers.config",
    "//kernel/arch/x86/mm:headers.config",
  ]
  configs = [ "//kernel/products:kernel.config" ]
}

