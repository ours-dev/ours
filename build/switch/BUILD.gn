import("//build/config/ours/debug_level.gni")

assert(is_kernel,
       "kernel switches are only valid in a kernel runtime environment")

# Preserve the named debug-level labels used by Zircon-shaped switchsets.
# Active Ours switchsets normally pass kernel_debug_level through toolchain
# arguments instead.
foreach(level, ours_debug_levels) {
  config("debug_level_${level}") {
    defines = [ "KERNEL_DEBUG_LEVEL=$level" ]

    # Kept in step with the level, for the same reason kernel_debug does it.
    if (level > 0) {
      defines += [ "OURS_DEBUG=1" ]
    } else {
      defines += [ "OURS_DEBUG=0" ]
    }
  }
}
