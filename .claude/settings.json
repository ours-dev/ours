{
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR/scripts/format_cpp.py\" --claude-hook",
            "timeout": 30,
            "statusMessage": "clang-format"
          },
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR/scripts/format_gn.py\" --claude-hook",
            "timeout": 30,
            "statusMessage": "gn format"
          },
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR/scripts/lint_docs.py\" --claude-hook",
            "timeout": 30,
            "statusMessage": "lint_docs"
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR/scripts/install_hooks.py\" --claude-hook",
            "timeout": 15,
            "statusMessage": "git hooks"
          }
        ]
      }
    ]
  }
}
